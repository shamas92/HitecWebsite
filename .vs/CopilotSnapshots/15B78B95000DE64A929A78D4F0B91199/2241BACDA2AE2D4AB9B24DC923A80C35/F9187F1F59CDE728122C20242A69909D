@model IEnumerable<HitecCM.Models.tblMenus>
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
}
<ul>
    @foreach (var menu in Model)
    {
        // Try to match by MenuLink or MenuName if possible
        var isActiveMenu = !string.IsNullOrEmpty(menu.MenuLink) && menu.MenuLink.ToLower().Contains($"/{currentController?.ToLower()}");
        if (!isActiveMenu)
        {
            isActiveMenu = menu.MenuName.Equals(currentController, StringComparison.OrdinalIgnoreCase);
        }
        <li class="menu-item-has-children @(isActiveMenu ? "active" : "")">
            @if (!string.IsNullOrEmpty(menu.MenuLink))
            {
                <a href="@menu.MenuLink">@menu.MenuName</a>
            }
            else
            {
                <a href="#">@menu.MenuName</a>
            }

            @if (menu.ChildMenus != null && menu.ChildMenus.Any())
            {
                <ul class="submenu">
                    @foreach (var childMenu in menu.ChildMenus)
                    {
                        var isActiveChild = !string.IsNullOrEmpty(childMenu.MenuLink) &&
                            (childMenu.MenuLink.ToLower().Contains($"/{currentController?.ToLower()}/{currentAction?.ToLower()}") ||
                             childMenu.MenuLink.ToLower().Contains($"/{currentController?.ToLower()}")
                            );
                        if (!isActiveChild)
                        {
                            isActiveChild = childMenu.MenuName.Equals(currentAction, StringComparison.OrdinalIgnoreCase);
                        }
                        <li class="@(isActiveChild ? "active" : "")">
                            @if (!string.IsNullOrEmpty(childMenu.MenuLink))
                            {
                                <a href="@childMenu.MenuLink">@childMenu.MenuName</a>
                            }
                            else
                            {
                                <a href="#">@childMenu.MenuName</a>
                            }
                        </li>
                    }
                </ul>
            }
        </li>
    }
</ul>