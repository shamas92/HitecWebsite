@model IEnumerable<HitecCM.Models.tblMenus>
@using HitecCM.Models

<nav class="xb-header-nav">
    <ul class="xb-menu-primary clearfix">
        @{
            bool eventsMenuFound = false; HitecCM.Models.tblMenus eventsMenu = null;
            foreach (var menu in Model)
            {
                if (string.Equals(menu.MenuName, "Events", StringComparison.OrdinalIgnoreCase)) { eventsMenuFound = true; eventsMenu = menu; break; }
            }
            var sortedMenus = Model.OrderBy(m => m.SortingOrder).ToList();
        }
        @foreach (var menu in sortedMenus)
        {
            if (eventsMenuFound && menu.MenuID == eventsMenu.MenuID)
            {
                <li class="menu-item menu-item-has-children @(IsMenuActive(eventsMenu) || Request.Url.AbsolutePath.StartsWith("/Events") ? "active" : "")">
                    @{ var effectiveLink = GetEffectiveMenuLink(eventsMenu); }
                    @if (!string.IsNullOrEmpty(effectiveLink)) { <a href="@effectiveLink">@eventsMenu.MenuName</a> } else { <a href="@Url.Action("Index", "Events")">@eventsMenu.MenuName</a> }
                    <ul class="sub-menu">@{ var latestEvents = Html.Action("GetLatestEvents", "Events"); }@latestEvents</ul>
                </li>
                continue;
            }
            <li class="menu-item menu-item-has-children @(IsMenuActive(menu) ? "active" : "")">
                @{ var effectiveMenuLink = GetEffectiveMenuLink(menu); }
                @if (!string.IsNullOrEmpty(effectiveMenuLink)) { <a href="@effectiveMenuLink">@menu.MenuName</a> } else { <a href="#">@menu.MenuName</a> }
                @if (menu.ChildMenus != null && menu.ChildMenus.Any())
                {
                    <ul class="sub-menu">
                        @foreach (var childMenu in menu.ChildMenus)
                        {
                            var effectiveChildLink = GetEffectiveMenuLink(childMenu);
                            <li class="menu-item @(childMenu.ChildMenus != null && childMenu.ChildMenus.Any() ? "menu-item-has-children " : "")@(IsChildMenuActive(childMenu) ? "active" : "")">
                                @if (!string.IsNullOrEmpty(effectiveChildLink)) { <a href="@effectiveChildLink">@childMenu.MenuName</a> } else { <a href="#">@childMenu.MenuName</a> }
                                @if (childMenu.ChildMenus != null && childMenu.ChildMenus.Any())
                                {
                                    <ul class="sub-menu">
                                        @foreach (var grandChildMenu in childMenu.ChildMenus)
                                        {
                                            var effectiveGrandChildLink = GetEffectiveMenuLink(grandChildMenu, childMenu);
                                            <li class="menu-item @(IsGrandChildMenuActive(grandChildMenu, childMenu) ? "active" : "")">
                                                @if (!string.IsNullOrEmpty(effectiveGrandChildLink)) { <a href="@effectiveGrandChildLink">@grandChildMenu.MenuName</a> } else { <a href="#">@grandChildMenu.MenuName</a> }
                                            </li>
                                        }
                                    </ul>
                                }
                            </li>
                        }
                    </ul>
                }
            </li>
        }
        @if (!eventsMenuFound)
        {
            <li class="menu-item menu-item-has-children @(Request.Url.AbsolutePath.StartsWith("/Events") ? "active" : "")">
                <a href="@Url.Action("Index", "Events")">Events</a>
                <ul class="sub-menu">@{ var latestEvents = Html.Action("GetLatestEvents", "Events"); }@latestEvents</ul>
            </li>
        }
    </ul>
</nav>

@functions {
    private bool IsHomePage()
    {
        var path = Request?.Url?.AbsolutePath ?? string.Empty;
        return path == "/" || path.Equals("/Home", StringComparison.OrdinalIgnoreCase) || path.Equals("/Home/Index", StringComparison.OrdinalIgnoreCase);
    }
    private string InferLevelFromName(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return null;
        if (name.IndexOf("undergraduate", StringComparison.OrdinalIgnoreCase) >= 0) return "undergraduate";
        if (name.IndexOf("postgraduate", StringComparison.OrdinalIgnoreCase) >= 0) return "postgraduate";
        if (name.IndexOf("phd", StringComparison.OrdinalIgnoreCase) >= 0 || name.IndexOf("ph.d", StringComparison.OrdinalIgnoreCase) >= 0) return "phd";
        return null;
    }

    private string GetEffectiveMenuLink(tblMenus menu) => GetEffectiveMenuLink(menu, null);

    private string GetEffectiveMenuLink(tblMenus menu, tblMenus parent)
    {
        if (menu == null || string.IsNullOrWhiteSpace(menu.MenuLink)) return menu?.MenuLink;
        if (menu.MenuLink.IndexOf("/Faculties/Programs", StringComparison.OrdinalIgnoreCase) < 0) return menu.MenuLink;
        var level = InferLevelFromName(menu.MenuName) ?? InferLevelFromName(parent?.MenuName);
        if (string.IsNullOrEmpty(level)) return menu.MenuLink;
        if (string.Equals(level, "undergraduate", StringComparison.OrdinalIgnoreCase))
        {
            if (menu.MenuLink.IndexOf("level=", StringComparison.OrdinalIgnoreCase) >= 0) return menu.MenuLink; // already explicit
            return menu.MenuLink; // keep base for UG
        }
        if (menu.MenuLink.IndexOf("level=", StringComparison.OrdinalIgnoreCase) >= 0) return menu.MenuLink;
        var separator = menu.MenuLink.Contains("?") ? "&" : "?";
        return menu.MenuLink + separator + "level=" + level;
    }

    private bool IsMenuActive(tblMenus menu)
    {
        if (IsMenuLinkActive(menu)) return true;
        if (menu.ChildMenus != null && menu.ChildMenus.Any())
            foreach (var childMenu in menu.ChildMenus)
                if (IsChildMenuActive(childMenu)) return true;
        return false;
    }

    private bool IsChildMenuActive(tblMenus childMenu)
    {
        if (IsMenuLinkActive(childMenu)) return true;
        if (childMenu.ChildMenus != null && childMenu.ChildMenus.Any())
            foreach (var grandChild in childMenu.ChildMenus)
                if (IsGrandChildMenuActive(grandChild, childMenu)) return true;
        return false;
    }

    private bool IsGrandChildMenuActive(tblMenus grandChildMenu, tblMenus parent) => IsMenuLinkActive(grandChildMenu, parent);
    private bool IsMenuLinkActive(tblMenus menu) => IsMenuLinkActive(menu, null);

    private bool IsMenuLinkActive(tblMenus menu, tblMenus parent)
    {
        if (string.IsNullOrEmpty(menu?.MenuLink)) return false;
        var currentUri = Request.Url; if (currentUri == null) return false; var currentPathAndQuery = currentUri.PathAndQuery;
        var effective = GetEffectiveMenuLink(menu, parent); if (string.IsNullOrWhiteSpace(effective)) return false;
        string comparable = effective;
        if (effective.StartsWith("http", StringComparison.OrdinalIgnoreCase)) { try { comparable = new Uri(effective).PathAndQuery; } catch { return false; } }
        // Prevent unrelated items showing active on home page
        if (IsHomePage() && !(comparable == "/" || comparable.Equals("/Home", StringComparison.OrdinalIgnoreCase) || comparable.StartsWith("/Home/Index", StringComparison.OrdinalIgnoreCase)))
        {
            return false;
        }
        if (currentPathAndQuery.Equals(comparable, StringComparison.OrdinalIgnoreCase)) return true;
        if (comparable.IndexOf("/Faculties/Programs", StringComparison.OrdinalIgnoreCase) >= 0 &&
            comparable.IndexOf("level=undergraduate", StringComparison.OrdinalIgnoreCase) >= 0 &&
            currentPathAndQuery.StartsWith(comparable.Replace("level=undergraduate", string.Empty).TrimEnd('&','?'), StringComparison.OrdinalIgnoreCase) &&
            currentPathAndQuery.IndexOf("level=", StringComparison.OrdinalIgnoreCase) < 0) return true;
        return false;
    }
}
