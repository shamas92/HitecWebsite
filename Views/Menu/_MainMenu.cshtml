@model IEnumerable<HitecCM.Models.tblMenus>
@using HitecCM.Models

<ul class="main-menu">
    @foreach (var menu in Model)
    {
        <li class="@(menu.ChildMenus != null && menu.ChildMenus.Any() ? "menu-item-has-children" : "") @(IsMenuActive(menu) ? "active" : "")">
            @if (!string.IsNullOrEmpty(menu.MenuLink))
            {
                <a href="@menu.MenuLink">
                    @if (!string.IsNullOrEmpty(menu.SvgIcon))
                    {
                        <img src="@Url.Content("~/Content/img/menuicon/" + menu.SvgIcon)" class="menu-icon" alt="@menu.MenuName icon" />
                        <br />
                    }
                    <span>@menu.MenuName</span>
                </a>
            }
            else
            {
                <a href="#">
                    @if (!string.IsNullOrEmpty(menu.SvgIcon))
                    {
                        <img src="@Url.Content("~/Content/img/menuicon/" + menu.SvgIcon)" class="menu-icon" alt="@menu.MenuName icon" />
                        <br />
                    }
                    <span>@menu.MenuName</span>
                </a>
            }

            @if (menu.ChildMenus != null && menu.ChildMenus.Any())
            {
                <ul class="submenu">
                    @foreach (var childMenu in menu.ChildMenus)
                    {
                        <li class="@(childMenu.ChildMenus != null && childMenu.ChildMenus.Any() ? "menu-item-has-children " : "")@(IsChildMenuActive(childMenu) ? "active" : "")">
                            @if (!string.IsNullOrEmpty(childMenu.MenuLink))
                            {
                                <a href="@childMenu.MenuLink">@childMenu.MenuName</a>
                            }
                            else
                            {
                                <a href="#">@childMenu.MenuName</a>
                            }

                            @if (childMenu.ChildMenus != null && childMenu.ChildMenus.Any())
                            {
                                <ul class="submenu">
                                    @foreach (var grandChildMenu in childMenu.ChildMenus)
                                    {
                                        <li class="@(IsGrandChildMenuActive(grandChildMenu) ? "active" : "")">
                                            @if (!string.IsNullOrEmpty(grandChildMenu.MenuLink))
                                            {
                                                <a href="@grandChildMenu.MenuLink">@grandChildMenu.MenuName</a>
                                            }
                                            else
                                            {
                                                <a href="#">@grandChildMenu.MenuName</a>
                                            }
                                        </li>
                                    }
                                </ul>
                            }
                        </li>
                    }
                </ul>
            }
        </li>
    }
</ul>

@functions {
    /// <summary>
    /// Determines if a menu link is active by comparing its URL with the current request's URL, including query strings.
    /// </summary>
    /// <param name="menu">The menu item to check.</param>
    /// <returns>True if the menu link matches the current URL.</returns>
    private bool IsMenuLinkActive(tblMenus menu)
    {
        if (string.IsNullOrEmpty(menu.MenuLink))
        {
            return false;
        }

        var currentUri = Request.Url;
        if (currentUri == null)
        {
            return false;
        }

        // Get the full relative path and query of the current page.
        // e.g., "/Faculties/DepartmentsAbout?department=EE"
        var currentPathAndQuery = currentUri.PathAndQuery;

        // The menu link from the database.
        // We expect it to be in a format like "/Faculties/DepartmentsAbout?department=EE"
        var menuLink = menu.MenuLink;

        // Normalize the menu link to ensure it's a comparable relative path.
        string comparableMenuLink = menuLink;
        if (menuLink.StartsWith("http", StringComparison.OrdinalIgnoreCase))
        {
            try
            {
                // If it's a full URL, extract just the path and query.
                comparableMenuLink = new Uri(menuLink).PathAndQuery;
            }
            catch
            {
                // If the URL is malformed, it can't be active.
                return false;
            }
        }
        // Note: The ambiguous "Controller/Action" format is no longer used for matching,
        // as it was the source of the problem. Menu links should be stored as full
        // relative paths (e.g., /Controller/Action?param=value) for exact matching.

        // Perform a case-insensitive comparison of the current URL and the menu link.
        // This is the key change: it now compares the entire relative URL, including the query string.
        return currentPathAndQuery.Equals(comparableMenuLink, StringComparison.OrdinalIgnoreCase);
    }

    /// <summary>
    /// Checks if a top-level menu item or any of its descendants are active.
    /// </summary>
    private bool IsMenuActive(tblMenus menu)
    {
        // Check if this menu itself is active.
        if (IsMenuLinkActive(menu))
            return true;

        // Recursively check if any child menu is active.
        if (menu.ChildMenus != null && menu.ChildMenus.Any())
        {
            foreach (var childMenu in menu.ChildMenus)
            {
                if (IsChildMenuActive(childMenu))
                    return true;
            }
        }

        return false;
    }

    /// <summary>
    /// Checks if a second-level menu item or any of its children (grandchildren) are active.
    /// </summary>
    private bool IsChildMenuActive(tblMenus childMenu)
    {
        // Check if this child menu is active.
        if (IsMenuLinkActive(childMenu))
            return true;

        // Recursively check if any of its children (grandchildren) are active.
        if (childMenu.ChildMenus != null && childMenu.ChildMenus.Any())
        {
            foreach (var grandChild in childMenu.ChildMenus)
            {
                if (IsGrandChildMenuActive(grandChild))
                    return true;
            }
        }

        return false;
    }

    /// <summary>
    /// Checks if a third-level menu item is active.
    /// </summary>
    private bool IsGrandChildMenuActive(tblMenus grandChildMenu)
    {
        // A grandchild is active only if its own link matches the current URL.
        return IsMenuLinkActive(grandChildMenu);
    }
}