@{
    ViewBag.Title = ViewBag.Title ?? "Academic Deficiencies";
    ViewBag.MetaDescription = ViewBag.MetaDescription ?? "Policies regarding academic warning, probation, suspension and dismissal, with improvement plans and review process at HITEC University.";
    ViewBag.MetaKeywords = ViewBag.MetaKeywords ?? "Academic deficiencies, warning, probation, suspension, dismissal, CGPA, improvement plan, HITEC University";
}

@section Styles {
    <link href="~/Content/css/admissions.css" rel="stylesheet" />
}

@section Meta {
    <meta name="description" content="@ViewBag.MetaDescription" />
    <meta name="keywords" content="@ViewBag.MetaKeywords" />
    <meta property="og:title" content="@ViewBag.Title - HITEC University" />
    <meta property="og:description" content="@ViewBag.MetaDescription" />
    <meta property="og:type" content="website" />
}

<!-- breadcrumb start -->
<section class="breadcrumb bg_img ul_li" style="padding: 0; min-height: 0;" data-background="/Content/img/bg/about_bg.jpg">
    <div class="container">
        <div class="breadcrumb__content text-center">
            <h1 class="breadcrumb__title mt-25" style="color: #000">Academic Deficiencies</h1>
            <p class="breadcrumb__desc mb-50" style="color: #000">Warnings, probation, and improvement process</p>
        </div>
    </div>
</section>
<!-- breadcrumb end -->

<!-- content start -->
<section class="about pb-120 def-section">
    <div class="container">
        <div class="faculty-page-layout">
            <div class="faculty-page-content">
                <div class="about-content mt-60">

                    <!-- Hero -->
                    <div class="fund-hero">
                        <div class="subtitle">Academic Standing</div>
                        <h1>Academic Deficiencies</h1>
                        <div class="accent-line"></div>
                        <p>
                            Guidance for students placed on academic warning or probation, including CGPA thresholds, required improvement plans and process for restoration to good standing.
                        </p>
                    </div>

                    <!-- Definitions and stages -->
                    <div class="fund-card">
                        <div class="fund-header">
                            <div class="fund-badge"><i class="fas fa-thumbtack"></i></div>
                            <h3 class="fund-title">Definitions & Stages</h3>
                        </div>
                        <div class="fund-content">
                            <ul>
                                <li><strong>Warning:</strong> Issued when semester performance drops close to minimum requirements.</li>
                                <li><strong>Probation:</strong> Applied when CGPA falls below the prescribed threshold; restrictions on course load may apply.</li>
                                <li><strong>Suspension/Dismissal:</strong> Failure to improve within allowed chances may lead to separation as per policy.</li>
                            </ul>
                            <p class="note-box">Exact thresholds and counts may vary by program and will follow the University regulations notified from time to time.</p>
                        </div>
                    </div>

                    <!-- CGPA thresholds -->
                    <div class="fund-card">
                        <div class="fund-header">
                            <div class="fund-badge"><i class="fas fa-chart-line"></i></div>
                            <h3 class="fund-title">Typical CGPA Thresholds (Illustrative)</h3>
                        </div>
                        <div class="fund-content">
                            <table class="fee-table">
                                <thead>
                                    <tr>
                                        <th>Program</th>
                                        <th class="numeric">Good Standing</th>
                                        <th class="numeric">Probation Below</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>Undergraduate</td>
                                        <td class="numeric">>= 2.00</td>
                                        <td class="numeric">< 2.00</td>
                                    </tr>
                                    <tr>
                                        <td>MS</td>
                                        <td class="numeric">>= 2.50</td>
                                        <td class="numeric">< 2.50</td>
                                    </tr>
                                    <tr>
                                        <td>PhD</td>
                                        <td class="numeric">>= 3.00</td>
                                        <td class="numeric">< 3.00</td>
                                    </tr>
                                </tbody>
                            </table>
                            <p class="note-box">Refer to the official regulations for current, program-specific thresholds.</p>
                        </div>
                    </div>

                    <!-- Improvement plan -->
                    <div class="fund-card">
                        <div class="fund-header">
                            <div class="fund-badge"><i class="fas fa-tools"></i></div>
                            <h3 class="fund-title">Improvement Plan</h3>
                        </div>
                        <div class="fund-content">
                            <ul>
                                <li>Reduced course load and mandatory advising as notified by the department.</li>
                                <li>Repeat failed/low-grade courses subject to policy and availability.</li>
                                <li>Meet milestones set in the plan; non-compliance may extend probation.</li>
                            </ul>
                        </div>
                    </div>

                    <!-- Review & restoration -->
                    <div class="fund-card">
                        <div class="fund-header">
                            <div class="fund-badge"><i class="fas fa-sync-alt"></i></div>
                            <h3 class="fund-title">Review and Restoration</h3>
                        </div>
                        <div class="fund-content">
                            <p>Standing is reviewed at the end of each semester. Probation is removed once the student achieves the minimum CGPA and clears mandatory conditions.</p>
                        </div>
                    </div>

                    <!-- Appeals & support -->
                    <div class="fund-card">
                        <div class="fund-header">
                            <div class="fund-badge"><i class="fas fa-compass"></i></div>
                            <h3 class="fund-title">Appeals and Student Support</h3>
                        </div>
                        <div class="fund-content">
                            <ul>
                                <li>Students may submit appeals as per notified timelines and procedures.</li>
                                <li>Counseling and academic support resources are available through departments.</li>
                            </ul>
                        </div>
                    </div>

                </div>
            </div>
            <div class="faculty-page-sidebar">
                @Html.Partial("_AdmissionSidebar")
            </div>
        </div>
    </div>
</section>
<!-- content end -->