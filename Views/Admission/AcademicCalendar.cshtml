@model Website.Models.AcademicCalendar
@{
    ViewBag.Title = string.IsNullOrWhiteSpace(Model?.Title) ? "Academic Calendar" : Model.Title;
    ViewBag.MetaDescription = ViewBag.MetaDescription ?? "View the academic calendar including important dates for admissions, semesters, and examinations at HITEC University.";
    ViewBag.MetaKeywords = ViewBag.MetaKeywords ?? "Academic Calendar, admissions, semester dates, exam schedule, HITEC University";
}

@section Meta {
    <meta name="description" content="@ViewBag.MetaDescription" />
    <meta name="keywords" content="@ViewBag.MetaKeywords" />
    <meta property="og:title" content="@ViewBag.Title - HITEC University" />
    <meta property="og:description" content="@ViewBag.MetaDescription" />
    <meta property="og:type" content="website" />
}

@section Styles {
    <link href="~/Content/css/admissions.css" rel="stylesheet" />
}

<div class="body_wrap">
    <main aria-labelledby="title">
        <!-- breadcrumb start -->
        <section class="breadcrumb bg_img ul_li" style="padding: 0; min-height: 0;" data-background="/Content/img/bg/about_bg.jpg">
            <div class="container">
                <div class="breadcrumb__content text-center">
                    <h1 class="breadcrumb__title mt-25" style="color: #000">@ViewBag.Title</h1>
                    <p class="breadcrumb__desc mb-50" style="color: #000">Important Dates & Schedules</p>
                </div>
            </div>
        </section>
        <!-- breadcrumb end -->

        <!-- content start -->
        <section class="about pb-120 cal-section">
            <div class="container">
                <div class="faculty-page-layout">
                    <div class="faculty-page-content">
                        @if (!string.IsNullOrWhiteSpace(Model?.DescripQon))
                        {
                            <!-- Dynamic content from database -->
                            @Html.Raw(Model.DescripQon)
                        }
                    </div>
                    <div class="faculty-page-sidebar">
                        @Html.Partial("_AdmissionSidebar")
                    </div>
                </div>
            </div>
        </section>
        <!-- content end -->
    </main>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Force hide preloader
            setTimeout(function () {
                $('#preloader').fadeOut('slow', function () {
                    $(this).remove();
                });
            }, 500);

            // Smooth animations for calendar cards present in dynamic content
            $('.cal-card').each(function(i) {
                $(this).delay(100 * i).fadeIn(500);
            });
        });
    </script>
}
