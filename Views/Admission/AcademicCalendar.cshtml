@{
    ViewBag.Title = ViewBag.Title ?? "Academic Calendar";
    ViewBag.MetaDescription = ViewBag.MetaDescription ?? "View the academic calendar including important dates for admissions, semesters, and examinations at HITEC University.";
    ViewBag.MetaKeywords = ViewBag.MetaKeywords ?? "Academic Calendar, admissions, semester dates, exam schedule, HITEC University";
}

@section Meta {
    <meta name="description" content="@ViewBag.MetaDescription" />
    <meta name="keywords" content="@ViewBag.MetaKeywords" />
    <meta property="og:title" content="@ViewBag.Title - HITEC University" />
    <meta property="og:description" content="@ViewBag.MetaDescription" />
    <meta property="og:type" content="website" />
}

<body>
    <div class="body_wrap">
        <main aria-labelledby="title">
            <!-- breadcrumb start -->
            <section class="breadcrumb bg_img ul_li" style="padding: 0; min-height: 0;" data-background="/Content/img/bg/about_bg.jpg">
                <div class="container">
                    <div class="breadcrumb__content text-center">
                        <h1 class="breadcrumb__title mt-25" style="color: #000">Academic Calendar</h1>
                        <p class="breadcrumb__desc mb-50" style="color: #000">Important Dates & Schedules</p>
                    </div>
                </div>
            </section>
            <!-- breadcrumb end -->

            <!-- content start -->
            <section class="about pb-120">
                <div class="container">
                    <div class="faculty-page-layout">
                        <div class="faculty-page-content">
                            <div class="about-content mt-60">
                                <div class="section-title mb-40">
                                    <span class="sub-title">Admissions</span>
                                    <h2 class="title">Academic Calendar</h2>
                                </div>
                                <p>
                                    The academic calendar outlines important dates for admissions, semester timelines, examinations, and university events.
                                    This placeholder page will soon be updated with the official schedule and downloadable resources.
                                </p>
                                <div class="programs-container" style="margin-top: 25px;">
                                    <div class="program-card">
                                        <h3 class="program-title">Coming Soon</h3>
                                        <div class="program-content">
                                            <ul>
                                                <li>Admission opening and closing dates</li>
                                                <li>Semester start and end dates</li>
                                                <li>Midterm and final examination windows</li>
                                                <li>Public holidays and term breaks</li>
                                            </ul>
                                            <p>For any immediate queries, please contact the Admissions Office.</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="faculty-page-sidebar">
                            @Html.Partial("_FacultySidebar")
                        </div>
                    </div>
                </div>
            </section>
            <!-- content end -->
        </main>
    </div>
</body>
