@functions{
    public string Active(string key)
    {
        var active = ViewBag.ActiveQAC as string;
        return string.Equals(active, key, System.StringComparison.OrdinalIgnoreCase) ? "active" : string.Empty;
    }
}
<div class="faculty-sidebar qac-sidebar">
    <div class="faculty-sidebar__title">Downloads</div>
    <ul class="faculty-sidebar__menu">
        <li><a class="@Active("Updates")" href="@Url.Action("Updates","Downloads")">Updates</a></li>
 
    </ul>
</div>
