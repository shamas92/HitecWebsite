@model List<Website.Models.tblEvent>
@{
    ViewBag.Title = "Open House Events";
    ViewBag.MetaDescription = "Join us for our Open House events at HITEC University. Explore our campus, meet faculty, and discover academic programs and opportunities.";
    ViewBag.MetaKeywords = "Open House, HITEC University, campus tour, academic programs, admissions, university events";
}

@section Styles {
    <style>
        .open-house-hero {
            background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);
            color: white;
            padding: 80px 0;
            text-align: center;
        }

        .open-house-hero h1 {
            font-size: 3rem;
            font-weight: 700;
            margin-bottom: 20px;
        }

        .open-house-hero p {
            font-size: 1.2rem;
            margin-bottom: 0;
            opacity: 0.9;
        }

        .event-card {
            background: white;
            border-radius: 15px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
            overflow: hidden;
            margin-bottom: 30px;
            transition: all 0.3s ease;
            border-left: 5px solid #1e3c72;
        }

        .event-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.12);
        }

        .event-image {
            width: 100%;
            height: 250px;
            overflow: hidden;
            position: relative;
        }

        .event-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.3s ease;
        }

        .event-card:hover .event-image img {
            transform: scale(1.05);
        }

        .event-date-badge {
            position: absolute;
            top: 20px;
            right: 20px;
            background: #1e3c72;
            color: white;
            padding: 10px 15px;
            border-radius: 10px;
            font-weight: 600;
            font-size: 14px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
        }

        .event-content {
            padding: 30px;
        }

        .event-title {
            font-size: 24px;
            font-weight: 600;
            color: #333;
            margin-bottom: 15px;
            line-height: 1.3;
        }

        .event-title a {
            color: inherit;
            text-decoration: none;
            transition: color 0.3s ease;
        }

        .event-title a:hover {
            color: #1e3c72;
        }

        .event-meta {
            display: flex;
            gap: 25px;
            margin-bottom: 20px;
            flex-wrap: wrap;
        }

        .event-meta-item {
            display: flex;
            align-items: center;
            font-size: 14px;
            color: #666;
        }

        .event-meta-icon {
            width: 18px;
            height: 18px;
            margin-right: 8px;
            color: #1e3c72;
        }

        .event-details {
            color: #666;
            line-height: 1.6;
            font-size: 15px;
            margin-bottom: 20px;
        }

        .event-actions {
            display: flex;
            gap: 15px;
            align-items: center;
        }

        .btn-view-details {
            background: #1e3c72;
            color: white;
            padding: 12px 24px;
            border-radius: 8px;
            text-decoration: none;
            font-weight: 600;
            transition: all 0.3s ease;
            border: none;
            cursor: pointer;
        }

        .btn-view-details:hover {
            background: #2a5298;
            color: white;
            text-decoration: none;
            transform: translateY(-2px);
        }

        .event-views {
            color: #999;
            font-size: 13px;
            display: flex;
            align-items: center;
        }

        .no-events-message {
            text-align: center;
            padding: 80px 20px;
            background: #f8f9fa;
            border-radius: 15px;
            margin: 40px 0;
        }

        .no-events-message h3 {
            color: #333;
            margin-bottom: 15px;
            font-size: 24px;
        }

        .no-events-message p {
            color: #666;
            font-size: 16px;
            line-height: 1.6;
        }

        .open-house-stats {
            background: white;
            border-radius: 15px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
            padding: 30px;
            margin-bottom: 40px;
            text-align: center;
        }

        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 30px;
        }

        .stat-item {
            text-align: center;
        }

        .stat-number {
            font-size: 2.5rem;
            font-weight: 700;
            color: #1e3c72;
            display: block;
            margin-bottom: 8px;
        }

        .stat-label {
            color: #666;
            font-size: 14px;
            font-weight: 500;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
    </style>
}

<div class="body_wrap">
    <main>


        <!-- Main Content -->
        <section class="py-5">
            <div class="container">
                

                <!-- Additional Information -->
                <div class="row mt-5">
                    <div class="col-md-8">
                        <div class="about-content">
                            <div class="section-title mb-30">
                                <span class="sub-title">Welcome</span>
                                <h2 class="title">About Our Open House Event</h2>
                            </div>
                            <p>Our Open House events provide prospective students and their families with an excellent opportunity to explore HITEC University's campus, meet our distinguished faculty, and learn about our comprehensive academic programs.</p>
                            
                            <p>During these events, you can:</p>
                            <ul>
                                <li>Tour our state-of-the-art facilities and laboratories</li>
                                <li>Meet with faculty members and current students</li>
                                <li>Learn about admission requirements and procedures</li>
                                <li>Discover scholarship and financial aid opportunities</li>
                                <li>Experience campus life and student activities</li>
                                <li>Get answers to all your questions about university life</li>
                            </ul>

                            <p>We encourage all prospective students to attend these events to get a comprehensive understanding of what HITEC University has to offer.</p>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="contact-info p-4" style="background: #f8f9fa; border-radius: 15px;">
                            <h4>Need More Information?</h4>
                            <p>Contact our admissions office for details about upcoming Open House events.</p>
                            <a href="@Url.Action("ContactUs", "About")" class="btn-view-details">Contact Admissions</a>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </main>
</div>