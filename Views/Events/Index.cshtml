@model Website.ViewModels.EventsIndexViewModel
@{
    ViewBag.Title = "Events";

    // SEO Meta Tags
    ViewBag.MetaDescription = "Browse all events hosted by HITEC University. Stay updated with upcoming seminars, workshops, conferences, and campus activities.";
    ViewBag.MetaKeywords = "HITEC University, events, campus events, university events, seminars, workshops, conferences";
}

@functions {
    private string GetEventPhotoPath(string photoFileName)
    {
        // Default placeholder image
        var defaultImage = "~/Content/img/team/placeholder-1200x627.jpg";

        if (string.IsNullOrEmpty(photoFileName))
        {
            return Url.Content(defaultImage);
        }

        // Check if it's an absolute URL
        if (photoFileName.StartsWith("http://", StringComparison.OrdinalIgnoreCase) ||
  photoFileName.StartsWith("https://", StringComparison.OrdinalIgnoreCase))
        {
            return photoFileName;
        }

        // Check if it's already a rooted path
        if (photoFileName.StartsWith("/") || photoFileName.StartsWith("~/"))
        {
            var serverPath = Server.MapPath(photoFileName);
            if (System.IO.File.Exists(serverPath))
            {
                return Url.Content(photoFileName);
            }
            return Url.Content(defaultImage);
        }

        // Construct the full server path to check if file exists in Events directory
        var relativePath = $"~/Content/img/departments/Events/{photoFileName}";
        var fullServerPath = Server.MapPath(relativePath);

        // Check if the file exists on the server
        if (System.IO.File.Exists(fullServerPath))
        {
            return Url.Content(relativePath);
        }

        // Fallback: check in old uploads/events directory for backward compatibility
        var oldPath = $"~/Content/uploads/events/{photoFileName}";
        var oldServerPath = Server.MapPath(oldPath);
        if (System.IO.File.Exists(oldServerPath))
        {
            return Url.Content(oldPath);
        }

        // Return default image if file doesn't exist
        return Url.Content(defaultImage);
    }

    private System.Web.Routing.RouteValueDictionary BuildFilterRoute(int? page = null, int? pageSize = null)
    {
        return new System.Web.Routing.RouteValueDictionary(new
        {
            q = Model.Q,
            alumni = Model.Alumni,
            headId = Model.HeadId,
            from = Model.From?.ToString("yyyy-MM-dd"),
            to = Model.To?.ToString("yyyy-MM-dd"),
            when = Model.When,
            sort = Model.Sort,
            page = page ?? Model.Page,
            pageSize = pageSize ?? Model.PageSize
        });
    }
}

@section Styles {
    <style>
        .events-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
            grid-gap: 30px;
            margin-top: 30px;
        }

        .event-card {
            background-color: white;
            border-radius: 12px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.08);
            overflow: hidden;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            height: 100%;
            display: flex;
            flex-direction: column;
        }

            .event-card:hover {
                transform: translateY(-10px);
                box-shadow: 0 15px 35px rgba(0,0,0,0.12);
            }

        .event-image {
            height: 280px;
            overflow: hidden;
            position: relative;
        }

            .event-image img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                transition: transform 0.3s ease;
            }

        .event-card:hover .event-image img {
            transform: scale(1.05);
        }

        .event-date-badge {
            position: absolute;
            bottom: 0;
            right: 0;
            background-color: var(--color-primary);
            color: white;
            padding: 8px 12px;
            font-size: 14px;
            font-weight: 600;
            border-top-left-radius: 8px;
        }

        .event-content {
            padding: 25px;
            display: flex;
            flex-direction: column;
            flex-grow: 1;
        }

        .event-title {
            font-size: 20px;
            font-weight: 600;
            margin-bottom: 15px;
            line-height: 1.4;
        }

            .event-title a {
                color: var(--color-heading);
                text-decoration: none;
                transition: color 0.3s ease;
            }

                .event-title a:hover {
                    color: var(--color-primary);
                }

        .event-meta {
            margin-bottom: 15px;
        }

        .event-meta-item {
            display: flex;
            align-items: center;
            margin-bottom: 8px;
            color: var(--color-text);
            font-size: 14px;
        }

        .event-meta-icon {
            margin-right: 8px;
            color: var(--color-primary);
            font-size: 16px;
        }

        .event-excerpt {
            margin-bottom: 20px;
            color: var(--color-text);
            font-size: 15px;
            line-height: 1.6;
            flex-grow: 1;
        }

        .event-read-more {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 10px 20px;
            font-weight: 600;
            color: #fff;
            background: linear-gradient(135deg, #002155 0%, #001a44 100%);
            border-radius: 25px;
            transition: all 0.3s ease;
            margin-top: auto;
            text-decoration: none;
            box-shadow: 0 4px 15px rgba(0, 33, 85, 0.2);
        }

            .event-read-more:hover {
                background: linear-gradient(135deg, #001a44 0%, #002155 100%);
                transform: translateY(-2px);
                box-shadow: 0 6px 20px rgba(0, 33, 85, 0.3);
                color: #fff;
            }

            .event-read-more i {
                margin-left: 8px;
                margin-right: 12px;
                transition: transform 0.3s ease;
            }

            .event-read-more:hover i {
                transform: translateX(5px);
            }

        .no-events {
            text-align: center;
            padding: 60px 0;
        }

            .no-events h3 {
                font-size: 24px;
                color: var(--color-heading);
                margin-bottom: 15px;
            }

            .no-events p {
                font-size: 16px;
                color: var(--color-text);
                max-width: 600px;
                margin: 0 auto;
            }

        /* Filter bar */
        .filters-bar {
            display: grid;
            grid-template-columns: 1fr 160px 160px 160px 160px 120px;
            gap: 12px;
            align-items: end;
        }
        @@media (max-width: 992px) {
            .filters-bar { grid-template-columns: 1fr 1fr; }
        }
        @@media (max-width: 576px) {
            .filters-bar { grid-template-columns: 1fr; }
        }
        .filter-field label { display: block; font-size: 13px; color: var(--color-text); margin-bottom: 6px; }
        .filter-field input[type="text"],
        .filter-field input[type="date"],
        .filter-field select {
            width: 100%;
            height: 40px;
            border: 1px solid #e3e6ef;
            border-radius: 10px;
            padding: 0 12px;
            font-size: 14px;
            background: #fff;
        }
        .filters-actions { display:flex; gap:10px; align-items:center; }
        .btn-primary-rounded {
            background: linear-gradient(135deg, #002155 0%, #001a44 100%);
            color:#fff; border:none; border-radius:22px; padding:10px 18px; font-weight:600; cursor:pointer;
        }
        .btn-ghost { background:#fff; color:#001a44; border:1px solid #cdd6e1; border-radius:22px; padding:10px 16px; }

        /* Results loading state */
        #eventsResults[aria-busy="true"] { opacity:.6; pointer-events:none; }

        /* Pagination */
        .paging-wrap { margin-top: 36px; display:flex; justify-content:center; }
        .pagination { list-style:none; display:flex; gap:8px; padding:0; margin:0; }
        .pagination .page-item { }
        .pagination .page-link {
            display:inline-flex; align-items:center; justify-content:center; min-width:40px; height:40px; padding:0 12px;
            text-decoration:none; color:#0c1b3a; border:1px solid #e3e6ef; border-radius:10px; background:#fff; font-weight:600;
        }
        .pagination .page-item.active .page-link { background:#0c1b3a; color:#fff; border-color:#0c1b3a; }
        .pagination .page-item.disabled .page-link { opacity:.5; pointer-events:none; }
        .pagination .page-ellipsis { display:inline-flex; align-items:center; justify-content:center; min-width:40px; color:#8792a5; }
        .pagination .sr-only { position:absolute; width:1px; height:1px; padding:0; margin:-1px; overflow:hidden; clip:rect(0,0,0,0); border:0; }
    </style>
}

@section Meta {
    <meta name="description" content="@ViewBag.MetaDescription" />
    <meta name="keywords" content="@ViewBag.MetaKeywords" />
    <meta property="og:title" content="@ViewBag.Title - HITEC University" />
    <meta property="og:description" content="@ViewBag.MetaDescription" />
    <meta property="og:type" content="website" />
}

<div class="body_wrap">
    <main>
        <section class="breadcrumb bg_img ul_li" data-background="/Content/img/bg/about_bg.jpg">
            <div class="container">
                <div class="breadcrumb__content text-center">
                    <h1 class="breadcrumb__title">Events</h1>
                    <ul class="breadcrumb__list">
                        <li><a href="@Url.Action("Index", "Home")">Home</a></li>
                        <li>Events</li>
                    </ul>
                </div>
            </div>
        </section>

        <section class="event-list-section pt-80 pb-120">
            <div class="container">
                <div class="section-title mb-30">
                    <span class="sub-title">Campus Activities</span>
                    <h2 class="title">University Events</h2>
                </div>

                <form id="eventsFilters" method="get" class="mb-20" role="search" aria-label="Filter events">
                    <div class="filters-bar">
                        <div class="filter-field">
                            <label for="q">Search</label>
                            <input type="text" id="q" name="q" value="@Model.Q" placeholder="Search by title, venue, category" />
                        </div>
                        <div class="filter-field">
                            <label for="headId">Category</label>
                            <select id="headId" name="headId">
                                <option value="">All categories</option>
                                @foreach (var h in Model.Heads)
                                {
                                    <option value="@h.EventHeadID" @(Model.HeadId == h.EventHeadID ? "selected" : "")>@h.Title</option>
                                }
                            </select>
                        </div>
                        <div class="filter-field">
                            <label for="when">When</label>
                            <select id="when" name="when">
                                <option value="all" @(string.Equals(Model.When, "all", System.StringComparison.OrdinalIgnoreCase) ? "selected" : "")>All</option>
                                <option value="upcoming" @(string.Equals(Model.When, "upcoming", System.StringComparison.OrdinalIgnoreCase) ? "selected" : "")>Upcoming</option>
                                <option value="past" @(string.Equals(Model.When, "past", System.StringComparison.OrdinalIgnoreCase) ? "selected" : "")>Past</option>
                            </select>
                        </div>
                        <div class="filter-field">
                            <label for="alumni">Alumni</label>
                            <select id="alumni" name="alumni">
                                <option value="">Any</option>
                                <option value="true" @(Model.Alumni.HasValue && Model.Alumni.Value ? "selected" : "")>Alumni only</option>
                                <option value="false" @(Model.Alumni.HasValue && !Model.Alumni.Value ? "selected" : "")>Non-alumni</option>
                            </select>
                        </div>
                        <div class="filter-field">
                            <label>From</label>
                            <input type="date" name="from" value="@(Model.From.HasValue ? Model.From.Value.ToString("yyyy-MM-dd") : "")" />
                        </div>
                        <div class="filter-field">
                            <label>To</label>
                            <input type="date" name="to" value="@(Model.To.HasValue ? Model.To.Value.ToString("yyyy-MM-dd") : "")" />
                        </div>
                    </div>

                    <div class="filters-actions" style="margin-top:12px; justify-content: space-between;">
                        <div style="display:flex; gap:10px; align-items:center;">
                            <label for="sort" class="sr-only">Sort</label>
                            @*<select id="sort" name="sort">
                                <option value="date_desc" @(string.Equals(Model.Sort, "date_desc", System.StringComparison.OrdinalIgnoreCase) ? "selected" : "")>Newest first</option>
                                <option value="date_asc" @(string.Equals(Model.Sort, "date_asc", System.StringComparison.OrdinalIgnoreCase) ? "selected" : "")>Oldest first</option>
                                <option value="views_desc" @(string.Equals(Model.Sort, "views_desc", System.StringComparison.OrdinalIgnoreCase) ? "selected" : "")>Most viewed</option>
                                <option value="title_asc" @(string.Equals(Model.Sort, "title_asc", System.StringComparison.OrdinalIgnoreCase) ? "selected" : "")>Title A–Z</option>
                            </select>*@
                            <label for="pageSize" class="sr-only">Page size</label>
                            <select id="pageSize" name="pageSize">
                                @foreach (var s in new[]{6,12,24,48})
                                {
                                    <option value="@s" @(Model.PageSize == s ? "selected" : "")>@s / page</option>
                                }
                            </select>
                        </div>
                        <div style="display:flex; gap:10px;">
                            <button type="submit" class="btn-primary-rounded">Apply</button>
                            <a class="btn-ghost" href="@Url.Action("Index", "Events")" id="resetFilters">Reset</a>
                        </div>
                    </div>
                </form>

                <div id="eventsResults" aria-live="polite" aria-busy="false">
                    @Html.Partial("_EventsList", Model)
                </div>
            </div>
        </section>
    </main>
</div>

@section Scripts {
    <script>
        (function () {
            var form = document.getElementById('eventsFilters');
            var results = document.getElementById('eventsResults');
            if (!form || !results) return;

            function buildUrlFromForm() {
                var base = form.getAttribute('action') || '@Url.Action("Index", "Events")';
                var query = $(form).serialize();
                return base + (query ? ('?' + query) : '');
            }

            function setBusy(isBusy) {
                results.setAttribute('aria-busy', isBusy ? 'true' : 'false');
            }

            function ajaxFetch(url) {
                setBusy(true);
                $.ajax({
                    url: url,
                    method: 'GET'
                })
                    .done(function (html) {
                    $('#eventsResults').html(html);
                    //window.scrollTo({ top: $('#eventsResults').offset().top - 100, behavior: 'smooth' });
                    })
                    .fail(function () {
                    $('#eventsResults').html('<div class="no-events"><h3>Error</h3><p>Unable to load events. Please try again.</p></div>');
                }).always(function () {
                    setBusy(false);
                });
            }

            function resetToFirstPage() {
                var pageInput = form.querySelector('input[name="page"]');
                if (!pageInput) {
                    pageInput = document.createElement('input');
                    pageInput.type = 'hidden';
                    pageInput.name = 'page';
                    form.appendChild(pageInput);
                }
                pageInput.value = '1';
            }

            function onFiltersChanged() {
                resetToFirstPage();
                var url = buildUrlFromForm();
                history.replaceState(null, '', url);
                ajaxFetch(url);
            }

            var debounceTimer;
            function debounce(fn, wait) {
                return function () {
                    clearTimeout(debounceTimer);
                    var ctx = this, args = arguments;
                    debounceTimer = setTimeout(function () { fn.apply(ctx, args); }, wait || 350);
                };
            }

            // Intercept form submit
            $(form).on('submit', function (e) {
                e.preventDefault();
                onFiltersChanged();
            });

            // Inputs change handlers
            $('#q').on('input', debounce(onFiltersChanged, 400));
            $('#headId,#when,#alumni,#sort,#pageSize').on('change', onFiltersChanged);
            $(form).find('input[type="date"]').on('change', onFiltersChanged);

            // Intercept pagination clicks (delegate to container)
            $(document).on('click', '#eventsResults .pagination a', function (e) {
                e.preventDefault();
                var href = this.href;
                history.replaceState(null, '', href);
                ajaxFetch(href);
            });

            // Reset link without reload
            $('#resetFilters').on('click', function (e) {
                e.preventDefault();
                form.reset();
                // Clear selects back to default
                $('#headId').val('');
                $('#when').val('all');
                $('#alumni').val('');
                $('#sort').val('date_desc');
                $('#pageSize').val('12');
                // Clear date and search
                $('#q').val('');
                $(form).find('input[type="date"]').val('');
                resetToFirstPage();
                var url = (this.href || '@Url.Action("Index", "Events")');
                history.replaceState(null, '', url);
                ajaxFetch(url);
            });
        })();
    </script>
}