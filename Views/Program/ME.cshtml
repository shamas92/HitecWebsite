@{
    ViewBag.Title = ViewBag.Title ?? "Mechanical Engineering";
    ViewBag.MetaDescription = ViewBag.MetaDescription ?? "Explore the Mechanical Engineering undergraduate program at HITEC University, including curriculum, labs, and career opportunities.";
    ViewBag.MetaKeywords = ViewBag.MetaKeywords ?? "Mechanical Engineering, ME program, undergraduate, engineering, HITEC University";
}

@section Meta {
    <meta name="description" content="@ViewBag.MetaDescription" />
    <meta name="keywords" content="@ViewBag.MetaKeywords" />
    <meta property="og:title" content="@ViewBag.Title - HITEC University" />
    <meta property="og:description" content="@ViewBag.MetaDescription" />
    <meta property="og:type" content="website" />
}

<body>
    <div class="body_wrap">
        <main aria-labelledby="title">
            <!-- breadcrumb start -->
            <section class="breadcrumb bg_img ul_li" style="padding: 0; min-height: 0;" data-background="/Content/img/bg/about_bg.jpg">
                <div class="container">
                    <div class="breadcrumb__content text-center">
                        <h1 class="breadcrumb__title mt-25" style="color: #000">Mechanical Engineering</h1>
                        <p class="breadcrumb__desc mb-50" style="color: #000">Undergraduate Program</p>
                    </div>
                </div>
            </section>
            <!-- breadcrumb end -->

            <!-- content start -->
            <section class="about pb-120">
                <div class="container">
                    <div class="faculty-page-layout">
                        <div class="faculty-page-content">
                            <div class="about-content mt-60">
                                <div class="section-title mb-40">
                                    <span class="sub-title">Programs</span>
                                    <h2 class="title">BS Mechanical Engineering</h2>
                                </div>
                                <p>
                                    This placeholder page represents the Mechanical Engineering undergraduate program. It will be updated soon with comprehensive details about curriculum structure, labs, accreditation, and admission requirements.
                                </p>
                                <div class="programs-container" style="margin-top: 25px;">
                                    <div class="program-card">
                                        <h3 class="program-title">Program Highlights</h3>
                                        <div class="program-content">
                                            <ul>
                                                <li>Outcome-based education approach</li>
                                                <li>Well-equipped labs and workshops</li>
                                                <li>Strong industry linkage</li>
                                                <li>Capstone design projects</li>
                                            </ul>
                                            <p>Detailed information will be posted here soon.</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="faculty-page-sidebar">
                            @Html.Partial("_FacultySidebar")
                        </div>
                    </div>
                </div>
            </section>
            <!-- content end -->
        </main>
    </div>
</body>
