@model HitecCM.Models.tblTransport
@{
    ViewBag.Title = !string.IsNullOrEmpty(Model?.Title) ? Model.Title : "Transport Facilities";
    
    // SEO Meta Tags
    ViewBag.MetaDescription = "Learn about the transport facilities and shuttle services provided by HITEC University.";
    ViewBag.MetaKeywords = "HITEC University, transport, shuttle service, bus routes, student transportation, campus commute";
}



@section Meta {
    <meta name="description" content="@ViewBag.MetaDescription" />
    <meta name="keywords" content="@ViewBag.MetaKeywords" />
    <meta property="og:title" content="@ViewBag.Title - HITEC University" />
    <meta property="og:description" content="@ViewBag.MetaDescription" />
    <meta property="og:type" content="website" />
}

<div class="body_wrap">
    <main>
        <!-- breadcrumb start -->
        <section class="breadcrumb bg_img ul_li" style="padding: 0; min-height: 0;" data-background="/Content/img/bg/about_bg.jpg">
            <div class="container">
                <div class="breadcrumb__content text-center">
                    <h1 class="breadcrumb__title mt-25" style="color: #000">@ViewBag.Title</h1>
                    <p class="breadcrumb__desc mb-50" style="color: #000">Campus Transport Services</p>
                </div>
            </div>
        </section>
        <!-- breadcrumb end -->

        <!-- content section start -->
        <section class="facility-content">
            <div class="container">
                <div class="row">
                    <div class="col-lg-12">
                        <div class="section-title mb-40">
                            <span class="sub-title">Campus Services</span>
                            <h2 class="title">University Transport Services</h2>
                        </div>

                        @if (Model != null && !string.IsNullOrEmpty(Model.PageData))
                        {
                            <div class="content-box">
                                <h4><i class="fas fa-bus"></i> Transport Information</h4>
                                @Html.Raw(Model.PageData)
                                @if (Model.UpdatedAt.HasValue || Model.CreatedAt != default(DateTime))
                                {
                                    <p class="mt-3"><small><em>Last Updated: @(Model.UpdatedAt?.ToString("MMM dd, yyyy") ?? Model.CreatedAt.ToString("MMM dd, yyyy"))</em></small></p>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="no-content">
                                <i class="fas fa-info-circle" style="font-size: 48px; margin-bottom: 20px;"></i>
                                <h3>No Transport Information Available</h3>
                                <p>Transport information is currently being updated. Please contact the Transport Office for current information.</p>
                            </div>
                        }

                        
                    </div>
                </div>
            </div>
        </section>
        <!-- content section end -->
    </main>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            setTimeout(function () {
                $('#preloader').fadeOut('slow', function () {
                    $(this).remove();
                });
            }, 500);
        });
    </script>
}