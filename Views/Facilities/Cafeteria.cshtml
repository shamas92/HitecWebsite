@model HitecCM.Models.tblCafeteria
@{
    ViewBag.Title = !string.IsNullOrEmpty(Model?.Title) ? Model.Title : "Cafeteria Facilities";
    
    // SEO Meta Tags
    ViewBag.MetaDescription = "Discover the cafeteria and dining facilities at HITEC University. Comprehensive food services, meal plans, and dining options available for students and staff.";
    ViewBag.MetaKeywords = "HITEC University, cafeteria, dining, food services, meal plans, campus food, university dining, student meals";
}

@section Meta {
    <meta name="description" content="@ViewBag.MetaDescription" />
    <meta name="keywords" content="@ViewBag.MetaKeywords" />
    <meta property="og:title" content="@ViewBag.Title - HITEC University" />
    <meta property="og:description" content="@ViewBag.MetaDescription" />
    <meta property="og:type" content="website" />
}

<div class="body_wrap">
    <main>
        <!-- breadcrumb start -->
        <section class="breadcrumb bg_img ul_li" style="padding: 0; min-height: 0;" data-background="/Content/img/bg/about_bg.jpg">
            <div class="container">
                <div class="breadcrumb__content text-center">
                    <h1 class="breadcrumb__title mt-25" style="color: #000">@ViewBag.Title</h1>
                    <p class="breadcrumb__desc mb-50" style="color: #000">Dining & Food Services</p>
                </div>
            </div>
        </section>
        <!-- breadcrumb end -->

        <!-- content section start -->
        <section class="facility-content">
            <div class="container">
                <div class="row">
                    <div class="col-lg-12">

                        @if (Model != null && !string.IsNullOrEmpty(Model.PageData))
                        {
                            <div class="content-box">
                                @Html.Raw(Model.PageData)
                            </div>
                        }
                        else
                        {
                            <div class="no-content">
                                <i class="fas fa-info-circle" style="font-size: 48px; margin-bottom: 20px;"></i>
                                <h3>No Cafeteria Information Available</h3>
                                <p>Cafeteria information is currently being updated. Please contact the Cafeteria Management for current information.</p>
                                <p><strong>For immediate assistance, please contact:</strong></p>
                                <p>📞 Phone: +92-51-5160666<br>
                                   📧 Email: info@hitecuni.edu.pk</p>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </section>
        <!-- content section end -->
    </main>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            setTimeout(function () {
                $('#preloader').fadeOut('slow', function () {
                    $(this).remove();
                });
            }, 500);
        });
    </script>
}