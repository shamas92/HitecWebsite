<!-- header start -->
<header id="xb-header-area" class="header-area is-sticky">
    <div class="xb-header">
        <div class="container">
            <div class="header__wrap ul_li_between">
                <div class="header-logo" style="display: flex; align-items: center; gap: 12px;">
                    <link rel="stylesheet" href="~/Content/css/recoleta-font.css" />
                    <a href="/Home/Index"><img src="~/Content/img/logo/HitecLogo.svg" alt="" style="height: 80px; width: auto;"></a>
                    <div class="mobile-header-title d-lg-none" style="font-weight: 700; font-size: 20px; color: #002155; text-transform: uppercase; font-family: 'Recoleta', serif;">HITEC UNIVERSITY</div>
                </div>
                <div class="main-menu__wrap ul_li navbar navbar-expand-lg">
                    <nav class="main-menu collapse navbar-collapse">
                        @Html.Action("GetMainMenu", "Menu")
                    </nav>
                    <div class="xb-header-wrap">
                        <div class="xb-header-menu">
                            <div class="xb-header-menu-scroll">
                                <div class="xb-menu-close xb-hide-xl xb-close"></div>
                                <div class="xb-logo-mobile xb-hide-xl" style="display: ruby-text;">
                                    <a href="/Home/Index" rel="home"><img src="~/Content/img/logo/HitecLogo.svg" alt=""></a>
                                    <div class="mobile-header-title d-lg-none" style="font-weight: 700; font-size: 18px; color: #002155; text-transform: uppercase; font-family: 'Recoleta', serif;">HITEC UNIVERSITY</div>
                                </div>
                                @*<div class="xb-header-mobile-search xb-hide-xl">
                                        <form role="search" action="#">
                                            <input type="text" placeholder="Search..." name="s" class="search-field">
                                            <button class="search-submit" type="submit"><i class="far fa-search"></i></button>
                                        </form>
                                    </div>*@
                                <nav class="xb-header-nav">
                                    @Html.Action("GetMobileMainMenu", "Menu")

                                </nav>
                            </div>
                        </div>
                        <div class="xb-header-menu-backdrop"></div>
                    </div>
                </div>
                <div class="header-right ul_li">

                </div>
                <div class="header-bar-mobile side-menu d-lg-none">
                    <a class="xb-nav-mobile" href="javascript:void(0);"><i class="fas fa-bars"></i></a>
                </div>
            </div>
        </div>
    </div>
    <!-- News Marquee - Start -->
    <div class="news-marquee-wrapper">
        <div class="container">
            <div class="news-marquee">
                <div class="news-marquee-content">
                    <div class="news-label">
                        <i class="fas fa-newspaper"></i>
                        Latest News
                    </div>
                    <div class="news-scroll-container">
                        <div class="news-scroll">
                            @Html.Action("GetNewsMenu", "Menu")
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- News Marquee - End -->
    <div class="header-top_wrap">
        <div class="container">
            <div class="header-top ul_li_between">

                <div class="xb-info">
                    <ul class="ul_li align-items-end hitec-topmenu">
                        @Html.Action("GetMiddleMenu", "Menu")
                    </ul>
                </div>
                <div class="top-menu__actions">
                    <ul class="ul_li">
                        @Html.Action("GetTopMenu", "Menu")
                    </ul>
                </div>
            </div>
        </div>
    </div>
</header>
<span style="display:none; visibility:hidden;">Made with ❤️ by Shamas</span>
<div class="body-overlay"></div>
<!-- header search end -->