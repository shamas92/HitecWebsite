    <!-- header start -->
<header id="xb-header-area" class="header-area is-sticky">
    <div class="xb-header">
        <div class="container">
            <div class="header__wrap ul_li_between">
                <div class="header-logo" style="display: flex; align-items: center; gap: 12px;">
                    <a href="/Home/Index"><img src="~/Content/img/logo/HitecLogo.svg" alt="" style="height: 56px; width: auto;"></a>
                </div>
                <div class="main-menu__wrap ul_li navbar navbar-expand-lg">
                    <nav class="main-menu collapse navbar-collapse">
                        @Html.Action("GetMainMenu", "Menu")

                    </nav>
                    <div class="xb-header-wrap">
                        <div class="xb-header-menu">
                            <div class="xb-header-menu-scroll">
                                <div class="xb-menu-close xb-hide-xl xb-close"></div>
                                <div class="xb-logo-mobile xb-hide-xl">
                                    <a href="/Home/Index" rel="home"><img src="~/Content/img/logo/HitecLogo.svg" alt=""></a>
                                </div>
                                <div class="xb-header-mobile-search xb-hide-xl">
                                    <form role="search" action="#">
                                        <input type="text" placeholder="Search..." name="s" class="search-field">
                                        <button class="search-submit" type="submit"><i class="far fa-search"></i></button>
                                    </form>
                                </div>
                                <nav class="xb-header-nav">
                                    @Html.Action("GetMobileMainMenu", "Menu")

                                </nav>
                            </div>
                        </div>
                        <div class="xb-header-menu-backdrop"></div>
                    </div>
                </div>
                <div class="header-right ul_li">

                </div>
                <div class="header-bar-mobile side-menu d-lg-none">
                    <a class="xb-nav-mobile" href="javascript:void(0);"><i class="fal fa-bars"></i></a>
                </div>
            </div>
        </div>
    </div>
    <div class="news-marquee-wrapper">
        <div class="container">
            <div class="news-marquee">
                <div class="news-marquee-content">
                    <div class="news-label">
                        <i class="fas fa-newspaper"></i>
                        Latest News
                    </div>
                    <div class="news-scroll-container">
                        <div class="news-scroll">
                            <a href="/news/spring-admissions-2024" class="news-item">
                                Spring Admissions 2024 Now Open - Apply before December 15th for Early Bird Discount
                            </a>
                            <a href="/events/tech-symposium-2024" class="news-item">
                                Annual Tech Symposium 2024 - Register now for Pakistan's largest technology conference
                            </a>
                            <a href="/news/scholarship-program" class="news-item">
                                Merit-based Scholarships Available - Up to 100% fee waiver for outstanding students
                            </a>
                            <a href="/news/industry-partnerships" class="news-item">
                                New Industry Partnerships with Leading Tech Companies - Enhanced Job Placement Program
                            </a>
                            <a href="/news/research-achievements" class="news-item">
                                HITEC Faculty Publishes Breakthrough Research in International Journal of Engineering
                            </a>
                            <a href="/news/campus-expansion" class="news-item">
                                State-of-the-art Laboratory Complex Inaugurated - Advanced Equipment for Hands-on Learning
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- News Marquee - End -->
    <div class="header-top_wrap">
        <div class="container">
            <div class="header-top ul_li_between">

                <div class="xb-info">
                    <ul class="ul_li align-items-end hitec-topmenu">
                        @Html.Action("GetMiddleMenu", "Menu")
                    </ul>
                </div>
                <div class="top-menu__actions">
                    <ul class="ul_li">
                        @Html.Action("GetTopMenu", "Menu")
                    </ul>
                </div>
            </div>
        </div>
    </div>

</header>

<div class="body-overlay"></div>
<!-- header search end -->