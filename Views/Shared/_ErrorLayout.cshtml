<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - HITEC University</title>

    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href="@Url.Content("~/Content/img/logo/favicon.ico")" />
    <link rel="apple-touch-icon" href="@Url.Content("~/Content/img/logo/HitecLogo.svg")" />

    <!-- Keep only a lightweight, direct stylesheet (no bundling) -->
    <link rel="stylesheet" href="@Url.Content("~/Content/css/fontawesome.css")" />
    
    <!-- Self-contained error page styles -->
    <style>
        :root { --brand:#004080; --muted:#6c757d; --danger:#c00000; --warn:#f3a712; --info:#3a86ff; }
        html, body { height: 100%; }
        body { margin:0; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Oxygen, Ubuntu, Cantarell, "Helvetica Neue", Arial, "Noto Sans", "Apple Color Emoji", "Segoe UI Emoji", "Segoe UI Symbol"; background:#fff; color:#222; }
        .error-header { display:flex; justify-content:center; align-items:center; padding:24px 12px; border-bottom:1px solid #eee; }
        .error-header img { height:64px; }
        .container { width:100%; max-width:960px; margin:0 auto; padding:0 16px; }
        .error-container { min-height: calc(100vh - 64px - 80px); display:flex; flex-direction:column; align-items:center; justify-content:center; text-align:center; padding:32px 16px; }
        .error-icon { font-size:72px; margin-bottom:16px; color: var(--danger); }
        .error-title { font-size:36px; font-weight:700; margin:8px 0; color:#343a40; }
        .error-subtitle { font-size:20px; margin:8px 0 16px; color: var(--muted); }
        .error-message { margin:8px 0 16px; max-width:640px; line-height:1.6; color:#444; }
        .error-actions { margin-top:16px; }
        .error-code { position: absolute; right:16px; top:16px; font-size:13px; color: var(--muted); opacity:.7; }
        .construction-icon { color: var(--warn); }
        .debugging-icon { color: var(--info); }
        .btn { display:inline-block; text-decoration:none; border:0; border-radius:6px; padding:12px 20px; font-weight:600; cursor:pointer; }
        .btn-primary { background:#0d6efd; color:#fff; }
        .btn-primary:hover { background:#0b5ed7; color:#fff; }
        footer { border-top:1px solid #eee; margin-top:24px; }
        footer .container { text-align:center; padding:16px; color: var(--muted); font-size:14px; }
        @media (max-width: 768px) {
            .error-title { font-size: 28px; }
            .error-subtitle { font-size: 18px; }
            .error-icon { font-size: 56px; }
        }
    </style>
</head>
<body>
    <header class="error-header">
        <div class="container">
            <div class="text-center">
                <a href="@Url.Action("Index", "Home")">
                    <img src="@Url.Content("~/Content/img/logo/HitecLogo.svg")" alt="HITEC University Logo" />
                </a>
            </div>
        </div>
    </header>
    
    <main>
        <div class="container">
            @RenderBody()
        </div>
    </main>
    
    <footer>
        <div class="container">
            <p>&copy; @DateTime.Now.Year - HITEC University. All Rights Reserved.</p>
        </div>
    </footer>
</body>
</html>