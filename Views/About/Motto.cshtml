@model Website.Models.tblAbout
@{
    ViewBag.Title = "Motto";
}
<section class="about pt-80 pb-80">
    <div class="container">
        <div class="row align-items-center mt-none-30">
            <div class="col-xl-8 col-lg-10 mx-auto mt-30">
                <div class="about-content text-center">
                    <div class="section-title mb-40">
                        <span class="sub-title">Motto</span>
                        <h2 class="title">Our Motto</h2>
                    </div>
                    <div class="about-message" style="font-size:1.15rem; color:#444; line-height:1.8; text-align: center;">
                        @if (!string.IsNullOrEmpty(Model.motto))
                        {
                            <p>@Html.Raw(Model.motto.Replace("\n", "<br />"))</p>
                        }
                        else
                        {
                            <p>Motto is not available at the moment.</p>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</section> 