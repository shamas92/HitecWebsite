<body>
    <div class="body_wrap">

        <!-- main area start  -->
        <main aria-labelledby="title">

            <!-- breadcrumb start -->
            <section class="breadcrumb bg_img ul_li" data-background="/Content/img/bg/about_bg.jpg">
                <div class="container">
                    <div class="breadcrumb__content text-center">
                        <h2 class="breadcrumb__title">About us</h2>
                    </div>
                </div>
            </section>
            <!-- breadcrumb end -->
            <!-- about start -->
            <section class="about pt-80 pb-120">
                <div class="container">
                    <div class="about-info-inner ul_li_between mt-none-30">
                        <div class="about-info mt-30">
                            <h3>LOCATION</h3>
                            <p>Taxila Cantonment, Punjab, Pakistan</p>
                        </div>
                        <div class="about-info mt-30">
                            <h3>FOUNDED</h3>
                            <p>Established: 2007 <br />(Charter Granted: November 17, 2009)</p>
                        </div>
                        <div class="about-info mt-30">
                            <h3>CAMPUS</h3>
                            <p>Urban, spread over approximately 20 acres, <br /> located at the foothills of Margalla Hills near the ancient city of Taxila.</p>
                        </div>
                    </div>
                    <div class="about-content mt-60">
                        As a private sector university, HITEC University is committed to providing quality education, particularly in the fields of Engineering, Computer Science, and Management Sciences. The university offers undergraduate, postgraduate, and doctorate programs. It is recognized by the Higher Education Commission (HEC) of Pakistan and its engineering programs are accredited by the Pakistan Engineering Council (PEC). It operates with the motto, "In Truth I Triumph."
                    </div>
                    <div class="xb-video pos-rel mt-115">
                        <img src="~/Content/img/about/thumbnail.jpg" alt="">
                        <a class="btn-video btn-video-center popup-video" href="https://www.youtube.com/watch?v=pNOj9a3hOSg"><i class="fas fa-play"></i></a>
                    </div>
                </div>
            </section>
            <!-- about end -->
            <!-- mission vision start -->
            <section class="mission-vission z-1 pos-rel pt-110">
                <div class="mission-vission-bg" data-background="/Content/img/bg/vm_bg.jpg"></div>
                <div class="container">
                    <div class="row justify-content-center">
                        <div class="col-lg-8">
                            <div class="section-title text-center mb-65">
                                <h2 class="title mb-15">our mission and vision</h2>
                                <p>EduFord University's mission & vision is to empower students with a transformative education that fosters academic excellence, innovation, and social responsibility. We aim to create an inclusive environment where students develop critical thinking and prepare for impactful societal roles.</p>
                            </div>
                        </div>
                    </div>
                    <div class="row mt-none-30">
                        <div class="col-lg-6 mt-30">
                            <div class="mission-vission-item">
                                <h3 class="xb-item--title">Our Mission</h3>
                                <p class="xb-item--content">EduFord University empowers students through transformative education, promoting excellence, innovation, and societal impact.</p>
                                <h4 class="xb-item--subtitle">With HITEC, you can:</h4>
                                <ul class="xb-item--list list-unstyled">
                                    <li><span><img src="~/Content/img/icon/check.svg" alt=""></span>Connect with communities through service.</li>
                                    <li><span><img src="~/Content/img/icon/check.svg" alt=""></span>Advance through cutting-edge research.</li>
                                    <li><span><img src="~/Content/img/icon/check.svg" alt=""></span>Encourage continuous learning and adaptability.</li>
                                    <li><span><img src="~/Content/img/icon/check.svg" alt=""></span>Deliver a challenging education.</li>
                                    <li><span><img src="~/Content/img/icon/check.svg" alt=""></span>Support critical thinking and leadership.</li>
                                    <li><span><img src="~/Content/img/icon/check.svg" alt=""></span>Foster an inclusive, equitable environment.</li>
                                </ul>
                                <div class="xb-item--shape">
                                    <div class="shape shape--1">
                                        <img src="~/Content/img/shape/vm_shape1.png" alt="">
                                    </div>
                                    <div class="shape shape--2">
                                        <img src="~/Content/img/shape/vm_shape2.png" alt="">
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-6 mt-30">
                            <div class="mission-vission-item">
                                <h3 class="xb-item--title">Our Vision</h3>
                                <p class="xb-item--content">EduFord University's vision is to lead globally in education, driving innovation and preparing students for success in a dynamic.</p>
                                <h4 class="xb-item--subtitle">With HITEC, you can:</h4>
                                <ul class="xb-item--list list-unstyled">
                                    <li><span><img src="~/Content/img/icon/check.svg" alt=""></span>Lead in global education and research.</li>
                                    <li><span><img src="~/Content/img/icon/check.svg" alt=""></span>Embrace new teaching methods.</li>
                                    <li><span><img src="~/Content/img/icon/check.svg" alt=""></span>Champion sustainability efforts.</li>
                                    <li><span><img src="~/Content/img/icon/check.svg" alt=""></span>Prepare students for a diverse world.</li>
                                    <li><span><img src="~/Content/img/icon/check.svg" alt=""></span>Build strong collaborations.</li>
                                    <li><span><img src="~/Content/img/icon/check.svg" alt=""></span>Equip students for a changing world.</li>
                                </ul>
                                <div class="xb-item--shape">
                                    <div class="shape shape--1">
                                        <img src="~/Content/img/shape/vm_shape1.png" alt="">
                                    </div>
                                    <div class="shape shape--2">
                                        <img src="~/Content/img/shape/vm_shape2.png" alt="">
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
