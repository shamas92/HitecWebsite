@model List<Website.Models.tblFacilite>
@{
    ViewBag.Title = "Facilities";
    var department = ViewBag.Department as Website.Models.tblDepartment;
    var departmentCode = ViewBag.DepartmentCode as string;

    // SEO Meta Tags
    ViewBag.MetaDescription = department != null
        ? $"Explore the state-of-the-art facilities and infrastructure of the {department.Title} department at HITEC University. Our modern labs and equipment support excellence in education and research."
        : "Explore the state-of-the-art facilities and infrastructure at HITEC University. Our modern labs and equipment support excellence in education and research.";
    ViewBag.MetaKeywords = department != null
        ? $"{department.Title}, facilities, laboratories, infrastructure, equipment, HITEC University, {department.Code}"
        : "facilities, laboratories, infrastructure, equipment, HITEC University";
}

@section Styles {
    <link href="~/Content/css/faculty-components.css" rel="stylesheet" />
    <link href="~/Content/css/faculty-sidebar.css" rel="stylesheet" />
    <style>
        .facility-card { background: var(--color-white); border-radius: 15px; box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08); overflow: hidden; transition: all 0.3s ease; margin-bottom: 30px; }
        .facility-card:hover { transform: translateY(-5px); box-shadow: 0 20px 40px rgba(0, 0, 0, 0.12); }
        .facility-image { width: 100%; height: 250px; overflow: hidden; position: relative; }
        .facility-image img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.3s ease; }
        .facility-card:hover .facility-image img { transform: scale(1.05); }
        .facility-image-placeholder { display: flex; align-items: center; justify-content: center; width: 100%; height: 100%; background: linear-gradient(135deg, var(--color-sec-bg) 0%, #e8e8e0 100%); color: var(--color-gray); font-size: 48px; }
        .facility-content { padding: 25px; }
        .facility-title { font-family: var(--font-heading); font-size: 22px; font-weight: 600; color: var(--color-heading); margin-bottom: 15px; line-height: 1.3; }
        .facility-info { color: var(--color-default); line-height: 1.6; font-size: 15px; }
        .facility-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(350px, 1fr)); gap: 30px; margin-top: 40px; }
        media (max-width: 768px) { .facility-grid { grid-template-columns: 1fr; gap: 20px; } .facility-image { height: 200px; } .facility-content { padding: 20px; } .facility-title { font-size: 20px; } }
    </style>
}

@section Meta {
    <meta name="description" content="@ViewBag.MetaDescription" />
    <meta name="keywords" content="@ViewBag.MetaKeywords" />
    <meta property="og:title" content="@ViewBag.Title - HITEC University" />
    <meta property="og:description" content="@ViewBag.MetaDescription" />
    <meta property="og:type" content="website" />
}

<body>
    <div class="body_wrap">
        <!-- main area start  -->
        <main aria-labelledby="title">
            <!-- breadcrumb start -->
            <section class="breadcrumb bg_img ul_li" style="padding: 0; min-height: 0;" data-background="/Content/img/bg/about_bg.jpg">
                <div class="container">
                    <div class="breadcrumb__content text-center">
                        <h1 class="breadcrumb__title mt-25" style="color: #000">
                            @(department != null ? $"Facilities - {department.Title}" : "Facilities")
                        </h1>
                        <p class="breadcrumb__desc mb-50" style="color: #000">
                            @(department != null ? $"{department.Code} Department Infrastructure" : "Our Infrastructure")
                        </p>
                    </div>
                </div>
            </section>
            <!-- breadcrumb end -->

            <!-- facilities start -->
            <section class="about pb-120">
                <div class="container">
                    <div class="faculty-page-layout">
                        <div class="faculty-page-content">
                            <div class="about-content mt-60">
                                <div class="section-title mb-40">
                                    <span class="sub-title">Infrastructure</span>
                                    <h2 class="title">@(department != null ? $"{department.Title} Facilities" : "Department Facilities")</h2>
                                </div>

                                @if (department != null)
                                {
                                    <p>The @department.Title department is equipped with state-of-the-art facilities to support teaching, learning, and research activities. We provide students with access to modern laboratories, computer labs, and specialized equipment tailored to @department.Title education.</p>
                                }
                                else
                                {
                                    <p>Our departments are equipped with state-of-the-art facilities to support teaching, learning, and research activities. We provide students with access to modern laboratories, computer labs, and specialized equipment.</p>
                                }

                                <p>Our facilities include well-equipped classrooms, research laboratories, computer centers, and collaborative spaces. We maintain partnerships with industry to ensure our facilities reflect current workplace environments and provide students with hands-on experience using the latest technology.</p>

                                @if (Model != null && Model.Any())
                                {
                                    <!-- Facilities Statistics -->
                                    <div class="faculty-stats">
                                        <div class="faculty-stat">
                                            <span class="faculty-stat-number">@Model.Count</span>
                                            <span class="faculty-stat-label">Facilities</span>
                                        </div>
                                        <div class="faculty-stat">
                                            <span class="faculty-stat-number">@Model.Count(f => !string.IsNullOrEmpty(f.Banner))</span>
                                            <span class="faculty-stat-label">With Images</span>
                                        </div>
                                        <div class="faculty-stat">
                                            <span class="faculty-stat-number">@DateTime.Now.Year</span>
                                            <span class="faculty-stat-label">Latest Updates</span>
                                        </div>
                                    </div>

                                    <!-- Facilities Grid -->
                                    <div class="facility-grid">
                                        @foreach (var facility in Model)
                                        {
                                            <div class="facility-card" id="facility-@facility.FacilityID">
                                                <div class="facility-image">
                                                    @{
                                                        var img = facility.Banner; // expected file name/path
                                                        string resolved = null;
                                                        if (!string.IsNullOrWhiteSpace(img))
                                                        {
                                                            // If it's an absolute or rooted URL, use as is; otherwise try default uploads folder
                                                            bool absolute = img.StartsWith("http://", StringComparison.OrdinalIgnoreCase) || img.StartsWith("https://", StringComparison.OrdinalIgnoreCase);
                                                            bool rooted = img.StartsWith("/") || img.StartsWith("~/");
                                                            resolved = absolute ? img : Url.Content(rooted ? img : ("~/Content/uploads/facilities/" + img));
                                                        }
                                                    }
                                                    @if (!string.IsNullOrEmpty(resolved))
                                                    {
                                                        <img src="@resolved" alt="@facility.Title" onerror="this.parentElement.innerHTML='\x3cdiv class=\'facility-image-placeholder\'\x3e\x3ci class=\'fas fa-building\'\x3e\x3c/i\x3e\x3c/div\x3e'" />
                                                    }
                                                    else
                                                    {
                                                        <div class="facility-image-placeholder">
                                                            <i class="fas fa-building"></i>
                                                        </div>
                                                    }
                                                </div>

                                                <div class="facility-content">
                                                    <h3 class="facility-title">@(string.IsNullOrWhiteSpace(facility.Title) ? "Facility" : facility.Title)</h3>

                                                    @if (!string.IsNullOrEmpty(facility.Details))
                                                    {
                                                        <div class="facility-info">
                                                            @Html.Raw(facility.Details)
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <div class="facility-info">
                                                            <p>Facility information will be updated soon. Please contact the department for more details about this facility.</p>
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <div class="faculty-no-results">
                                        <h3>No Facilities Information Available</h3>
                                        @if (department != null)
                                        {
                                            <p>Facility information for the @department.Title department is currently being updated. Please check back later or contact the department directly for more information about available facilities.</p>
                                        }
                                        else
                                        {
                                            <p>Facility information is currently being updated. Please check back later for detailed information about our facilities and infrastructure.</p>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                        <div class="faculty-page-sidebar">
                            @Html.Partial("_FacultySidebar")
                        </div>
                    </div>
                </div>
            </section>
            <!-- facilities end -->

        </main>
        <!-- main area end  -->
    </div>
</body>