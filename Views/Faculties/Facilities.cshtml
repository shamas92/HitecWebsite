@model List<Website.Models.tblFacilite>
@using System.Text.RegularExpressions
@{
    ViewBag.Title = "Facilities";
    var department = ViewBag.Department as Website.Models.tblDepartment;
    var departmentCode = ViewBag.DepartmentCode as string;

    // SEO Meta Tags (ensure not null)
    ViewBag.MetaDescription = ViewBag.MetaDescription ?? (department != null
        ? $"Explore the state-of-the-art facilities and infrastructure of the {department.Title} department at HITEC University. Our modern labs and equipment support excellence in education and research."
        : "Explore the state-of-the-art facilities and infrastructure at HITEC University. Our modern labs and equipment support excellence in education and research.");
    ViewBag.MetaKeywords = ViewBag.MetaKeywords ?? (department != null
        ? $"{department.Title}, facilities, laboratories, infrastructure, equipment, HITEC University, {department.Code}"
        : "facilities, laboratories, infrastructure, equipment, HITEC University");

}

@functions {
    private string StripTags(string input)
    {
        if (string.IsNullOrWhiteSpace(input)) return string.Empty;
        return Regex.Replace(input, "<.*?>", string.Empty);
    }
    private string Truncate(string input, int length)
    {
        if (string.IsNullOrWhiteSpace(input)) return string.Empty;
        input = input.Trim();
        return input.Length <= length ? input : input.Substring(0, length).TrimEnd() + "...";
    }

    private string GetFacilityPhotoPath(string photoFileName)
    {
        // Default placeholder image
        var defaultImage = "~/Content/img/team/placeholder-1200x627.jpg";

        if (string.IsNullOrEmpty(photoFileName))
        {
            return Url.Content(defaultImage);
        }

        // Check if it's an absolute URL
        if (photoFileName.StartsWith("http://", StringComparison.OrdinalIgnoreCase) ||
photoFileName.StartsWith("https://", StringComparison.OrdinalIgnoreCase))
        {
            return photoFileName;
        }

        // Check if it's already a rooted path
        if (photoFileName.StartsWith("/") || photoFileName.StartsWith("~/"))
        {
            var serverPath = Server.MapPath(photoFileName);
            if (System.IO.File.Exists(serverPath))
            {
                return Url.Content(photoFileName);
            }
            return Url.Content(defaultImage);
        }

        // Construct the full server path to check if file exists
        var relativePath = $"~/Content/img/departments/Facility_Photo/{photoFileName}";
        var fullServerPath = Server.MapPath(relativePath);

        // Check if the file exists on the server
        if (System.IO.File.Exists(fullServerPath))
        {
            return Url.Content(relativePath);
        }

        // Return default image if file doesn't exist
        return Url.Content(defaultImage);
    }
}

@section Styles {
    <link href="~/Content/css/faculty.css" rel="stylesheet" />
}

@section Meta {
    <meta name="description" content="@ViewBag.MetaDescription" />
    <meta name="keywords" content="@ViewBag.MetaKeywords" />
    <meta property="og:title" content="@ViewBag.Title - HITEC University" />
    <meta property="og:description" content="@ViewBag.MetaDescription" />
    <meta property="og:type" content="website" />
}

<div class="body_wrap">
    <main aria-labelledby="title">
        <section class="breadcrumb bg_img ul_li" data-background="/Content/img/bg/about_bg.jpg">
            <div class="container">
                <div class="breadcrumb__content text-center">
                    <h1 class="breadcrumb__title mt-25" style="color: #000">
                        @(department != null ? $"Facilities - {department.Title}" : "Facilities")
                    </h1>
                    <p class="breadcrumb__desc mb-50" style="color: #000">
                        @(department != null ? $"{department.Code} Department Infrastructure" : "Our Infrastructure")
                    </p>
                </div>
            </div>
        </section>

        <section class="about pb-120">
            <div class="container">
                <div class="faculty-page-layout">
                    <div class="faculty-page-content">
                        <div class="faculty-hero">
                            <span class="subtitle">Infrastructure</span>
                            <h2>@(department != null ? $"{department.Title} Facilities" : "Department Facilities")</h2>
                            <div class="accent-line"></div>
                            <p>@(department != null ? $"The {department.Title} department is equipped with state-of-the-art facilities to support teaching, learning, and research activities." : "Our departments are equipped with state-of-the-art facilities to support teaching, learning, and research activities.")</p>
                        </div>

                        <div class="faculty-intro">
                            <p>Our facilities include well-equipped classrooms, research laboratories, computer centers, and collaborative spaces. We maintain partnerships with industry to ensure our facilities reflect current workplace environments and provide students with hands-on experience using the latest technology.</p>
                        </div>

                        @if (Model != null && Model.Any())
                        {
                            <div class="faculty-stats">
                                <div class="faculty-stat">
                                    <span class="faculty-stat-number">@Model.Count</span>
                                    <span class="faculty-stat-label">Facilities</span>
                                </div>
                                <div class="faculty-stat">
                                    <span class="faculty-stat-number">@Model.Count(f => !string.IsNullOrEmpty(f.Banner))</span>
                                    <span class="faculty-stat-label">With Images</span>
                                </div>
                                <div class="faculty-stat">
                                    <span class="faculty-stat-number">@DateTime.Now.Year</span>
                                    <span class="faculty-stat-label">Latest Updates</span>
                                </div>
                            </div>

                            <div class="facility-grid">


                                @foreach (var facility in Model)
                                {
                                    var photos = (facility.tblFacilityPhotos ?? new List<Website.Models.tblFacilityPhoto>()).ToList();

                                    // Determine the image to display
                                    string imageToDisplay = null;

                                    // First priority: facility Banner
                                    if (!string.IsNullOrEmpty(facility.Banner))
                                    {
                                        imageToDisplay = facility.Banner;
                                    }
                                    // Second priority: first photo from tblFacilityPhotos
                                    else if (photos.Count > 0 && !string.IsNullOrWhiteSpace(photos.First().Photo))
                                    {
                                        imageToDisplay = photos.First().Photo;
                                    }

                                    // Get the validated image path
                                    var imagePath = GetFacilityPhotoPath(imageToDisplay);


                                    var plain = StripTags(facility.Details);
                                    var excerpt = Truncate(plain, 180);
                                    var detailsUrl = Url.Action("FacilityDetails", "Faculties", new { id = facility.FacilityID });

                                    <div class="success-story-card facility-card-item" id="facility-@facility.FacilityID">
                                        <div class="story-image facility-image">
                                            <img src="@imagePath"
                                                 alt="@facility.Title"
                                                 onerror="this.onerror=null; this.src='@Url.Content("~/Content/img/team/placeholder-1200x627.jpg")';" />
                                        </div>
                                        <div class="story-content">
                                            <h3 class="story-name">
                                                <a href="@detailsUrl" class="facility-title-link" target="_blank">
                                                    @(string.IsNullOrWhiteSpace(facility.Title) ? "Facility" : facility.Title)
                                                </a>
                                            </h3>
                                            @if (!string.IsNullOrWhiteSpace(excerpt))
                                            {
                                                <div class="facility-info">
                                                    @excerpt
                                                </div>
                                            }
                                        </div>

                                        <div class="story-card-footer">
                                            <a class="story-details-btn" href="@detailsUrl" target="_blank">
                                                <i class="fas fa-info-circle"></i> Details
                                            </a>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="faculty-enhanced-card">
                                <div class="faculty-card-header">
                                    <div class="faculty-badge"><i class="fas fa-info-circle"></i></div>
                                    <h3 class="faculty-card-title">No Facilities Information Available</h3>
                                </div>
                                <div class="faculty-card-content">
                                    <p>Facility information is currently being updated. Please check back later.</p>
                                </div>
                            </div>
                        }
                    </div>
                    <div class="faculty-page-sidebar">
                        @Html.Partial("_FacultySidebar")
                    </div>
                </div>
            </div>
        </section>
    </main>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            setTimeout(function () { var $pre = $('#preloader'); if ($pre.length) { $pre.fadeOut('slow', function () { $(this).remove(); }); } }, 500);
            $('.facility-card-item').each(function (i) { $(this).css('opacity', '0').delay(100 * i).animate({ opacity: 1 }, 500); });
        });
    </script>
}