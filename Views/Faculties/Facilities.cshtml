@{
    ViewBag.Title = "Facilities";
}

@section Styles {
    <link rel="stylesheet" href="@Url.Content("~/Content/css/image-crop.css")" />
}

<!-- backtotop - start -->
<!-- backtotop - end -->

<body>
    <div class="body_wrap">

        <!-- main area start  -->
        <main aria-labelledby="title">

            <!-- breadcrumb start -->
            <section class="breadcrumb bg_img ul_li" style="padding: 0; min-height: 0;" data-background="/Content/img/bg/about_bg.jpg">
                <div class="container">
                    <div class="breadcrumb__content text-center">
                        <h2 class="breadcrumb__title mt-25" style="color: #000">Facilities</h2>
                        <p class="breadcrumb__desc mb-50" style="color: #000">Our Infrastructure</p>
                    </div>
                </div>
            </section>
            <!-- breadcrumb end -->

            <!-- facilities start -->
            <section class="about pb-120">
                <div class="container">
                    <div class="faculty-page-layout">
                        <div class="faculty-page-content">
                            <div class="about-content mt-60">
                                <div class="section-title mb-60">
                                    <span class="sub-title">Infrastructure</span>
                                    <h2 class="title">Department Facilities</h2>
                                </div>
                                <p>Our department is equipped with state-of-the-art facilities to support teaching, learning, and research activities. We provide students with access to modern laboratories, computer labs, and specialized equipment.</p>
                                <p>Our facilities include well-equipped classrooms, research laboratories, computer centers, and collaborative spaces. We maintain partnerships with industry to ensure our facilities reflect current workplace environments.</p>
                                <p>We continuously invest in upgrading our facilities to provide students with the best possible learning environment. Our infrastructure supports both theoretical learning and practical application of knowledge.</p>
                                
                                <!-- Image Upload Section -->
                                <div class="section-title mt-60 mb-40">
                                    <span class="sub-title">Gallery</span>
                                    <h3 class="title">Upload Facility Images</h3>
                                </div>
                                
                                <div id="image-crop-container" class="image-crop-container">
                                    <!-- File Upload Section -->
                                    <div class="crop-upload-section">
                                        <div class="file-input-wrapper">
                                            <input type="file" id="facility-image-input" accept="image/*" />
                                            <label for="facility-image-input" class="file-input-label">
                                                <div>
                                                    <div class="file-input-icon">??</div>
                                                    <div class="file-input-text">
                                                        <strong>Click to select an image</strong> or drag and drop here
                                                        <br><small>Supports: JPG, PNG, GIF (Max 5MB)</small>
                                                    </div>
                                                </div>
                                            </label>
                                        </div>
                                    </div>

                                    <!-- Crop Area -->
                                    <div class="crop-area">
                                        <div class="crop-container">
                                            <!-- Image Preview -->
                                            <div class="crop-preview-container">
                                                <!-- Image and crop overlay will be inserted here -->
                                            </div>

                                            <!-- Crop Controls -->
                                            <div class="crop-controls">
                                                <h4>Crop Settings</h4>
                                                
                                                <!-- Crop Rectangle -->
                                                <div class="crop-section">
                                                    <h5>Crop Rectangle</h5>
                                                    <div class="crop-input-group">
                                                        <div>
                                                            <label>Width</label>
                                                            <input type="number" id="crop-width" class="crop-input" min="1" value="400" />
                                                        </div>
                                                        <div>
                                                            <label>Height</label>
                                                            <input type="number" id="crop-height" class="crop-input" min="1" value="300" />
                                                        </div>
                                                    </div>
                                                </div>

                                                <!-- Aspect Ratio -->
                                                <div class="crop-section">
                                                    <h5>Aspect Ratio</h5>
                                                    <select id="aspect-ratio" class="aspect-ratio-select">
                                                        <option value="freeform">Free Form</option>
                                                        <option value="1:1">Square (1:1)</option>
                                                        <option value="4:3">Standard (4:3)</option>
                                                        <option value="16:9">Widescreen (16:9)</option>
                                                        <option value="3:2">Photo (3:2)</option>
                                                    </select>
                                                </div>

                                                <!-- Crop Position -->
                                                <div class="crop-section">
                                                    <h5>Crop Position</h5>
                                                    <div class="crop-input-group">
                                                        <div>
                                                            <label>Position (X)</label>
                                                            <input type="number" id="crop-pos-x" class="crop-input" min="0" value="0" />
                                                        </div>
                                                        <div>
                                                            <label>Position (Y)</label>
                                                            <input type="number" id="crop-pos-y" class="crop-input" min="0" value="0" />
                                                        </div>
                                                    </div>
                                                </div>

                                                <!-- Action Buttons -->
                                                <div class="crop-buttons">
                                                    <button type="button" id="crop-btn" class="btn-crop btn-primary">
                                                        Crop ?
                                                    </button>
                                                    <button type="button" id="reset-btn" class="btn-crop btn-secondary">
                                                        Reset
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Cropped Result -->
                                    <div class="cropped-result">
                                        <h4>Cropped Image Preview</h4>
                                        <img class="cropped-preview" alt="Cropped preview" />
                                        <br>
                                        <button type="button" class="upload-final-btn">
                                            Upload Image
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="faculty-page-sidebar">
                            @Html.Partial("_FacultySidebar")
                        </div>
                    </div>
                </div>
            </section>
            <!-- facilities end -->

        </main>
        <!-- main area end  -->

    </div>

    @section Scripts {
        <script src="@Url.Content("~/Scripts/image-crop.js")"></script>
    }

</body>