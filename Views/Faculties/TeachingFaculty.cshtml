@{
    ViewBag.Title = "Teaching Faculty";
}

<!-- backtotop - start -->
<!-- backtotop - end -->

<body>
    <div class="body_wrap">

        <!-- main area start  -->
        <main aria-labelledby="title">

            <!-- breadcrumb start -->
            <section class="breadcrumb bg_img ul_li" style="padding: 0; min-height: 0;" data-background="/Content/img/bg/about_bg.jpg">
                <div class="container">
                    <div class="breadcrumb__content text-center">
                        <h2 class="breadcrumb__title mt-25" style="color: #000">Teaching Faculty</h2>
                        <p class="breadcrumb__desc mb-50" style="color: #000">Our Academic Team</p>
                    </div>
                </div>
            </section>
            <!-- breadcrumb end -->

            <!-- teaching faculty start -->
            <section class="about pb-120">
                <div class="container">
                    <div class="faculty-page-layout">
                        <div class="faculty-page-content">
                            <div class="about-content mt-60">
                                <div class="section-title mb-60">
                                    <span class="sub-title">Faculty</span>
                                    <h2 class="title">Teaching Faculty</h2>
                                </div>
                                <p>Our department is proud to have a distinguished team of faculty members who are experts in their respective fields. Our teaching faculty brings together years of academic and industry experience to provide students with comprehensive education and mentorship.</p>
                                <p>Each faculty member is committed to excellence in teaching, research, and community service. They actively engage in cutting-edge research and maintain strong connections with industry partners to ensure our curriculum remains relevant and up-to-date.</p>
                                <p>Our faculty members are not only educators but also mentors who guide students in their academic and professional development. They are dedicated to fostering a supportive learning environment where students can thrive and achieve their goals.</p>
                            </div>
                        </div>
                        <div class="faculty-page-sidebar">
                            @Html.Partial("_FacultySidebar")
                        </div>
                    </div>
                </div>
            </section>
            <!-- teaching faculty end -->

        </main>
        <!-- main area end  -->

    </div>

</body> 