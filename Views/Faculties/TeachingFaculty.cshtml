@model List<Website.Models.tblFaculty>
@{
    ViewBag.Title = "Teaching Faculty";
    var department = ViewBag.Department as Website.Models.tblDepartment;
    var departmentCode = ViewBag.DepartmentCode as string;

    ViewBag.MetaDescription = department != null
        ? $"Meet the distinguished faculty members of the {department.Title} department at HITEC University. Our experienced educators are committed to excellence in teaching and research."
        : "Meet the distinguished faculty members at HITEC University. Our experienced educators are committed to excellence in teaching and research.";
    ViewBag.MetaKeywords = department != null
        ? $"{department.Title}, faculty, teaching staff, professors, HITEC University, {department.Code}"
        : "faculty, teaching staff, professors, HITEC University, academic staff";

    // Group faculty by designation/rank for organized display
    var facultyByRank = Model?.GroupBy(f => f.tblDesignation?.Designation ?? f.AdDesignation ?? "Instructor")
                              .OrderByDescending(g => GetRankOrder(g.Key))
                              .ToList();
}

@functions {
    private int GetRankOrder(string designation)
    {
        if (string.IsNullOrEmpty(designation)) return 0;
        var lower = designation.ToLower();
        if (lower.Contains("professor") && !lower.Contains("assistant") && !lower.Contains("associate")) return 100;
        if (lower.Contains("associate professor")) return 90;
        if (lower.Contains("assistant professor")) return 80;
        if (lower.Contains("lecturer")) return 70;
        if (lower.Contains("instructor")) return 60;
        return 50;
    }
}

@section Styles {
    <link href="~/Content/css/faculty.css" rel="stylesheet" />
    <style>
        .faculty-search-box{flex:1;min-width:250px}
        .faculty-search-box input{width:100%;padding:12px 18px;border:2px solid #e0e0e0;border-radius:30px;font-size:15px;transition:all .3s ease}
        .faculty-search-box input:focus{outline:none;border-color:#002155;box-shadow:0 0 0 3px rgba(0,33,85,.1)}
        .faculty-filter-buttons{display:flex;gap:10px;flex-wrap:wrap}
        .faculty-filter-btn{padding:10px 20px;border:2px solid #002155;background:#fff;color:#002155;border-radius:30px;font-size:14px;font-weight:700;cursor:pointer;transition:all .3s ease;text-transform:uppercase;letter-spacing:.5px}
        .faculty-filter-btn:hover,.faculty-filter-btn.active{background:#002155;color:#fff}
        .rank-section{margin-bottom:50px}
        .rank-header{background:linear-gradient(135deg,#002155 0%,#001a44 100%);color:#fff;padding:20px 28px;border-radius:12px;margin-bottom:30px;display:flex;align-items:center;gap:18px;box-shadow:0 5px 20px rgba(0,33,85,.15)}
        .rank-badge{width:60px;height:60px;border-radius:50%;background:#fdb714;color:#002155;display:flex;align-items:center;justify-content:center;font-weight:800;font-size:24px;flex-shrink:0;box-shadow:0 4px 15px rgba(0,0,0,.2)}
        .rank-title{font-family:'Playfair Display',serif;font-size:28px;font-weight:700;margin:0;color:#fff!important;flex:1}
        .faculty-card-modern{background:#fff;border-radius:16px;box-shadow:0 5px 25px rgba(0,33,85,.1);overflow:hidden;transition:all .3s ease;border:1px solid rgba(0,33,85,.08);display:flex;flex-direction:column;height:100%}
        .faculty-card-modern:hover{box-shadow:0 12px 40px rgba(0,33,85,.18);transform:translateY(-5px)}
        .faculty-photo-modern{width:100%;height:280px;overflow:hidden;position:relative;background:linear-gradient(135deg,#f0f0f0 0%,#e0e0e0 100%)}
        .faculty-photo-modern img{width:100%;height:100%;object-fit:cover;transition:transform .3s ease}
        .faculty-card-modern:hover .faculty-photo-modern img{transform:scale(1.05)}
        .faculty-info-modern{padding:24px;flex:1;display:flex;flex-direction:column}
        .faculty-name-modern{font-family:'Playfair Display',serif;font-size:22px;font-weight:700;color:#002155;margin-bottom:8px;line-height:1.3}
        .faculty-designation-modern{display:inline-flex;align-items:center;gap:8px;background:linear-gradient(135deg,#002155 0%,#001a44 100%);color:#fff;padding:6px 14px;border-radius:20px;font-size:13px;font-weight:700;margin-bottom:12px;width:fit-content;text-transform:uppercase;letter-spacing:.5px}
        .faculty-meta-modern{display:flex;flex-direction:column;gap:10px;margin-top:auto;padding-top:16px;border-top:1px solid #f0f0f0}
        .faculty-meta-item-modern{display:flex;align-items:flex-start;gap:10px;font-size:14px;color:#5c5c54}
        .faculty-meta-item-modern i{color:#fdb714;font-size:16px;margin-top:2px;flex-shrink:0}
        .faculty-meta-item-modern a{color:#002155;text-decoration:none;transition:color .3s ease}
        .faculty-meta-item-modern a:hover{color:#fdb714}
        .faculty-research-modern{background:#f7f9fc;padding:12px;border-radius:8px;font-size:13px;color:#5c5c54;line-height:1.6;margin-top:10px}
        .faculty-research-modern strong{color:#002155;display:block;margin-bottom:4px;font-size:14px}
    </style>
}

@section Meta {
    <meta name="description" content="@ViewBag.MetaDescription" />
    <meta name="keywords" content="@ViewBag.MetaKeywords" />
    <meta property="og:title" content="@ViewBag.Title - HITEC University" />
    <meta property="og:description" content="@ViewBag.MetaDescription" />
    <meta property="og:type" content="website" />
}

<div class="body_wrap">
    <main aria-labelledby="title">
        <section class="breadcrumb bg_img ul_li" style="padding:0;min-height:0;" data-background="/Content/img/bg/about_bg.jpg">
            <div class="container">
                <div class="breadcrumb__content text-center">
                    <h1 class="breadcrumb__title mt-25" style="color:#000">
                        @(department != null ? $"Teaching Faculty - {department.Title}" : "Teaching Faculty")
                    </h1>
                    <p class="breadcrumb__desc mb-50" style="color:#000">
                        @(department != null ? $"{department.Code} Department Academic Team" : "Our Academic Team")
                    </p>
                </div>
            </div>
        </section>

        <section class="about pb-120">
            <div class="container">
                <div class="faculty-page-layout">
                    <div class="faculty-page-content">
                        <div class="faculty-hero">
                            <span class="subtitle">Our Expert Team</span>
                            <h2>@(department != null ? $"{department.Title} Teaching Faculty" : "Teaching Faculty")</h2>
                            <div class="accent-line"></div>
                            <p>@(department != null ? $"Meet our distinguished faculty members in the {department.Title} department. Our educators are committed to academic excellence and student success." : "Meet our distinguished faculty members committed to academic excellence and student success.")</p>
                        </div>

                        @if (Model != null && Model.Any())
                        {
                            <div class="faculty-stats">
                                <div class="faculty-stat">
                                    <span class="faculty-stat-number">@Model.Count</span>
                                    <span class="faculty-stat-label">Faculty Members</span>
                                </div>
                                <div class="faculty-stat">
                                    <span class="faculty-stat-number">@facultyByRank.Count</span>
                                    <span class="faculty-stat-label">Academic Ranks</span>
                                </div>
                                <div class="faculty-stat">
                                    <span class="faculty-stat-number">@Model.Count(f => !string.IsNullOrEmpty(f.ResearchInterests))</span>
                                    <span class="faculty-stat-label">With Research</span>
                                </div>
                            </div>

                            

                            foreach (var rankGroup in facultyByRank)
                            {
                                <div class="rank-section" data-rank="@rankGroup.Key.ToLower()">
                                    <div class="rank-header">
                                        <div class="rank-badge">@rankGroup.Count()</div>
                                        <h3 class="rank-title">@rankGroup.Key</h3>
                                    </div>
                                    <div class="row">
                                        @foreach (var faculty in rankGroup.OrderBy(f => f.OrderNo).ThenBy(f => f.FullName))
                                        {
                                            <div class="col-lg-4 col-md-6 mb-30 faculty-card-wrapper"
                                                 data-name="@(faculty.FullName ?? "").ToLower()"
                                                 data-qualification="@(faculty.Qualification ?? "").ToLower()"
                                                 data-research="@(faculty.ResearchInterests ?? "").ToLower()"
                                                 data-designation="@(faculty.tblDesignation?.Designation ?? faculty.AdDesignation ?? "").ToLower()">
                                                <div class="faculty-card-modern">
                                                    <div class="faculty-photo-modern">
                                                        @if (!string.IsNullOrEmpty(faculty.Photo))
                                                        {
                                                            <img src="@Url.Content("~/Content/uploads/faculty/" + faculty.Photo)" alt="@faculty.FullName" onerror="this.src='@Url.Content("~/Content/img/team/team_01.jpg")'" />
                                                        }
                                                        else
                                                        {
                                                            <img src="@Url.Content("~/Content/img/team/team_01.jpg")" alt="@faculty.FullName" />
                                                        }
                                                    </div>
                                                    <div class="faculty-info-modern">
                                                        <h4 class="faculty-name-modern">@(faculty.FullName ?? "Faculty Member")</h4>
                                                        <span class="faculty-designation-modern">
                                                            @(faculty.tblDesignation?.Designation ?? faculty.AdDesignation ?? "Instructor")
                                                        </span>
                                                        @if (!string.IsNullOrEmpty(faculty.Qualification))
                                                        {
                                                            <div class="faculty-meta-modern">
                                                                <div class="faculty-meta-item-modern">
                                                                    <i class="fas fa-graduation-cap"></i>
                                                                    <span>@faculty.Qualification</span>
                                                                </div>
                                                            </div>
                                                        }
                                                        @if (!string.IsNullOrEmpty(faculty.Email))
                                                        {
                                                            <div class="faculty-meta-modern">
                                                                <div class="faculty-meta-item-modern">
                                                                    <i class="fas fa-envelope"></i>
                                                                    <a href="mailto:@faculty.Email">@faculty.Email</a>
                                                                </div>
                                                            </div>
                                                        }
                                                        @if (!string.IsNullOrEmpty(faculty.ResearchInterests))
                                                        {
                                                            <div class="faculty-research-modern">
                                                                <strong>Research Interests</strong>
                                                                @faculty.ResearchInterests
                                                            </div>
                                                        }
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="faculty-enhanced-card">
                                <div class="faculty-card-header">
                                    <div class="faculty-badge"><i class="fas fa-info-circle"></i></div>
                                    <h3 class="faculty-card-title">No Faculty Members Found</h3>
                                </div>
                                <div class="faculty-card-content">
                                    <p>@(department != null ? $"There are currently no faculty members listed for the {department.Title} department." : "There are currently no faculty members listed.") Please check back later.</p>
                                </div>
                            </div>
                        }
                    </div>

                    <div class="faculty-page-sidebar">
                        @Html.Partial("_FacultySidebar")
                    </div>
                </div>
            </div>
        </section>
    </main>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            setTimeout(function(){ var $pre = $('#preloader'); if ($pre.length) { $pre.fadeOut('slow', function(){ $(this).remove(); }); } }, 500);

            $('#facultySearch').on('keyup', function() { filterFaculty(); });
            $('.faculty-filter-btn').on('click', function() {
                $('.faculty-filter-btn').removeClass('active');
                $(this).addClass('active');
                filterFaculty();
            });

            function filterFaculty() {
                var searchTerm = $('#facultySearch').val().toLowerCase().trim();
                var activeFilter = $('.faculty-filter-btn.active').data('filter');
                var visibleCount = 0;

                $('.faculty-card-wrapper').each(function() {
                    var $card = $(this);
                    var name = ($card.data('name') || '').toString();
                    var qualification = ($card.data('qualification') || '').toString();
                    var research = ($card.data('research') || '').toString();
                    var designation = ($card.data('designation') || '').toString();

                    // Search filter - check if search term is in any field
                    var matchesSearch = searchTerm === '' || 
                        name.indexOf(searchTerm) !== -1 || 
                        qualification.indexOf(searchTerm) !== -1 || 
                        research.indexOf(searchTerm) !== -1 || 
                        designation.indexOf(searchTerm) !== -1;

                    // Designation filter with more robust matching
                    var matchesFilter = activeFilter === 'all';
                    if (!matchesFilter) {
                        if (activeFilter === 'professor') {
                            // Match "Professor" but exclude "Assistant Professor" and "Associate Professor"
                            matchesFilter = designation.indexOf('professor') !== -1 && 
                                          designation.indexOf('assistant') === -1 && 
                                          designation.indexOf('associate') === -1;
                        } else if (activeFilter === 'associate') {
                            matchesFilter = designation.indexOf('associate') !== -1;
                        } else if (activeFilter === 'assistant') {
                            matchesFilter = designation.indexOf('assistant') !== -1;
                        }
                    }

                    if (matchesSearch && matchesFilter) {
                        $card.show();
                        visibleCount++;
                    } else {
                        $card.hide();
                    }
                });

                // Show/hide rank sections based on visible cards
                $('.rank-section').each(function() {
                    var $section = $(this);
                    var visibleInSection = $section.find('.faculty-card-wrapper:visible').length;
                    if (visibleInSection === 0) {
                        $section.hide();
                    } else {
                        $section.show();
                    }
                });

                // Update rank badges to show filtered count
                $('.rank-section:visible').each(function() {
                    var $section = $(this);
                    var visibleInSection = $section.find('.faculty-card-wrapper:visible').length;
                    $section.find('.rank-badge').text(visibleInSection);
                });
            }

            // Smooth animation for cards
            $('.faculty-card-wrapper').each(function(i) {
                $(this).css('opacity','0').delay(50 * i).animate({ opacity: 1 }, 400);
            });
        });
    </script>
}