@{
    ViewBag.Title = "Past Events";
}

<!-- backtotop - start -->
<!-- backtotop - end -->

<body>
    <div class="body_wrap">

        <!-- main area start  -->
        <main aria-labelledby="title">

            <!-- breadcrumb start -->
            <section class="breadcrumb bg_img ul_li" style="padding: 0; min-height: 0;" data-background="/Content/img/bg/about_bg.jpg">
                <div class="container">
                    <div class="breadcrumb__content text-center">
                        <h2 class="breadcrumb__title mt-25" style="color: #000">Past Events</h2>
                        <p class="breadcrumb__desc mb-50" style="color: #000">Previous Activities</p>
                    </div>
                </div>
            </section>
            <!-- breadcrumb end -->

            <!-- past events start -->
            <section class="about pb-120 ml-40">
                <div class="container">
                    <div class="faculty-page-layout">
                        <div class="faculty-page-content">
                            <div class="about-content mt-60">
                                <div class="section-title mb-60">
                                    <span class="sub-title">Activities</span>
                                    <h2 class="title">Past Events</h2>
                                </div>
                                <p>Our department has hosted numerous successful events, workshops, seminars, and conferences that have contributed to the academic and professional development of our students and faculty. These events provide valuable opportunities for learning, networking, and collaboration.</p>
                                <p>Past events include technical workshops, industry seminars, research presentations, career fairs, and cultural activities. These events bring together students, faculty, industry professionals, and alumni to share knowledge and experiences.</p>
                                <p>We maintain a rich archive of past events that showcases our department's commitment to academic excellence and community engagement. These events continue to inspire and inform our current activities and future planning.</p>
                            </div>
                        </div>
                        <div class="faculty-page-sidebar">
                            @Html.Partial("_FacultySidebar")
                        </div>
                    </div>
                </div>
            </section>
            <!-- past events end -->

        </main>
        <!-- main area end  -->

    </div>

</body> 