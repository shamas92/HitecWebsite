@{
    ViewBag.Title = "Success Stories";
}

<!-- backtotop - start -->
<!-- backtotop - end -->

<body>
    <div class="body_wrap">

        <!-- main area start  -->
        <main aria-labelledby="title">

            <!-- breadcrumb start -->
            <section class="breadcrumb bg_img ul_li" style="padding: 0; min-height: 0;" data-background="/Content/img/bg/about_bg.jpg">
                <div class="container">
                    <div class="breadcrumb__content text-center">
                        <h2 class="breadcrumb__title mt-25" style="color: #000">Success Stories</h2>
                        <p class="breadcrumb__desc mb-50" style="color: #000">Alumni Achievements</p>
                    </div>
                </div>
            </section>
            <!-- breadcrumb end -->

            <!-- success stories start -->
            <section class="about pb-120">
                <div class="container">
                    <div class="faculty-page-layout">
                        <div class="faculty-page-content">
                            <div class="about-content mt-60">
                                <div class="section-title mb-60">
                                    <span class="sub-title">Achievements</span>
                                    <h2 class="title">Success Stories</h2>
                                </div>
                                <p>Our department takes pride in the success stories of our alumni who have gone on to achieve remarkable accomplishments in their careers. These success stories serve as inspiration for current students and demonstrate the quality of education we provide.</p>
                                <p>Our alumni have excelled in various fields including industry, academia, research, entrepreneurship, and public service. Their achievements reflect the strong foundation and skills they developed during their time in our department.</p>
                                <p>We regularly feature success stories of our alumni to showcase the diverse career paths and opportunities available to our graduates. These stories highlight the impact of our education and the potential for success in our field.</p>
                            </div>
                        </div>
                        <div class="faculty-page-sidebar">
                            @Html.Partial("_FacultySidebar")
                        </div>
                    </div>
                </div>
            </section>
            <!-- success stories end -->

        </main>
        <!-- main area end  -->

    </div>

</body> 