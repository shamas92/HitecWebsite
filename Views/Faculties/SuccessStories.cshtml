@model List<Website.Models.tblSuccessStory>
@using System.Text.RegularExpressions;
@{
    ViewBag.Title = ViewBag.Title ?? "Success Stories";
    var department = ViewBag.Department as Website.Models.tblDepartment;
    var departmentCode = ViewBag.DepartmentCode as string;
}

@functions {
    private string GetSuccessStoryPhotoPath(string photoFileName)
    {
        // Default placeholder image (same as events)
        var defaultImage = "~/Content/img/team/placeholder-1200x627.jpg";

        if (string.IsNullOrEmpty(photoFileName))
        {
            return Url.Content(defaultImage);
        }

        // Check if it's an absolute URL
        if (photoFileName.StartsWith("http://", StringComparison.OrdinalIgnoreCase) ||
       photoFileName.StartsWith("https://", StringComparison.OrdinalIgnoreCase))
        {
            return photoFileName;
        }

        // Check if it's already a rooted path
        if (photoFileName.StartsWith("/") || photoFileName.StartsWith("~/"))
        {
            var serverPath = Server.MapPath(photoFileName);
            if (System.IO.File.Exists(serverPath))
            {
                return Url.Content(photoFileName);
            }
            return Url.Content(defaultImage);
        }

        // Construct the full server path to check if file exists in Success_Stories directory
        var relativePath = $"~/Content/img/departments/Success_Stories/{photoFileName}";
        var fullServerPath = Server.MapPath(relativePath);

        // Check if the file exists on the server
        if (System.IO.File.Exists(fullServerPath))
        {
            return Url.Content(relativePath);
        }

        // Fallback: check in old uploads/alumni directory for backward compatibility
        var oldPath = $"~/Content/uploads/alumni/{photoFileName}";
        var oldServerPath = Server.MapPath(oldPath);
        if (System.IO.File.Exists(oldServerPath))
        {
            return Url.Content(oldPath);
        }

        // Return default image if file doesn't exist
        return Url.Content(defaultImage);
    }
}

@section Styles {
    <link href="~/Content/css/faculty.css" rel="stylesheet" />
}

<!-- breadcrumb start -->
<section class="breadcrumb bg_img ul_li" data-background="/Content/img/bg/about_bg.jpg">
    <div class="container">
        <div class="breadcrumb__content text-center">
            <h2 class="breadcrumb__title mt-25" style="color: #000">
                @if (department != null)
                {
                    @($"{department.Title} - Success Stories")
                }
                else
                {
                    @("Success Stories")
                }
            </h2>
            <p class="breadcrumb__desc mb-50" style="color: #000">Alumni Achievements</p>
        </div>
    </div>
</section>
<!-- breadcrumb end -->

<!-- success stories start -->
<section class="success-stories-section pb-60">
    <div class="container">
        <div class="faculty-page-layout">
            <div class="faculty-page-content">
                <!-- Hero Section -->
                <div class="faculty-hero">
                    <span class="subtitle">ALUMNI ACHIEVEMENTS</span>
                    <h1>@(department != null ? $"{department.Title} Success Stories" : "Success Stories")</h1>
                    <div class="accent-line"></div>
                    <p>
                        Celebrating the remarkable achievements of our alumni who have excelled in their careers and made significant contributions to their fields.
                    </p>
                </div>

                @if (Model != null && Model.Any())
                {
                    <!-- Success Stories Grid -->
                    <div class="success-stories-grid">
                        @foreach (var story in Model)
                        {
                            var storyImagePath = GetSuccessStoryPhotoPath(story.Photo);
                            
                            <div class="success-story-card">
                                <div class="story-image">
                                    <img src="@storyImagePath"
                                         alt="@(story.FullName ?? "Success Story")"
                                         onerror="this.onerror=null; this.src='@Url.Content("~/Content/img/bg/placeholder.jpg")';" />
                                </div>
                                <div class="story-content">
                                    <h3 class="story-name">@(story.FullName ?? "Alumni")</h3>

                                    @if (!string.IsNullOrEmpty(story.Designation))
                                    {
                                        <div class="story-designation-compact">
                                            <i class="fas fa-briefcase" aria-hidden="true"></i>
                                            <span class="value">@story.Designation</span>
                                        </div>
                                    }

                                    @if (!string.IsNullOrEmpty(story.Organization))
                                    {
                                        <div class="story-organization-compact">
                                            <i class="fas fa-map-marker-alt" aria-hidden="true"></i>
                                            <span class="value">@story.Organization</span>
                                        </div>
                                    }
                                </div>

                                <!-- Hidden details to preserve HTML markup for the modal -->
                                <div class="story-details-html" style="display:none;">
                                    @if (!string.IsNullOrWhiteSpace(story.Details))
                                    {
                                        @Html.Raw(story.Details)
                                    }
                                </div>

                                <div class="story-card-footer">
                                    <button type="button" class="story-details-btn"
                                            data-story-id="@story.ID"
                                            data-story-name="@Html.AttributeEncode(story.FullName ?? "")"
                                            data-story-photo="@Html.AttributeEncode(story.Photo ?? "")"
                                            data-story-organization="@Html.AttributeEncode(story.Organization ?? "")"
                                            data-story-designation="@Html.AttributeEncode(story.Designation ?? "")"
                                            data-story-qualification="@Html.AttributeEncode(story.Qualification ?? "")"
                                            data-story-linkedin="@Html.AttributeEncode(story.Linkedin ?? "")"
                                            data-story-facebook="@Html.AttributeEncode(story.Facebook ?? "")"
                                            data-story-twitter="@Html.AttributeEncode(story.Twitter ?? "")"
                                            onclick="openSuccessStoryModal(this)">
                                        <i class="fas fa-book-open"></i> Read Full Story
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <!-- No Success Stories Message -->
                    <div class="no-success-stories">
                        <div class="no-content-message">
                            <div class="no-content-icon">
                                <i class="fas fa-trophy"></i>
                            </div>
                            <h3>No Success Stories Available</h3>
                            <p>
                                @if (department != null)
                                {
                                    @($"Success stories for {department.Title} will be featured here soon. Check back later for inspiring alumni achievements.")
                                }
                                else
                                {
                                    @("Success stories will be featured here soon. Check back later for inspiring alumni achievements.")
                                }
                            </p>
                        </div>
                    </div>
                }
            </div>
            <div class="faculty-page-sidebar">
                @Html.Partial("_FacultySidebar")
            </div>
        </div>
    </div>
</section>
<!-- success stories end -->

<!-- Success Story Modal -->
<div id="successStoryModal" class="success-story-modal">
    <div class="modal-overlay" onclick="closeSuccessStoryModal()"></div>
    <div class="modal-content">
        <div class="modal-header">
            <div class="modal-header-text">
                <span class="modal-subtitle">Alumni Success Story</span>
                <h2 id="modalTitle" class="modal-title"></h2>
                <div class="modal-accent-line"></div>
            </div>
            <button class="modal-close" onclick="closeSuccessStoryModal()" aria-label="Close">
                <i class="fas fa-times"></i>
            </button>
        </div>
        <div class="modal-body">
            <div class="modal-photo-section">
                <img id="modalPhoto" src="" alt="" class="modal-photo">

                <!-- Info chips under photo -->
                <div class="modal-info-chips">
                    <div id="chipDesignation" class="modal-chip" style="display:none;">
                        <i class="fas fa-briefcase"></i><span></span>
                    </div>
                    <div id="chipOrganization" class="modal-chip" style="display:none;">
                        <i class="fas fa-map-marker-alt"></i><span></span>
                    </div>
                    <div id="chipQualification" class="modal-chip" style="display:none;">
                        <i class="fas fa-graduation-cap"></i><span></span>
                    </div>
                </div>
            </div>
            <div class="modal-details-section">
                <div class="modal-details-card">
                    <h3 class="modal-section-title">
                        <i class="fas fa-trophy"></i>
                        Story Highlights
                    </h3>
                    <div id="modalDetails" class="modal-details-content"></div>
                </div>

                <div id="modalSocialSection" class="modal-social-section" style="display: none;">
                    <h4 class="modal-social-title">
                        <i class="fas fa-share-alt"></i>
                        Connect with Alumni
                    </h4>
                    <div class="modal-social-links">
                        <a id="modalLinkedin" href="" target="_blank" class="modal-social-link linkedin" style="display: none;">
                            <i class="fab fa-linkedin-in"></i>
                            <span>LinkedIn</span>
                        </a>
                        <a id="modalFacebook" href="" target="_blank" class="modal-social-link facebook" style="display: none;">
                            <i class="fab fa-facebook-f"></i>
                            <span>Facebook</span>
                        </a>
                        <a id="modalTwitter" href="" target="_blank" class="modal-social-link twitter" style="display: none;">
                            <i class="fab fa-twitter"></i>
                            <span>Twitter</span>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
  <script>
        // Helper function to get the correct success story photo path
      function getSuccessStoryPhotoPath(photoFileName) {
       var defaultImage = '@Url.Content("~/Content/img/team/placeholder-1200x627.jpg")';
            
       if (!photoFileName || photoFileName.trim() === '') {
 return defaultImage;
      }
            
            // Check if it's an absolute URL
    if (photoFileName.startsWith('http://') || photoFileName.startsWith('https://')) {
   return photoFileName;
 }
            
            // Check if it's already a rooted path
      if (photoFileName.startsWith('/') || photoFileName.startsWith('~/')) {
 return photoFileName;
       }
            
       // Return path to Success_Stories directory
    return '@Url.Content("~/Content/img/departments/Success_Stories/")' + photoFileName;
  }

   $(document).ready(function () {
      // Force hide preloader
  setTimeout(function () {
 $('#preloader').fadeOut('slow', function () {
      $(this).remove();
    });
     }, 500);

            // Smooth animations for success story cards
        $('.success-story-card').each(function (i) {
           $(this).css('opacity', '0');
     $(this).delay(100 * i).animate({ opacity: 1 }, 600);
   });
        });

        function openSuccessStoryModal(button) {
            // Get data from button attributes
            const fullName = button.getAttribute('data-story-name');
         const photo = button.getAttribute('data-story-photo');
      const organization = button.getAttribute('data-story-organization');
      const designation = button.getAttribute('data-story-designation');
    const qualification = button.getAttribute('data-story-qualification');
            const linkedin = button.getAttribute('data-story-linkedin');
 const facebook = button.getAttribute('data-story-facebook');
            const twitter = button.getAttribute('data-story-twitter');

            // Get HTML details from hidden container to preserve markup (tables, etc.)
 const card = button.closest('.success-story-card');
   const hiddenDetails = card ? card.querySelector('.story-details-html') : null;
      const detailsHtml = hiddenDetails ? hiddenDetails.innerHTML : '';

   // Populate modal content
            document.getElementById('modalTitle').textContent = fullName || 'Alumni Success Story';

     // Set photo using helper function
    const modalPhoto = document.getElementById('modalPhoto');
      const photoPath = getSuccessStoryPhotoPath(photo);
            modalPhoto.src = photoPath;
  modalPhoto.alt = fullName || 'Success Story';
       modalPhoto.onerror = function() {
        this.onerror = null;
         this.src = '@Url.Content("~/Content/img/team/placeholder-1200x627.jpg")';
   }

            // Set chips (single display of meta info)
            const chipDesignation = document.getElementById('chipDesignation');
            const chipOrganization = document.getElementById('chipOrganization');
            const chipQualification = document.getElementById('chipQualification');

            if (designation) {
                chipDesignation.style.display = 'inline-flex';
                chipDesignation.querySelector('span').textContent = designation;
            } else {
                chipDesignation.style.display = 'none';
            }

            if (organization) {
                chipOrganization.style.display = 'inline-flex';
                chipOrganization.querySelector('span').textContent = organization;
            } else {
                chipOrganization.style.display = 'none';
            }

            if (qualification) {
                chipQualification.style.display = 'inline-flex';
                chipQualification.querySelector('span').textContent = qualification;
            } else {
                chipQualification.style.display = 'none';
            }

            // Set details (preserve HTML)
            const modalDetails = document.getElementById('modalDetails');
            if (detailsHtml && detailsHtml.trim().length > 0) {
                modalDetails.innerHTML = detailsHtml;
            } else {
                modalDetails.innerHTML = '<div class="faculty-intro"><p>Success story details will be updated soon. Please check back later for the complete story of this remarkable alumnus.</p></div>';
            }

            // Set social media links
            const modalLinkedin = document.getElementById('modalLinkedin');
            const modalFacebook = document.getElementById('modalFacebook');
            const modalTwitter = document.getElementById('modalTwitter');
            const modalSocialSection = document.getElementById('modalSocialSection');

            let hasSocialLinks = false;

            if (linkedin) {
                modalLinkedin.href = linkedin;
                modalLinkedin.style.display = 'flex';
                hasSocialLinks = true;
            } else {
                modalLinkedin.style.display = 'none';
            }

            if (facebook) {
                modalFacebook.href = facebook;
                modalFacebook.style.display = 'flex';
                hasSocialLinks = true;
            } else {
                modalFacebook.style.display = 'none';
            }

            if (twitter) {
                modalTwitter.href = twitter;
                modalTwitter.style.display = 'flex';
                hasSocialLinks = true;
            } else {
                modalTwitter.style.display = 'none';
            }

            modalSocialSection.style.display = hasSocialLinks ? 'block' : 'none';

            // Show modal with animation
            const modal = document.getElementById('successStoryModal');
            modal.classList.add('show');
            modal.style.display = 'flex';
            document.body.style.overflow = 'hidden';
            
            // Animate modal content
            setTimeout(function() {
                $('.modal-content').css('transform', 'scale(1)');
            }, 50);
        }

        function closeSuccessStoryModal() {
            const modal = document.getElementById('successStoryModal');
            $('.modal-content').css('transform', 'scale(0.95)');
            
            setTimeout(function() {
                modal.classList.remove('show');
                modal.style.display = 'none';
                document.body.style.overflow = 'auto';
            }, 200);
        }

        // Close modal when pressing Escape key
        document.addEventListener('keydown', function(event) {
            if (event.key === 'Escape') {
                closeSuccessStoryModal();
            }
        });

        // Prevent modal content clicks from closing the modal
        document.addEventListener('DOMContentLoaded', function() {
            const modalContent = document.querySelector('.modal-content');
            if (modalContent) {
                modalContent.addEventListener('click', function(event) {
                    event.stopPropagation();
                });
            }
        });
    </script>
}