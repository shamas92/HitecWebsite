@{
    ViewBag.Title = "Scheme of Studies";
}

<!-- backtotop - start -->
<!-- backtotop - end -->

<body>
    <div class="body_wrap">

        <!-- main area start  -->
        <main aria-labelledby="title">

            <!-- breadcrumb start -->
            <section class="breadcrumb bg_img ul_li" style="padding: 0; min-height: 0;" data-background="/Content/img/bg/about_bg.jpg">
                <div class="container">
                    <div class="breadcrumb__content text-center">
                        <h2 class="breadcrumb__title mt-25" style="color: #000">Scheme of Studies</h2>
                        <p class="breadcrumb__desc mb-50" style="color: #000">Curriculum Structure</p>
                    </div>
                </div>
            </section>
            <!-- breadcrumb end -->

            <!-- scheme of studies start -->
            <section class="about pb-120 ml-40">
                <div class="container">
                    <div class="faculty-page-layout">
                        <div class="faculty-page-content">
                            <div class="about-content mt-60">
                                <div class="section-title mb-60">
                                    <span class="sub-title">Curriculum</span>
                                    <h2 class="title">Scheme of Studies</h2>
                                </div>
                                <p>Our scheme of studies is designed to provide students with a comprehensive understanding of their field while developing critical thinking, problem-solving, and practical skills. The curriculum is structured to ensure progressive learning and skill development.</p>
                                <p>Each program follows a carefully planned sequence of courses that build upon previous knowledge and prepare students for advanced concepts. We emphasize both theoretical foundations and practical applications throughout the curriculum.</p>
                                <p>The scheme includes core courses, elective courses, laboratory work, projects, and internships. This balanced approach ensures that students receive a well-rounded education that prepares them for professional success.</p>
                            </div>
                        </div>
                        <div class="faculty-page-sidebar">
                            @Html.Partial("_FacultySidebar")
                        </div>
                    </div>
                </div>
            </section>
            <!-- scheme of studies end -->

        </main>
        <!-- main area end  -->

    </div>

</body> 