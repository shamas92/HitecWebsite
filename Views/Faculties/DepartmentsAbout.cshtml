@model Website.Models.tblDepartment
@using System.Text.RegularExpressions;
@{
    var department = Model;
    ViewBag.Title = department != null ? $"{department.Title} - About Department" : "Department Details";

    var aboutText = string.IsNullOrEmpty(department?.About) ? string.Empty : Regex.Replace(department.About, "<.*?>", string.Empty);
    ViewBag.MetaDescription = string.IsNullOrEmpty(aboutText) ? (department != null ? $"Learn about the {department.Title} department at HITEC University, including vision, mission, and academic focus." : "Learn about departments at HITEC University.") : (aboutText.Length > 160 ? aboutText.Substring(0, 160) : aboutText);
    ViewBag.MetaKeywords = department != null ? $"{department.Title}, department, about, HITEC University, {department.Code}" : "department, about, HITEC University";

    // Build a safe banner/background URL
    string bannerUrl = null;
    if (!string.IsNullOrEmpty(department?.Banner))
    {
        var b = department.Banner;
        bool abs = b.StartsWith("http://", System.StringComparison.OrdinalIgnoreCase) || b.StartsWith("https://", System.StringComparison.OrdinalIgnoreCase);
        bool root = b.StartsWith("/") || b.StartsWith("~/");
        bannerUrl = abs ? b : Url.Content(root ? b : ("~/Content/uploads/departments/" + b));
    }
    var defaultBg = Url.Content("~/Content/img/bg/about_bg.jpg");
    var heroBg = !string.IsNullOrEmpty(bannerUrl) ? bannerUrl : defaultBg;
}

@section Styles {
    <link href="~/Content/css/faculty.css" rel="stylesheet" />
}

@section Meta {
    <meta name="description" content="@ViewBag.MetaDescription" />
    <meta name="keywords" content="@ViewBag.MetaKeywords" />
    <meta property="og:title" content="@ViewBag.Title - HITEC University" />
    <meta property="og:description" content="@ViewBag.MetaDescription" />
    <meta property="og:type" content="website" />
}

<div class="body_wrap">
    <main aria-labelledby="title">
        @if (department != null)
        {
            <section class="breadcrumb bg_img ul_li" style="padding:0;min-height:0;" data-background="/Content/img/bg/about_bg.jpg">
                <div class="container">
                    <div class="breadcrumb__content text-center">
                        <h1 class="breadcrumb__title mt-25" style="color:#000">Department of @department.Title</h1>
                        <p class="breadcrumb__desc mb-50" style="color:#000">@department.Code Department</p>
                    </div>
                </div>
            </section>

            <section class="about pb-120">
                <div class="container">
                    <div class="faculty-page-layout">
                        <!-- Content -->
                        <div class="faculty-page-content">
                            <!-- Big Banner Image -->
                            <div class="department-banner-wrap">
                                @{
                                    var placeholder = Url.Content("~/Content/img/bg/video_img.jpg");
                                    var mainUrl = !string.IsNullOrEmpty(heroBg) ? heroBg : placeholder;
                                }
                                <img class="department-banner" src="@mainUrl" alt="@($"{department.Title} Department Banner")" onerror="this.onerror=null; this.src='@placeholder'" />
                            </div>

                            <!-- Hero -->
                            <div class="faculty-hero">
                                <span class="subtitle">About Department</span>
                                <h2>@department.Title</h2>
                                <div class="accent-line"></div>
                                <p>Discover the purpose, focus, and academic strengths of the @department.Title department at HITEC University.</p>
                            </div>

                            <!-- About Card -->
                            <div class="faculty-enhanced-card">
                                <div class="faculty-card-header">
                                    <div class="faculty-badge"><i class="fas fa-university"></i></div>
                                    <h3 class="faculty-card-title">About @department.Title</h3>
                                </div>
                                <div class="faculty-card-content">
                                    @if (!string.IsNullOrWhiteSpace(department.About))
                                    {
                                        @Html.Raw(department.About)
                                    }
                                    else
                                    {
                                        <p>Department description is currently being updated. Please check back later for more information about @department.Title.</p>
                                    }
                                </div>
                            </div>
                        </div>

                        <!-- Sidebar -->
                        <div class="faculty-page-sidebar">
                            @Html.Partial("_FacultySidebar")
                        </div>
                    </div>
                </div>
            </section>
        }
        else
        {
            <section class="about pt-120 pb-120">
                <div class="container">
                    <div class="faculty-enhanced-card">
                        <div class="faculty-card-header">
                            <div class="faculty-badge"><i class="fas fa-exclamation-circle"></i></div>
                            <h3 class="faculty-card-title">Department Not Found</h3>
                        </div>
                        <div class="faculty-card-content">
                            <p>The requested department information is not available. Please check the URL or return to the homepage.</p>
                        </div>
                    </div>
                </div>
            </section>
        }
    </main>
</div>

@section Scripts {
    <script>
        $(function () {
            setTimeout(function () { var $pre = $('#preloader'); if ($pre.length) { $pre.fadeOut('slow', function () { $(this).remove(); }); } }, 500);
        });
    </script>
}