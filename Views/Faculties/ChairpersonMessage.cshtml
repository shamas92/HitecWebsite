@model Website.Models.tblDepartment
@{
    ViewBag.Title = Model != null ? Model.Title + " - Chairperson's Message" : "Chairperson's Message";
    var department = Model;

    ViewBag.MetaDescription = department != null
        ? $"Read the message from the Chairperson of the {department.Title} department at HITEC University. Learn about our vision, mission, and commitment to academic excellence."
        : "Read messages from department chairpersons at HITEC University. Learn about our vision, mission, and commitment to academic excellence.";
    ViewBag.MetaKeywords = department != null
        ? $"{department.Title}, chairperson, message, leadership, HITEC University, {department.Code}"
        : "chairperson, message, leadership, HITEC University";
}

@section Styles {
    <link href="~/Content/css/faculty.css" rel="stylesheet" />
    <style>
        .chairperson-layout {
            overflow: auto; /* Contains the float */
            margin-bottom: 30px;
        }

        .chairperson-photo {
            float: left;
            width: 300px; /* Fixed width for the floated image */
            height: auto;
            border-radius: 12px;
            box-shadow: 0 8px 20px rgba(0, 33, 85, .15);
            margin-bottom: 16px;
            margin-right: 30px; /* Space between image and text */
        }

        .chairperson-name{font-family:'Playfair Display',serif;font-size:22px;font-weight:700;color:#002155;margin:0 0 8px;line-height:1.3}
        .chairperson-title{font-size:14px;color:#fff;font-weight:700;text-transform:uppercase;letter-spacing:.5px;background:linear-gradient(135deg,#fdb714 0%,#f39c12 100%);padding:6px 14px;border-radius:20px;display:inline-block;margin-bottom:12px}
        .chairperson-qualification{font-size:13px;color:#5c5c54;line-height:1.5;margin:0;padding-top:12px;border-top:1px solid #f0f0f0}

        /* --- MODIFIED --- */
        .chairperson-message-content {
            position: relative;
            text-align: justify; /* This line justifies the text */
            color:black;

        }

        media (max-width: 992px) {
            /* No longer need to change the layout, it's already block */
        }

        media (max-width: 768px) {
            .chairperson-photo {
                float: none; /* Turn off float */
                display: block;
                width: 100%; /* Be responsive */
                max-width: 280px; /* But don't get too big */
                margin: 0 auto 25px; /* Center the image */
            }
        }

        media (max-width: 576px) {
            .chairperson-name {
                font-size: 20px;
            }
        }
    </style>
}

@section Meta {
    <meta name="description" content="@ViewBag.MetaDescription" />
    <meta name="keywords" content="@ViewBag.MetaKeywords" />
    <meta property="og:title" content="@ViewBag.Title - HITEC University" />
    <meta property="og:description" content="@ViewBag.MetaDescription" />
    <meta property="og:type" content="website" />
}

<div class="body_wrap">
    <main aria-labelledby="title">
        @if (Model != null)
        {
            <section class="breadcrumb bg_img ul_li" style="padding:0;min-height:0;" data-background="/Content/img/bg/about_bg.jpg">
                <div class="container">
                    <div class="breadcrumb__content text-center">
                        <h1 class="breadcrumb__title mt-25" style="color:#000">@Model.Title</h1>
                        <p class="breadcrumb__desc mb-50" style="color:#000">Chairperson's Message</p>
                    </div>
                </div>
            </section>

            <section class="about pb-120">
                <div class="container">
                    <div class="faculty-page-layout">
                        <div class="faculty-page-content">
                            <div class="faculty-hero">
                                <span class="subtitle">Leadership</span>
                                <h2>Chairperson's Message</h2>
                                <div class="accent-line"></div>
                                <p>Welcome to the @Model.Title department. Read our chairperson's vision for excellence in education, research, and student development.</p>
                            </div>

                            <div class="faculty-enhanced-card">
                                <div class="faculty-card-header">
                                    <div class="faculty-badge"><i class="fas fa-quote-left"></i></div>
                                    <h3 class="faculty-card-title">Message from the Chairperson</h3>
                                </div>
                                <div class="faculty-card-content">

                                    <div class="chairperson-layout">
                                        @if (!string.IsNullOrEmpty(Model.HODPhoto))
                                        {
                                            <img class="chairperson-photo"
                                                 src="@Model.HODPhoto"
                                                 alt="@("Chairperson")"
                                                 onerror="this.src='@Url.Content("~/Content/img/team/team_01.jpg")'" />
                                        }

                                        @if (!string.IsNullOrEmpty(Model.HODMessage))
                                        {
                                            <div class="chairperson-message-content">
                                                @Html.Raw(Model.HODMessage)
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="chairperson-message-content">
                                                <p>Welcome to our department! As the Chairperson, I am delighted to share our vision and commitment to excellence in education and research.</p>
                                                <p>Our department is dedicated to providing high-quality education and fostering innovation in our field. We strive to prepare our students for successful careers while contributing to the advancement of knowledge through research and community engagement.</p>
                                                <p>We believe in creating an inclusive learning environment where students can develop their skills, knowledge, and character. Our faculty members are committed to mentoring and guiding students throughout their academic journey.</p>
                                                <p>Thank you for your interest in our department. We look forward to working with you and supporting your academic and professional growth.</p>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="faculty-page-sidebar">
                            @Html.Partial("_FacultySidebar")
                        </div>
                    </div>
                </div>
            </section>
        }
        else
        {
            <section class="about pt-120 pb-120">
                <div class="container">
                    <div class="faculty-enhanced-card">
                        <div class="faculty-card-header">
                            <div class="faculty-badge"><i class="fas fa-exclamation-circle"></i></div>
                            <h3 class="faculty-card-title">Department Not Found</h3>
                        </div>
                        <div class="faculty-card-content">
                            <p>The requested department information is not available. Please check the URL or return to the homepage.</p>
                        </div>
                    </div>
                </div>
            </section>
        }
    </main>
</div>