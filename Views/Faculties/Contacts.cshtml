@{
    ViewBag.Title = "Contacts";
}

<!-- backtotop - start -->
<!-- backtotop - end -->

<body>
    <div class="body_wrap">

        <!-- main area start  -->
        <main aria-labelledby="title">

            <!-- breadcrumb start -->
            <section class="breadcrumb bg_img ul_li" style="padding: 0; min-height: 0;" data-background="/Content/img/bg/about_bg.jpg">
                <div class="container">
                    <div class="breadcrumb__content text-center">
                        <h2 class="breadcrumb__title mt-25" style="color: #000">Contacts</h2>
                        <p class="breadcrumb__desc mb-50" style="color: #000">Get in Touch</p>
                    </div>
                </div>
            </section>
            <!-- breadcrumb end -->

            <!-- contacts start -->
            <section class="about pb-120">
                <div class="container">
                    <div class="faculty-page-layout">
                        <div class="faculty-page-content">
                            <div class="about-content mt-60">
                                <div class="section-title mb-60">
                                    <span class="sub-title">Contact</span>
                                    <h2 class="title">Contact Information</h2>
                                </div>
                                <p>We welcome your inquiries and are here to help you with any questions about our department, programs, or activities. Please feel free to reach out to us through any of the contact methods listed below.</p>
                                <p>Our office hours are Monday through Friday, 9:00 AM to 5:00 PM. We strive to respond to all inquiries promptly and provide you with the information you need.</p>
                                <p>For general inquiries, program information, or to schedule a visit, please contact our department office. We look forward to hearing from you and assisting you with your academic journey.</p>
                            </div>
                        </div>
                        <div class="faculty-page-sidebar">
                            @Html.Partial("_FacultySidebar")
                        </div>
                    </div>
                </div>
            </section>
            <!-- contacts end -->

        </main>
        <!-- main area end  -->

    </div>

</body> 