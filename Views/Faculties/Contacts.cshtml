@model List<Website.Models.tblDepartmentContact>
@{
    ViewBag.Title = "Contacts";
    var department = ViewBag.Department as Website.Models.tblDepartment;
    var departmentCode = ViewBag.DepartmentCode as string;

    // SEO Meta Tags
    ViewBag.MetaDescription = department != null
        ? $"Contact the {department.Title} department at HITEC University. Find phone numbers, email addresses, office locations, and office hours for faculty and staff."
        : "Contact HITEC University departments. Find phone numbers, email addresses, office locations, and office hours for faculty and staff.";
    ViewBag.MetaKeywords = department != null
        ? $"{department.Title}, contact, phone, email, office, address, HITEC University, {department.Code}"
        : "contact, phone, email, office, address, HITEC University";
}

@section Styles {
    <link href="~/Content/css/faculty-components.css" rel="stylesheet" />
    <link href="~/Content/css/faculty-sidebar.css" rel="stylesheet" />
    <style>
        .contact-card {
            background: var(--color-white);
            border-radius: 15px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
            padding: 30px;
            margin-bottom: 30px;
            transition: all 0.3s ease;
            border-left: 5px solid var(--color-primary);
        }

        .contact-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.12);
        }

        .contact-title {
            font-family: var(--font-heading);
            font-size: 22px;
            font-weight: 600;
            color: var(--color-heading);
            margin-bottom: 20px;
            line-height: 1.3;
            display: flex;
            align-items: center;
        }

        .contact-icon {
            width: 24px;
            height: 24px;
            margin-right: 12px;
            color: var(--color-primary);
        }

        .contact-content {
            color: var(--color-default);
            line-height: 1.6;
            font-size: 15px;
        }

        .contact-content h3,
        .contact-content h4,
        .contact-content h5 {
            color: var(--color-heading);
            margin-top: 20px;
            margin-bottom: 10px;
        }

        .contact-content a {
            color: var(--color-primary);
            text-decoration: none;
            transition: color 0.3s ease;
        }

        .contact-content a:hover {
            color: var(--color-secondary);
            text-decoration: underline;
        }

        .contact-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 30px;
            margin-top: 40px;
        }

        .general-contact {
            background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-secondary) 100%);
            color: var(--color-white);
            border-left: none;
        }

        .general-contact .contact-title,
        .general-contact .contact-content {
            color: var(--color-white);
        }

        .general-contact .contact-icon {
            color: var(--color-white);
        }

        .general-contact .contact-content a {
            color: var(--color-white);
            text-decoration: underline;
        }

        .general-contact .contact-content a:hover {
            opacity: 0.8;
        }

        media (max-width: 768px) {
            .contact-grid {
                grid-template-columns: 1fr;
                gap: 20px;
            }

            .contact-card {
                padding: 20px;
            }

            .contact-title {
                font-size: 20px;
            }
        }
    </style>
}

@section Meta {
    <meta name="description" content="@ViewBag.MetaDescription" />
    <meta name="keywords" content="@ViewBag.MetaKeywords" />
    <meta property="og:title" content="@ViewBag.Title - HITEC University" />
    <meta property="og:description" content="@ViewBag.MetaDescription" />
    <meta property="og:type" content="website" />
}

<body>
    <div class="body_wrap">
        <!-- main area start  -->
        <main aria-labelledby="title">
            <!-- breadcrumb start -->
            <section class="breadcrumb bg_img ul_li" style="padding: 0; min-height: 0;" data-background="/Content/img/bg/about_bg.jpg">
                <div class="container">
                    <div class="breadcrumb__content text-center">
                        <h1 class="breadcrumb__title mt-25" style="color: #000">
                            @if (department != null)
                            {
                                @($"Contact - {department.Title}")
                            }
                            else
                            {
                                @("Contact Information")
                            }
                        </h1>
                        <p class="breadcrumb__desc mb-50" style="color: #000">
                            @if (department != null)
                            {
                                @($"Get in Touch with {department.Code} Department")
                            }
                            else
                            {
                                @("Get in Touch")
                            }
                        </p>
                    </div>
                </div>
            </section>
            <!-- breadcrumb end -->

            <!-- contacts start -->
            <section class="about pb-120">
                <div class="container">
                    <div class="faculty-page-layout">
                        <div class="faculty-page-content">
                            <div class="about-content mt-60">
                                <div class="section-title mb-40">
                                    <span class="sub-title">Contact</span>
                                    <h2 class="title">
                                        @if (department != null)
                                        {
                                            @($"{department.Title} Contact Information")
                                        }
                                        else
                                        {
                                            @("Contact Information")
                                        }
                                    </h2>
                                </div>

                                @if (department != null)
                                {
                                    <p>We welcome your inquiries and are here to help you with any questions about the @department.Title department, our programs, or activities. Please feel free to reach out to us through any of the contact methods listed below.</p>
                                }
                                else
                                {
                                    <p>We welcome your inquiries and are here to help you with any questions about our departments, programs, or activities. Please feel free to reach out to us through any of the contact methods listed below.</p>
                                }

                                <p>Our office hours are Monday through Friday, 9:00 AM to 5:00 PM. We strive to respond to all inquiries promptly and provide you with the information you need.</p>

                                @if (Model != null && Model.Any())
                                {
                                    <!-- Contact Information Grid -->
                                    <div class="contact-grid">
                                        @foreach (var contact in Model)
                                        {
                                            <div class="contact-card @(contact.ContactTitle != null && contact.ContactTitle.ToLower().Contains("general") ? "general-contact" : "")">
                                                <h3 class="contact-title">
                                                    @if (contact.ContactTitle != null && contact.ContactTitle.ToLower().Contains("phone"))
                                                    {
                                                        <i class="contact-icon fas fa-phone"></i>
                                                    }
                                                    else if (contact.ContactTitle != null && contact.ContactTitle.ToLower().Contains("email"))
                                                    {
                                                        <i class="contact-icon fas fa-envelope"></i>
                                                    }
                                                    else if (contact.ContactTitle != null && contact.ContactTitle.ToLower().Contains("address"))
                                                    {
                                                        <i class="contact-icon fas fa-map-marker-alt"></i>
                                                    }
                                                    else if (contact.ContactTitle != null && contact.ContactTitle.ToLower().Contains("office"))
                                                    {
                                                        <i class="contact-icon fas fa-building"></i>
                                                    }
                                                    else
                                                    {
                                                        <i class="contact-icon fas fa-info-circle"></i>
                                                    }
                                                    @(contact.ContactTitle ?? "Contact Information")
                                                </h3>

                                                @if (!string.IsNullOrEmpty(contact.ContactInfo))
                                                {
                                                    <div class="contact-content">
                                                        @Html.Raw(contact.ContactInfo)
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="contact-content">
                                                        <p>Contact information will be updated soon. Please check back later.</p>
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <!-- Default Contact Information -->
                                    <div class="contact-grid">
                                        <div class="contact-card general-contact">
                                            <h3 class="contact-title">
                                                <i class="contact-icon fas fa-university"></i>
                                                @if (department != null)
                                                {
                                                    @($"{department.Title} Department")
                                                }
                                                else
                                                {
                                                    @("HITEC University")
                                                }
                                            </h3>
                                            <div class="contact-content">
                                                @if (department != null)
                                                {
                                                    <p>Contact information for the @department.Title department is currently being updated. Please check back later or contact the main university office for assistance.</p>
                                                }
                                                else
                                                {
                                                    <p>Contact information is currently being updated. Please check back later for detailed contact information.</p>
                                                }
                                                <p><strong>General University Contact:</strong><br>
                                                Phone: +92-51-9047851-60<br>
                                                Email: info@hitecuni.edu.pk<br>
                                                Address: HITEC University, Taxila Cantt, Pakistan</p>
                                            </div>
                                        </div>

                                        <div class="contact-card">
                                            <h3 class="contact-title">
                                                <i class="contact-icon fas fa-clock"></i>
                                                Office Hours
                                            </h3>
                                            <div class="contact-content">
                                                <p><strong>Monday - Friday:</strong> 9:00 AM - 5:00 PM<br>
                                                <strong>Saturday:</strong> 9:00 AM - 1:00 PM<br>
                                                <strong>Sunday:</strong> Closed</p>
                                                <p>For urgent matters outside office hours, please send an email and we will respond as soon as possible.</p>
                                            </div>
                                        </div>

                                        <div class="contact-card">
                                            <h3 class="contact-title">
                                                <i class="contact-icon fas fa-question-circle"></i>
                                                General Inquiries
                                            </h3>
                                            <div class="contact-content">
                                                <p>For general questions about programs, admissions, or university services, please contact our main office.</p>
                                                <p>We strive to respond to all inquiries within 24-48 hours during business days.</p>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                        <div class="faculty-page-sidebar">
                            @Html.Partial("_FacultySidebar")
                        </div>
                    </div>
                </div>
            </section>
            <!-- contacts end -->

        </main>
        <!-- main area end  -->

    </div>

</body> 