@model Website.Models.tblDepartment
@{
    ViewBag.Title = "Contacts";
    var department = Model; // same as ViewBag.Department
    var departmentCode = ViewBag.DepartmentCode as string;

    ViewBag.MetaDescription = department != null
        ? $"Contact the {department.Title} department at HITEC University. Find phone numbers, email addresses, office locations, and office hours for faculty and staff."
        : "Contact HITEC University departments. Find phone numbers, email addresses, office locations, and office hours for faculty and staff.";
    ViewBag.MetaKeywords = department != null
        ? $"{department.Title}, contact, phone, email, office, address, HITEC University, {department?.Code}"
        : "contact, phone, email, office, address, HITEC University";
}

@section Styles {
    <link href="~/Content/css/faculty-components.css" rel="stylesheet" />
    <link href="~/Content/css/faculty-sidebar.css" rel="stylesheet" />
    <style>
        .contact-content { color: var(--color-default); line-height: 1.8; font-size: 16px; }
        .contact-content a { color: var(--color-primary); text-decoration: none; }
        .contact-content a:hover { text-decoration: underline; }
        .contact-content table { display:block; width:100%; overflow-x:auto; }
        .contact-content img, .contact-content iframe, .contact-content video { max-width: 100%; height: auto; }
        .contact-card { background: var(--color-white); border-radius: 15px; box-shadow: 0 10px 30px rgba(0,0,0,.08); padding: 30px; margin-bottom: 30px; }
        media (max-width: 768px) { .contact-card { padding: 20px; } }
    </style>
}

@section Meta {
    <meta name="description" content="@ViewBag.MetaDescription" />
    <meta name="keywords" content="@ViewBag.MetaKeywords" />
    <meta property="og:title" content="@ViewBag.Title - HITEC University" />
    <meta property="og:description" content="@ViewBag.MetaDescription" />
    <meta property="og:type" content="website" />
}

<body>
    <div class="body_wrap">
        <main aria-labelledby="title">
            <section class="breadcrumb bg_img ul_li" style="padding: 0; min-height: 0;" data-background="/Content/img/bg/about_bg.jpg">
                <div class="container">
                    <div class="breadcrumb__content text-center">
                        <h1 class="breadcrumb__title mt-25" style="color: #000">
                            @(department != null ? $"Contact - {department.Title}" : "Contact Information")
                        </h1>
                        <p class="breadcrumb__desc mb-50" style="color: #000">
                            @(department != null ? $"Get in Touch with {department.Code} Department" : "Get in Touch")
                        </p>
                    </div>
                </div>
            </section>

            <section class="about pb-120">
                <div class="container">
                    <div class="faculty-page-layout">
                        <div class="faculty-page-content">
                            <div class="about-content mt-60">
                                <div class="section-title mb-40">
                                    <span class="sub-title">Contact</span>
                                    <h2 class="title">@(department != null ? $"{department.Title} Contact Information" : "Contact Information")</h2>
                                </div>

                                @if (department != null && !string.IsNullOrWhiteSpace(department.Contacts))
                                {
                                    <div class="contact-card">
                                        <div class="contact-content">
                                            @Html.Raw(department.Contacts)
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <div class="contact-card">
                                        <div class="contact-content">
                                            <p>Contact information is being updated. Please check back later.</p>
                                            <p><strong>General University Contact:</strong><br>
                                                Phone: +92-51-9047851-60<br>
                                                Email: info@hitecuni.edu.pk<br>
                                                Address: HITEC University, Taxila Cantt, Pakistan
                                            </p>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                        <div class="faculty-page-sidebar">
                            @Html.Partial("_FacultySidebar")
                        </div>
                    </div>
                </div>
            </section>
        </main>
    </div>
</body>