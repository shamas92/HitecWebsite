@model Website.Models.tblDepartment
@{
    ViewBag.Title = "Programs";
    var department = Model;

    // SEO Meta Tags
    ViewBag.MetaDescription = department != null
        ? $"Discover the comprehensive academic programs offered by the {department.Title} department at HITEC University. Our undergraduate and graduate programs prepare students for successful careers."
        : "Discover the comprehensive academic programs offered at HITEC University. Our undergraduate and graduate programs prepare students for successful careers.";
    ViewBag.MetaKeywords = department != null
        ? $"{department.Title}, programs, undergraduate, graduate, curriculum, degrees, HITEC University, {department.Code}"
        : "programs, undergraduate, graduate, curriculum, degrees, HITEC University";
}

@section Styles {
    <link href="~/Content/css/faculty.css" rel="stylesheet" />
}

@section Meta {
    <meta name="description" content="@ViewBag.MetaDescription" />
    <meta name="keywords" content="@ViewBag.MetaKeywords" />
    <meta property="og:title" content="@ViewBag.Title - HITEC University" />
    <meta property="og:description" content="@ViewBag.MetaDescription" />
    <meta property="og:type" content="website" />
}

<div class="body_wrap">
    <main aria-labelledby="title">
        <!-- breadcrumb start -->
        <section class="breadcrumb bg_img ul_li" data-background="/Content/img/bg/about_bg.jpg">
            <div class="container">
                <div class="breadcrumb__content text-center">
                    <h1 class="breadcrumb__title mt-25" style="color:#000">
                        @(department != null ? $"Programs - {department.Title}" : "Programs")
                    </h1>
                    <p class="breadcrumb__desc mb-50" style="color:#000">
                        @(department != null ? $"{department.Code} Department Academic Programs" : "Academic Programs")
                    </p>
                </div>
            </div>
        </section>
        <!-- breadcrumb end -->

        <section class="about pb-120">
            <div class="container">
                <div class="faculty-page-layout">
                    <div class="faculty-page-content">
                        <!-- Hero -->
                        <div class="faculty-hero">
                            <span class="subtitle">Education</span>
                            <h2>@(department != null ? $"{department.Title} Academic Programs" : "Academic Programs")</h2>
                            <div class="accent-line"></div>
                            <p>
                                @(department != null
                                    ? $"Explore undergraduate and graduate offerings in the {department.Title} department, including curriculum and degree requirements."
                                    : "Explore undergraduate and graduate offerings across our departments, including curriculum and degree requirements.")
                            </p>
                        </div>

                        <!-- Programs Card -->
                        <div class="faculty-enhanced-card">
                            <div class="faculty-card-header">
                                <div class="faculty-badge"><i class="fas fa-graduation-cap"></i></div>
                                <h3 class="faculty-card-title">Programs and Curriculum</h3>
                            </div>
                            <div class="faculty-card-content">
                                @if (department != null && !string.IsNullOrWhiteSpace(department.Programs))
                                {
                                    <div class="program-content">
                                        @Html.Raw(department.Programs)
                                    </div>
                                }
                                else
                                {
                                    <p>Program details are currently being updated. Please contact the department for the most current information about available programs, admission requirements, and curriculum details.</p>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="faculty-page-sidebar">
                        @Html.Partial("_FacultySidebar")
                    </div>
                </div>
            </div>
        </section>
    </main>
</div>