@{
    ViewBag.Title = "Programs";
}

<!-- backtotop - start -->
<!-- backtotop - end -->

<body>
    <div class="body_wrap">

        <!-- main area start  -->
        <main aria-labelledby="title">

            <!-- breadcrumb start -->
            <section class="breadcrumb bg_img ul_li" style="padding: 0; min-height: 0;" data-background="/Content/img/bg/about_bg.jpg">
                <div class="container">
                    <div class="breadcrumb__content text-center">
                        <h2 class="breadcrumb__title mt-25" style="color: #000">Programs</h2>
                        <p class="breadcrumb__desc mb-50" style="color: #000">Academic Programs</p>
                    </div>
                </div>
            </section>
            <!-- breadcrumb end -->

            <!-- programs start -->
            <section class="about pb-120">
                <div class="container">
                    <div class="faculty-page-layout">
                        <div class="faculty-page-content">
                            <div class="about-content mt-60">
                                <div class="section-title mb-60">
                                    <span class="sub-title">Education</span>
                                    <h2 class="title">Academic Programs</h2>
                                </div>
                                <p>Our department offers a comprehensive range of academic programs designed to meet the evolving needs of students and industry. Our curriculum is carefully crafted to provide students with both theoretical knowledge and practical skills.</p>
                                <p>We offer undergraduate and graduate programs that prepare students for successful careers in their chosen fields. Our programs are regularly updated to reflect the latest developments in technology and industry practices.</p>
                                <p>Each program is designed with input from industry experts and alumni to ensure relevance and employability. We emphasize hands-on learning, research opportunities, and industry partnerships to enhance the educational experience.</p>
                            </div>
                        </div>
                        <div class="faculty-page-sidebar">
                            @Html.Partial("_FacultySidebar")
                        </div>
                    </div>
                </div>
            </section>
            <!-- programs end -->

        </main>
        <!-- main area end  -->

    </div>

</body> 