@{
    ViewBag.Title = "FAQs";
}

<!-- backtotop - start -->
<!-- backtotop - end -->

<body>
    <div class="body_wrap">

        <!-- main area start  -->
        <main aria-labelledby="title">

            <!-- breadcrumb start -->
            <section class="breadcrumb bg_img ul_li" style="padding: 0; min-height: 0;" data-background="/Content/img/bg/about_bg.jpg">
                <div class="container">
                    <div class="breadcrumb__content text-center">
                        <h2 class="breadcrumb__title mt-25" style="color: #000">FAQs</h2>
                        <p class="breadcrumb__desc mb-50" style="color: #000">Frequently Asked Questions</p>
                    </div>
                </div>
            </section>
            <!-- breadcrumb end -->

            <!-- FAQs start -->
            <section class="about pb-120">
                <div class="container">
                    <div class="faculty-page-layout">
                        <div class="faculty-page-content">
                            <div class="about-content mt-60">
                                <div class="section-title mb-60">
                                    <span class="sub-title">Information</span>
                                    <h2 class="title">Frequently Asked Questions</h2>
                                </div>
                                <p>Find answers to commonly asked questions about our department, programs, admission requirements, and other important information. We've compiled this FAQ section to help you quickly find the information you need.</p>
                                <p>If you don't find the answer to your question here, please don't hesitate to contact us directly. We're here to help and provide you with the information you need to make informed decisions about your education.</p>
                                <p>Our FAQ section is regularly updated to reflect current policies, procedures, and information. We encourage you to check back periodically for the most up-to-date information.</p>
                            </div>
                        </div>
                        <div class="faculty-page-sidebar">
                            @Html.Partial("_FacultySidebar")
                        </div>
                    </div>
                </div>
            </section>
            <!-- FAQs end -->

        </main>
        <!-- main area end  -->

    </div>

</body> 