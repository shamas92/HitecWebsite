@model List<Website.Models.tblDepartmentUpcomingEvent>
@{
    ViewBag.Title = "Upcoming Events";
    var department = ViewBag.Department as Website.Models.tblDepartment;
    var departmentCode = ViewBag.DepartmentCode as string;

    ViewBag.MetaDescription = department != null
        ? $"Stay updated with upcoming events and activities in the {department.Title} department at HITEC University. Join us for seminars, workshops, and academic events."
        : "Stay updated with upcoming events and activities at HITEC University. Join us for seminars, workshops, and academic events.";
    ViewBag.MetaKeywords = department != null
        ? $"{department.Title}, upcoming events, seminars, workshops, activities, HITEC University, {department.Code}"
        : "upcoming events, seminars, workshops, activities, HITEC University";
}

@section Styles {
    <link href="~/Content/css/faculty-components.css" rel="stylesheet" />
    <link href="~/Content/css/faculty-sidebar.css" rel="stylesheet" />
    <style>
        .event-card {
            background: var(--color-white);
            border-radius: 15px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
            overflow: hidden;
            margin-bottom: 30px;
            transition: all 0.3s ease;
            border-left: 5px solid var(--color-primary);
        }

        .event-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.12);
        }

        .event-image {
            width: 100%;
            height: 200px;
            overflow: hidden;
            position: relative;
        }

        .event-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .event-date-badge {
            position: absolute;
            top: 15px;
            right: 15px;
            background: var(--color-primary);
            color: var(--color-white);
            padding: 8px 12px;
            border-radius: 8px;
            font-weight: 600;
            font-size: 12px;
        }

        .event-content {
            padding: 25px;
        }

        .event-title {
            font-family: var(--font-heading);
            font-size: 20px;
            font-weight: 600;
            color: var(--color-heading);
            margin-bottom: 15px;
            line-height: 1.3;
        }

        .event-details {
            color: var(--color-default);
            line-height: 1.6;
            font-size: 15px;
        }

        .event-meta {
            display: flex;
            gap: 20px;
            margin-bottom: 15px;
            flex-wrap: wrap;
        }

        .event-meta-item {
            display: flex;
            align-items: center;
            font-size: 14px;
            color: var(--color-default);
        }

        .event-meta-icon {
            width: 16px;
            height: 16px;
            margin-right: 8px;
            color: var(--color-primary);
        }
    </style>
}

@section Meta {
    <meta name="description" content="@ViewBag.MetaDescription" />
    <meta name="keywords" content="@ViewBag.MetaKeywords" />
    <meta property="og:title" content="@ViewBag.Title - HITEC University" />
    <meta property="og:description" content="@ViewBag.MetaDescription" />
    <meta property="og:type" content="website" />
}

<body>
    <div class="body_wrap">
        <main aria-labelledby="title">
            <section class="breadcrumb bg_img ul_li" style="padding: 0; min-height: 0;" data-background="/Content/img/bg/about_bg.jpg">
                <div class="container">
                    <div class="breadcrumb__content text-center">
                        <h1 class="breadcrumb__title mt-25" style="color: #000">
                            @if (department != null)
                            {
                                @($"Upcoming Events - {department.Title}")
                            }
                            else
                            {
                                @("Upcoming Events")
                            }
                        </h1>
                        <p class="breadcrumb__desc mb-50" style="color: #000">
                            @if (department != null)
                            {
                                @($"{department.Code} Department Future Activities")
                            }
                            else
                            {
                                @("Future Activities")
                            }
                        </p>
                    </div>
                </div>
            </section>

            <section class="about pb-120">
                <div class="container">
                    <div class="faculty-page-layout">
                        <div class="faculty-page-content">
                            <div class="about-content mt-60">
                                <div class="section-title mb-40">
                                    <span class="sub-title">Events</span>
                                    <h2 class="title">
                                        @if (department != null)
                                        {
                                            @($"{department.Title} Upcoming Events")
                                        }
                                        else
                                        {
                                            @("Upcoming Events")
                                        }
                                    </h2>
                                </div>

                                @if (department != null)
                                {
                                    <p>Stay informed about upcoming events, seminars, workshops, and activities in the @department.Title department. We regularly organize events to enhance learning, promote research collaboration, and foster community engagement.</p>
                                }
                                else
                                {
                                    <p>Stay informed about upcoming events, seminars, workshops, and activities across our departments. We regularly organize events to enhance learning, promote research collaboration, and foster community engagement.</p>
                                }

                                @if (Model != null && Model.Any())
                                {
                                    <div class="faculty-stats">
                                        <div class="faculty-stat">
                                            <span class="faculty-stat-number">@Model.Count</span>
                                            <span class="faculty-stat-label">Upcoming Events</span>
                                        </div>
                                        <div class="faculty-stat">
                                            <span class="faculty-stat-number">@Model.Where(e => e.EventDate.HasValue && e.EventDate.Value.Month == DateTime.Now.Month).Count()</span>
                                            <span class="faculty-stat-label">This Month</span>
                                        </div>
                                        <div class="faculty-stat">
                                            <span class="faculty-stat-number">@Model.Where(e => e.EventDate.HasValue && e.EventDate.Value <= DateTime.Now.AddDays(30)).Count()</span>
                                            <span class="faculty-stat-label">Next 30 Days</span>
                                        </div>
                                    </div>

                                    <div class="events-container">
                                        @foreach (var eventItem in Model.OrderBy(e => e.EventDate))
                                        {
                                            <div class="event-card">
                                                @if (!string.IsNullOrEmpty(eventItem.EventImage))
                                                {
                                                    <div class="event-image">
                                                        <img src="@Url.Content("~/Content/uploads/events/" + eventItem.EventImage)" alt="@eventItem.EventTitle" />
                                                        @if (eventItem.EventDate.HasValue)
                                                        {
                                                            <div class="event-date-badge">
                                                                @eventItem.EventDate.Value.ToString("MMM dd")
                                                            </div>
                                                        }
                                                    </div>
                                                }

                                                <div class="event-content">
                                                    <h3 class="event-title">@(eventItem.EventTitle ?? "Event")</h3>

                                                    <div class="event-meta">
                                                        @if (eventItem.EventDate.HasValue)
                                                        {
                                                            <div class="event-meta-item">
                                                                <i class="event-meta-icon fas fa-calendar"></i>
                                                                <span>@eventItem.EventDate.Value.ToString("MMMM dd, yyyy")</span>
                                                            </div>
                                                        }
                                                        @if (department != null)
                                                        {
                                                            <div class="event-meta-item">
                                                                <i class="event-meta-icon fas fa-building"></i>
                                                                <span>@department.Title Department</span>
                                                            </div>
                                                        }
                                                    </div>

                                                    @if (!string.IsNullOrEmpty(eventItem.EventDetails))
                                                    {
                                                        <div class="event-details">
                                                            @Html.Raw(eventItem.EventDetails)
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <div class="event-details">
                                                            <p>Event details will be announced soon. Please check back for updates.</p>
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <div class="faculty-no-results">
                                        <h3>No Upcoming Events</h3>
                                        @if (department != null)
                                        {
                                            <p>There are currently no upcoming events scheduled for the @department.Title department. Please check back later for new events and activities.</p>
                                        }
                                        else
                                        {
                                            <p>There are currently no upcoming events scheduled. Please check back later for new events and activities.</p>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                        <div class="faculty-page-sidebar">
                            @Html.Partial("_FacultySidebar")
                        </div>
                    </div>
                </div>
            </section>
        </main>
    </div>
</body>