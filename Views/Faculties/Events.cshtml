@model Website.ViewModels.DepartmentEventsViewModel
@using System.Text.RegularExpressions;
@{
    var department = Model.Department;
    ViewBag.Title = department != null ? $"Events - {department.Title}" : "Events";

    ViewBag.MetaDescription = department != null
        ? $"Discover upcoming and past events for the {department.Title} department at HITEC University."
        : "Discover upcoming and past events across HITEC University departments.";
}

@section Styles {
    <link href="~/Content/css/faculty-sidebar.css" rel="stylesheet" />
    <style>
        /* Events Section - Larger, more assertive styling inspired by HR/Admissions pages */
        .events-split{display:grid;grid-template-columns:repeat(auto-fit,minmax(420px,1fr));gap:32px;margin-top:40px}
        
        /* Event Card - Bigger, bolder, stronger impact */
        .event-card{
            background:#fff;
            border-radius:18px;
            box-shadow:0 12px 36px rgba(0,33,85,.14);
            overflow:hidden;
            border:none;
            transition:all .4s cubic-bezier(.25,.46,.45,.94);
            display:flex;
            flex-direction:column;
            position:relative;
            min-height:580px;
        }
        .event-card:hover{
            transform:translateY(-12px) scale(1.02);
            box-shadow:0 24px 52px rgba(0,33,85,.22);
        }
        
        /* Event Image - Larger dimensions */
        .event-image{
            height:260px;
            overflow:hidden;
            position:relative;
            background:linear-gradient(135deg,#f0f2f7 0%,#e6ebf3 100%);
        }
        .event-image img{
            width:100%;
            height:100%;
            object-fit:cover;
            transition:transform .6s cubic-bezier(.25,.46,.45,.94);
        }
        .event-card:hover .event-image img{
            transform:scale(1.12) rotate(.5deg);
        }
        
        /* Event Badge - Bigger, more assertive */
        .event-badge{
            position:absolute;
            top:16px;
            right:16px;
            background:linear-gradient(135deg,#fdb714 0%,#f39c12 100%);
            color:#001a44;
            border-radius:12px;
            padding:10px 14px;
            font-weight:900;
            font-size:14px;
            letter-spacing:.5px;
            box-shadow:0 8px 24px rgba(253,183,20,.42);
            text-transform:uppercase;
            z-index:2;
        }
        
        /* Event Body - More padding, stronger content */
        .event-body{
            padding:28px 26px;
            display:flex;
            flex-direction:column;
            gap:14px;
            flex:1;
        }
        
        /* Event Title - Bigger, bolder typography */
        .event-title{
            font-size:24px;
            font-weight:900;
            color:#002155;
            margin:0;
            font-family:'Playfair Display', serif;
            line-height:1.25;
        }
        .event-title a{
            text-decoration:none;
            color:inherit;
            transition:color .25s ease;
            position:relative;
            z-index:3;
        }
        .event-title a:hover{
            color:#fdb714;
        }
        
        /* Event Meta - Stronger styling with icons */
        .event-meta{
            color:#5c5c54;
            font-size:16px;
            display:flex;
            gap:18px;
            flex-wrap:wrap;
            font-weight:600;
        }
        .event-meta span{
            display:inline-flex;
            align-items:center;
            gap:10px;
        }
        .event-meta i{
            color:#002155;
            font-size:18px;
            width:20px;
            text-align:center;
        }
        
        /* Event Summary - More readable */
        .event-summary{
            color:#5c5c54;
            font-size:16px;
            line-height:1.8;
            margin-top:8px;
            display:-webkit-box;
            -webkit-line-clamp:2;
            -webkit-box-orient:vertical;
            overflow:hidden;
        }
        
        /* Event Footer - Centered, prominent CTA */
        .event-footer{
            display:flex;
            justify-content:center;
            padding:18px 26px 28px;
            margin-top:auto;
            gap:14px;
        }
        
        /* Event Link - Bigger, more assertive button */
        .event-link{
            display:inline-flex;
            align-items:center;
            justify-content:center;
            gap:12px;
            padding:14px 28px;
            border-radius:30px;
            text-decoration:none;
            font-size:15px;
            font-weight:900;
            letter-spacing:.5px;
            color:#fff;
            background:linear-gradient(135deg,#002155 0%,#001a44 100%);
            box-shadow:0 10px 28px rgba(0,33,85,.32);
            transition:all .3s cubic-bezier(.25,.46,.45,.94);
            text-transform:uppercase;
            position:relative;
            z-index:3;
        }
        .event-link:hover{
            transform:translateY(-4px);
            background:linear-gradient(135deg,#001a44 0%,#001233 100%);
            color:#fff;
            box-shadow:0 16px 40px rgba(0,33,85,.42);
        }
        .event-link i{
            font-size:16px;
        }
        
        /* Section Headers */
        .section-sub{
            font-family:'Playfair Display', serif;
            font-size:32px;
            font-weight:900;
            color:#002155;
            margin:50px 0 36px;
            padding-bottom:12px;
            border-bottom:4px solid #fdb714;
            display:inline-block;
        }
        
        media (max-width:992px){
            .events-split{grid-template-columns:repeat(auto-fit,minmax(360px,1fr));gap:28px}
        }
        media (max-width:768px){
            .event-image{height:220px}
            .event-body{padding:24px 22px}
            .event-title{font-size:22px}
            .event-meta{font-size:15px}
            .events-split{grid-template-columns:1fr;gap:24px}
            .section-sub{font-size:28px;margin:40px 0 28px}
        }
        media (max-width:576px){
            .event-image{height:200px}
            .event-body{padding:20px 18px}
            .event-title{font-size:20px}
            .event-meta{font-size:14px;gap:12px}
            .event-summary{font-size:15px}
            .event-link{padding:12px 20px;font-size:13px}
            .section-sub{font-size:24px;margin:30px 0 20px}
        }
    </style>
}

<body>
<div class="body_wrap">
    <main>
        <section class="breadcrumb bg_img ul_li" style="padding:0;min-height:0;" data-background="/Content/img/bg/about_bg.jpg">
            <div class="container">
                <div class="breadcrumb__content text-center">
                    <h1 class="breadcrumb__title mt-25" style="color:#000">@ViewBag.Title</h1>
                    <p class="breadcrumb__desc mb-50" style="color:#000">@((department!=null)? $"{department.Code} Department Activities" : "Department Activities")</p>
                </div>
            </div>
        </section>

        <section class="about pb-120">
            <div class="container">
                <div class="faculty-page-layout">
                    <div class="faculty-page-content">
                        <div class="about-content mt-60">
                            <div class="section-title mb-40">
                                <span class="sub-title">Events</span>
                                <h2 class="title">@((department!=null)? $"{department.Title} Events" : "Events")</h2>
                            </div>

                            @if (Model.Upcoming != null && Model.Upcoming.Any())
                            {
                                <h3 class="section-sub">Upcoming Events</h3>
                                <div class="events-split">
                                    @foreach (var e in Model.Upcoming.OrderBy(x => x.EventDate))
                                    {
                                        var detailsText = string.IsNullOrEmpty(e.Details) ? string.Empty : Regex.Replace(e.Details, "<.*?>", string.Empty);
                                        var summary = detailsText;
                                        if (!string.IsNullOrEmpty(detailsText) && detailsText.Length > 150)
                                        {
                                            summary = detailsText.Substring(0, 150) + "...";
                                        }
                                        var detailsUrl = Url.Action("Details", "Events", new { id = e.EventID });
                                        <div class="event-card">
                                            <div class="event-image">
                                                @if (!string.IsNullOrEmpty(e.Banner))
                                                {
                                                    <img src="@Url.Content("~/Content/uploads/events/" + e.Banner)" alt="@e.Title" />
                                                }
                                                else
                                                {
                                                    <img src="@Url.Content("~/Content/img/bg/placeholder.jpg")" alt="@e.Title" />
                                                }
                                                @if (e.EventDate.HasValue) { <span class="event-badge">@e.EventDate.Value.ToString("MMM dd, yyyy")</span> }
                                            </div>
                                            <div class="event-body">
                                                <h4 class="event-title"><a href="@detailsUrl">@(e.Title ?? "Event")</a></h4>
                                                <div class="event-meta">
                                                    @if (!string.IsNullOrWhiteSpace(e.Venue)) { <span><i class="fas fa-map-marker-alt"></i>@e.Venue</span> }
                                                </div>
                                                @if (!string.IsNullOrWhiteSpace(summary))
                                                {
                                                    <div class="event-summary">@summary</div>
                                                }
                                            </div>
                                            <div class="event-footer">
                                                <a class="event-link" href="@detailsUrl"><i class="fas fa-arrow-right"></i> View Details</a>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }

                            @if (Model.Past != null && Model.Past.Any())
                            {
                                <h3 class="section-sub">Past Events</h3>
                                <div class="events-split">
                                    @foreach (var e in Model.Past.OrderByDescending(x => x.EventDate))
                                    {
                                        var detailsText = string.IsNullOrEmpty(e.Details) ? string.Empty : Regex.Replace(e.Details, "<.*?>", string.Empty);
                                        var summary = detailsText;
                                        if (!string.IsNullOrEmpty(detailsText) && detailsText.Length > 150)
                                        {
                                            summary = detailsText.Substring(0, 150) + "...";
                                        }
                                        var detailsUrl = Url.Action("Details", "Events", new { id = e.EventID });
                                        <div class="event-card">
                                            <div class="event-image">
                                                @if (!string.IsNullOrEmpty(e.Banner))
                                                {
                                                    <img src="@Url.Content("~/Content/uploads/events/" + e.Banner)" alt="@e.Title" />
                                                }
                                                else
                                                {
                                                    <img src="@Url.Content("~/Content/img/bg/placeholder.jpg")" alt="@e.Title" />
                                                }
                                                @if (e.EventDate.HasValue) { <span class="event-badge">@e.EventDate.Value.ToString("MMM dd, yyyy")</span> }
                                            </div>
                                            <div class="event-body">
                                                <h4 class="event-title"><a href="@detailsUrl">@(e.Title ?? "Event")</a></h4>
                                                <div class="event-meta">
                                                    @if (!string.IsNullOrWhiteSpace(e.Venue)) { <span><i class="fas fa-map-marker-alt"></i>@e.Venue</span> }
                                                </div>
                                                @if (!string.IsNullOrWhiteSpace(summary))
                                                {
                                                    <div class="event-summary">@summary</div>
                                                }
                                            </div>
                                            <div class="event-footer">
                                                <a class="event-link" href="@detailsUrl"><i class="fas fa-arrow-right"></i> View Details</a>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }

                            @if ((Model.Upcoming==null || !Model.Upcoming.Any()) && (Model.Past==null || !Model.Past.Any()))
                            {
                                <div class="faculty-no-results">
                                    <h3>No Events</h3>
                                    <p>There are currently no events to display.</p>
                                </div>
                            }
                        </div>
                    </div>
                    <div class="faculty-page-sidebar">
                        @Html.Partial("_FacultySidebar")
                    </div>
                </div>
            </div>
        </section>
    </main>
</div>
</body>
