@model Website.ViewModels.HomeIndexViewModel
@{
    ViewBag.Title = "Home Page";
}
<!-- main area start  -->
<main>
    <div class="body_wrap">
        <!-- hero section start  -->
        <section class="hero o-hidden pos-rel">
            <div class="bg_img" data-background="/Content/img/hero/hero_img03.png">
                <div class="container">
                    <div class="hero__content-wrap text-center pt-55">
                        <div class="section-title clr-white">
                            <span class="sub-title wow fadeInUp" data-wow-delay="0ms" data-wow-duration=".6s">Welcome to HITEC University</span>
                            <h1 class="title wow fadeInUp" data-wow-delay="150ms" data-wow-duration=".6s">Engineering Brighter Futures<br> with Technology.</h1>
                        </div>
                        <div class="xb-hero-img">
                            <img src="~/Content/img/hero/hero_img01.png" alt="">
                        </div>
                    </div>
                </div>
            </div>
        </section>
        <!-- hero section end  -->
        <!-- hero btn start -->
        <div class="hero-btns">
            <div class="btns ul_li_center">
                <a class="thm-btn thm-btn--stroke-white sec-btn" href="/About/Index">About Us<span></span></a>
                <a class="thm-btn thm-btn--stroke-white sec-btn" href="https://admissions.hitecuni.edu.pk/">apply now<span></span></a>
                <a class="thm-btn thm-btn--stroke-white sec-btn" href="/Faculties/TeachingFaculty">talk with a teacher<span></span></a>
            </div>
        </div>
        <!-- hero btn end -->
        <!-- blog/news section start  -->
        <section class="blog pt-115 pb-120 bg_img" data-background="~/Content/img/bg/news_bg01.jpg">
            <style>
                .news-grid {
                    --radius: 16px
                }

                    .news-grid .news-card {
                        position: relative;
                        border-radius: var(--radius);
                        overflow: hidden;
                        background: #121212;
                        box-shadow: 0 10px 30px rgba(0,0,0,.15)
                    }

                        .news-grid .news-card .xb-item--img {
                            height: 220px
                        }

                    .news-grid .news-card--lg .xb-item--img {
                        height: 420px
                    }

                    .news-grid .xb-item--img img {
                        width: 100%;
                        height: 100%;
                        object-fit: cover;
                        display: block
                    }

                    .news-grid .xb-item--holder {
                        position: absolute;
                        left: 0;
                        right: 0;
                        bottom: 0;
                        padding: 18px 22px;
                        color: #fff;
                        background: linear-gradient(180deg,rgba(0,0,0,0) 0%,rgba(0,0,0,.45) 60%,rgba(0,0,0,.8) 100%)
                    }

                    .news-grid .xb-item--cta {
                        display: inline-block;
                        padding: 2px 6px;
                        font-size: 12px;
                        border-radius: 999px;
                        background: rgba(255,255,255,.12);
                        color: #fff;
                        margin-bottom: 10px;
                        backdrop-filter: blur(2px)
                    }

                    .news-grid .xb-item--title {
                        color: #fff;
                        margin: 0;
                        line-height: 1.3;
                        font-weight: 700;
                        font-size: 20px
                    }

                    .news-grid .news-card--lg .xb-item--title {
                        font-size: 28px
                    }

                    .news-grid .col-gap > div {
                        margin-top: 22px
                    }

                @@media(max-width:991.98px) {
                    .news-grid .news-card--lg .xb-item--img {
                        height: 320px
                    }
                }
            </style>
            <div class="container news-grid">
                <div class="blog-sec-top ul_li_between">
                    <div class="section-title mb-40"><span class="sub-title">Latest News</span><h1 class="title">Campus News</h1></div>
                </div>
                <div class="row justify-content-center col-gap align-items-center">
                    @if (Model.LatestEvents != null && Model.LatestEvents.Count > 0)
                    {
                        var eventsList = Model.LatestEvents;
                        <div class="col-lg-3 col-md-8"><div class="xb-blog__left">@for (int i = 0; i < (eventsList.Count > 2 ? 2 : eventsList.Count); i++)
                        {
                            var ev = eventsList[i]; var bannerSrc = string.IsNullOrEmpty(ev.Banner) ? Url.Content("~/Content/img/departments/Events/placeholder.jpg") : Url.Content("~/Content/img/departments/Events/" + ev.Banner);<div class="xb-blog pos-rel mt-20 news-card news-card--sm"><div class="xb-item--img"><a href="@Url.Action("Details","Events",new { id = ev.EventID })"><img src="@bannerSrc" alt="@ev.Title" /></a></div><div class="xb-item--holder"><a class="xb-item--cta" href="@Url.Action("Details","Events",new { id = ev.EventID })">#@(ev.tblEventHead?.Title ?? "Event")</a><h2 class="xb-item--title border-effect-2"><a href="@Url.Action("Details","Events",new { id = ev.EventID })" style="color:#fff;">@(ev.Title != null && ev.Title.Length > 50 ? ev.Title.Substring(0,50)+".." : ev.Title)</a></h2></div></div>}</div></div>
                        <div class="col-lg-6 col-md-8">@if (eventsList.Count > 2)
                        {
                            var mainEvent = eventsList[2]; var bannerSrcMain = string.IsNullOrEmpty(mainEvent.Banner) ? Url.Content("~/Content/img/departments/Events/placeholder-large.jpg") : Url.Content("~/Content/img/departments/Events/" + mainEvent.Banner);<div class="xb-blog chn-margin pos-rel mt-20 news-card news-card--lg"><div class="xb-item--img"><a href="@Url.Action("Details","Events",new { id = mainEvent.EventID })"><img src="@bannerSrcMain" alt="@mainEvent.Title" /></a></div><div class="xb-item--holder"><a class="xb-item--cta" href="@Url.Action("Details","Events",new { id = mainEvent.EventID })">#@(mainEvent.tblEventHead?.Title ?? "Event")</a><h2 class="xb-item--title border-effect"><a href="@Url.Action("Details","Events",new { id = mainEvent.EventID })" style="color:#fff;">@mainEvent.Title</a></h2><div class="xb-item--meta ul_li" style="gap:12px;margin-top:10px;color:#fff;"><span><i class="far fa-calendar"></i> @((mainEvent.EventDate ?? mainEvent.Date)?.ToString("dd MMM yyyy"))</span>@if (!string.IsNullOrEmpty(mainEvent.Venue))
                            {<span><i class="far fa-map-marker-alt"></i> @mainEvent.Venue</span>}<span><i class="far fa-eye"></i> @(mainEvent.Views ?? 0)</span></div></div></div>}</div>
                        <div class="col-lg-3 col-md-8"><div class="xb-blog__right">@for (int i = 3; i < (eventsList.Count > 5 ? 5 : eventsList.Count); i++)
                        {
                            var ev = eventsList[i]; var bannerSrcRight = string.IsNullOrEmpty(ev.Banner) ? Url.Content("~/Content/img/departments/Events/placeholder-small.jpg") : Url.Content("~/Content/img/departments/Events/" + ev.Banner);<div class="xb-blog mr-left pos-rel mt-20 news-card news-card--sm"><div class="xb-item--img"><a href="@Url.Action("Details","Events",new { id = ev.EventID })"><img src="@bannerSrcRight" alt="@ev.Title" /></a></div><div class="xb-item--holder"><a class="xb-item--cta" href="@Url.Action("Details","Events",new { id = ev.EventID })">#@(ev.tblEventHead?.Title ?? "Event")</a><h2 class="xb-item--title border-effect-2"><a href="@Url.Action("Details","Events",new { id = ev.EventID })" style="color:#fff;">@(ev.Title != null && ev.Title.Length > 50 ? ev.Title.Substring(0,50)+".." : ev.Title)</a></h2></div></div>}</div></div>
                    }
                    else
                    { <div class="col-12"><p>No events to display at this time.</p></div>}
                </div>
                <div class="xb-btn text-center pt-60"><a class="thm-btn" href="@Url.Action("Index","Events")">More Campus News<span class="icon"></span></a></div>
            </div>
        </section>
