@model HitecCM.Models.tblHrContributoryFund
@{
    ViewBag.Title = string.IsNullOrWhiteSpace(Model?.Title) ? "Contributory Fund" : Model.Title;

    // SEO Meta Tags
    ViewBag.MetaDescription = "Details about HITEC University's Employee Contributory Fund including eligibility, contributions, withdrawals, benefits, and management policy.";
    ViewBag.MetaKeywords = "HITEC University, contributory fund, employee welfare, fund policy, contributions, withdrawals, retirement benefits, savings, HR policies";
}

@section Styles {
    <link rel="stylesheet" href="@Url.Content("~/Content/css/hr.css")" />
}

@section Meta {
    <meta name="description" content="@ViewBag.MetaDescription" />
    <meta name="keywords" content="@ViewBag.MetaKeywords" />
    <meta property="og:title" content="@ViewBag.Title - HITEC University" />
    <meta property="og:description" content="@ViewBag.MetaDescription" />
    <meta property="og:type" content="website" />
}

<div class="body_wrap">
    <!-- main area start  -->
    <main>
        <!-- breadcrumb start -->
        <section class="breadcrumb bg_img ul_li" data-background="/Content/img/bg/about_bg.jpg">
            <div class="container">
                <div class="breadcrumb__content text-center">
                    <h1 class="breadcrumb__title mt-25">@ViewBag.Title</h1>
                    <p class="breadcrumb__desc mb-50">Human Resources Department</p>
                </div>
            </div>
        </section>
        <!-- breadcrumb end -->
        <!-- employment section start -->

        <section class="employment-section">
                <!-- Hero Header -->
                
                @if (!string.IsNullOrWhiteSpace(Model?.PageData))
                {
                    <!-- Dynamic content from database (styled and animated like other cards) -->
                    @Html.Raw(Model.PageData)
                }
        </section>
        <!-- employment section end -->
    </main>
    <!-- main area end  -->
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Force hide preloader
            setTimeout(function () {
                $('#preloader').fadeOut('slow', function () {
                    $(this).remove();
                });
            }, 500);

            // Smooth animations for any fund cards present in dynamic content
            $('.fund-card').each(function(i) {
                $(this).delay(100 * i).fadeIn(500);
            });
        });
    </script>
}