@{
    ViewBag.Title = "Perks & Privileges";

    // SEO Meta Tags
    ViewBag.MetaDescription = "Comprehensive employee perks and privileges at HITEC University including education subsidies, incentives, loans, publication rewards, welfare fund, and death benefits.";
    ViewBag.MetaKeywords = "HITEC University, employee benefits, perks, privileges, education subsidy, tuition fee concession, loans, publications, welfare fund, employee incentives";
}

@section Styles {
    <style>
        /* Modern Perks & Privileges Styles with Official Website Theme */
        .perks-section {
            padding: 60px 0;
            background: #f8f6f0;
        }

        /* Hero Header with Left-Side Accent */
        .perks-hero {
            background: linear-gradient(135deg, #002155 0%, #001a44 100%);
            color: white;
            border-radius: 16px;
            padding: 50px 40px;
            margin-bottom: 50px;
            position: relative;
            overflow: hidden;
        }

        .perks-hero::before {
            content: '';
            position: absolute;
            top: 50%;
            right: -10%;
            width: 450px;
            height: 450px;
            background: rgba(253, 183, 20, 0.1);
            border-radius: 50%;
            transform: translateY(-50%);
        }

        .perks-hero h1 {
            font-family: 'Playfair Display', serif;
            font-size: 42px;
            font-weight: 700;
            color: white;
            margin-bottom: 15px;
            position: relative;
            z-index: 1;
        }

        .perks-hero p {
            font-size: 18px;
            color: rgba(255, 255, 255, 0.9);
            margin: 0;
            position: relative;
            z-index: 1;
            max-width: 900px;
        }

        .perks-hero .accent-line {
            width: 80px;
            height: 4px;
            background: #fdb714;
            margin: 20px 0;
            border-radius: 2px;
        }

        .perks-hero .subtitle {
            color: #fdb714;
            font-size: 14px;
            text-transform: uppercase;
            letter-spacing: 2px;
            font-weight: 600;
            margin: 0;
            display: block;
            position: relative;
            z-index: 1;
        }

        /* Section Headers */
        .section-header {
            text-align: center;
            margin-bottom: 50px;
            margin-top: 60px;
        }

        .section-header h2 {
            font-family: 'Playfair Display', serif;
            font-size: 38px;
            font-weight: 700;
            color: #170006;
            margin-bottom: 15px;
        }

        .section-header .subtitle {
            color: #002155;
            font-size: 14px;
            text-transform: uppercase;
            letter-spacing: 2px;
            font-weight: 600;
            margin-bottom: 10px;
            display: block;
        }

        .section-header .divider {
            width: 60px;
            height: 3px;
            background: #fdb714;
            margin: 20px auto;
            border-radius: 2px;
        }

        /* Benefit Cards - Matching TypesAndClassification Style */
        .benefit-card {
            background: white;
            border-radius: 16px;
            margin-bottom: 35px;
            overflow: hidden;
            box-shadow: 0 5px 25px rgba(0, 33, 85, 0.1);
            transition: all 0.4s ease;
        }

        .benefit-card:hover {
            box-shadow: 0 12px 40px rgba(0, 33, 85, 0.18);
            transform: translateY(-5px);
        }

        .benefit-header {
            background: linear-gradient(135deg, #002155 0%, #001a44 100%);
            color: white;
            padding: 30px 35px;
            display: flex;
            align-items: center;
            gap: 20px;
        }

        .benefit-badge {
            width: 70px;
            height: 70px;
            background: #fdb714;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 32px;
            font-weight: 700;
            color: #002155;
            flex-shrink: 0;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
        }

        .benefit-title {
            font-family: 'Playfair Display', serif;
            font-size: 28px;
            font-weight: 600;
            margin: 0;
            color: white;
        }

        .benefit-content {
            padding: 35px;
        }

        .benefit-content p {
            color: #5c5c54;
            line-height: 1.7;
            font-size: 15px;
            margin-bottom: 20px;
        }

        .benefit-content ul {
            list-style: none;
            padding: 0;
            margin: 0;
        }

        .benefit-content ul li {
            padding: 10px 0 10px 30px;
            position: relative;
            color: #170006;
            font-size: 15px;
            line-height: 1.6;
        }

        .benefit-content ul li::before {
            content: '✓';
            position: absolute;
            left: 0;
            color: #fdb714;
            font-weight: 700;
            font-size: 18px;
        }

        .benefit-highlight {
            background: linear-gradient(135deg, #e3f2fd 0%, #bbdefb 100%);
            padding: 20px;
            border-radius: 10px;
            margin-top: 20px;
            border-left: 4px solid #002155;
        }

        .benefit-highlight strong {
            color: #002155;
            font-size: 18px;
            display: block;
            margin-bottom: 8px;
        }

        .benefit-highlight p {
            margin: 0;
            color: #170006;
            font-size: 14px;
            line-height: 1.6;
        }

        /* Publication Rewards Section - Table Style */
        .rewards-table-wrapper {
            background: white;
            border-radius: 16px;
            padding: 40px;
            margin: 40px 0;
            box-shadow: 0 5px 25px rgba(0, 33, 85, 0.1);
        }

        .rewards-table-wrapper h3 {
            font-family: 'Playfair Display', serif;
            font-size: 32px;
            font-weight: 700;
            color: #002155;
            margin-bottom: 30px;
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .rewards-table-wrapper h3 i {
            color: #fdb714;
            font-size: 36px;
        }

        .rewards-section {
            margin-bottom: 40px;
        }

        .rewards-section:last-child {
            margin-bottom: 0;
        }

        .rewards-section h4 {
            color: #002155;
            font-family: 'Playfair Display', serif;
            font-size: 24px;
            margin-bottom: 20px;
            padding-bottom: 10px;
            border-bottom: 2px solid #f8f6f0;
        }

        .rewards-table {
            width: 100%;
        }

        .rewards-table tbody tr {
            border-bottom: 2px solid #f8f6f0;
            transition: all 0.3s ease;
        }

        .rewards-table tbody tr:hover {
            background: #f8f6f0;
        }

        .rewards-table tbody tr:last-child {
            border-bottom: none;
        }

        .rewards-table td {
            padding: 20px 15px;
            vertical-align: middle;
        }

        .rewards-table td:first-child {
            width: 60%;
        }

        .reward-item {
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .reward-icon {
            width: 50px;
            height: 50px;
            background: #002155;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

        .reward-icon i {
            color: #fdb714;
            font-size: 22px;
        }

        .reward-details h5 {
            margin: 0 0 5px 0;
            color: #002155;
            font-weight: 600;
            font-size: 18px;
        }

        .reward-details p {
            margin: 0;
            color: #5c5c54;
            font-size: 14px;
        }

        .reward-amount {
            text-align: right;
        }

        .reward-amount .amount {
            font-size: 28px;
            font-weight: 700;
            color: #fdb714;
            display: block;
            line-height: 1.2;
        }

        .reward-amount .currency {
            font-size: 14px;
            color: #5c5c54;
            display: block;
            margin-top: 5px;
        }

        /* Welfare Fund Section */
        .welfare-fund-card {
            background: white;
            border-radius: 16px;
            padding: 40px;
            margin: 40px 0;
            box-shadow: 0 5px 25px rgba(0, 33, 85, 0.1);
            position: relative;
            overflow: hidden;
        }

        .welfare-fund-card::before {
            content: '';
            position: absolute;
            top: -50px;
            left: -50px;
            width: 200px;
            height: 200px;
            background: radial-gradient(circle, rgba(253, 183, 20, 0.1) 0%, transparent 70%);
        }

        .welfare-fund-card h3 {
            font-family: 'Playfair Display', serif;
            font-size: 32px;
            font-weight: 700;
            color: #002155;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
            gap: 15px;
            position: relative;
            z-index: 1;
        }

        .welfare-fund-card h3 i {
            color: #fdb714;
            font-size: 36px;
        }

        .welfare-fund-card > p {
            color: #5c5c54;
            font-size: 16px;
            line-height: 1.8;
            margin-bottom: 30px;
            position: relative;
            z-index: 1;
        }

        .contribution-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 25px;
            margin-top: 30px;
            position: relative;
            z-index: 1;
        }

        .contribution-item {
            background: linear-gradient(135deg, #e3f2fd 0%, #bbdefb 100%);
            padding: 25px;
            border-radius: 12px;
            border-left: 5px solid #002155;
            transition: all 0.3s ease;
        }

        .contribution-item:hover {
            transform: translateX(5px);
            box-shadow: 0 5px 15px rgba(0, 33, 85, 0.15);
        }

        .contribution-item h5 {
            color: #002155;
            font-weight: 600;
            margin-bottom: 12px;
            font-size: 18px;
        }

        .contribution-item .amount {
            font-size: 32px;
            font-weight: 700;
            color: #fdb714;
            display: block;
            margin: 10px 0;
        }

        .contribution-item p {
            margin: 0;
            color: #170006;
            font-size: 14px;
        }

        .fund-uses {
            background: #f8f6f0;
            padding: 25px;
            border-radius: 10px;
            margin-top: 30px;
            position: relative;
            z-index: 1;
        }

        .fund-uses h5 {
            color: #002155;
            font-weight: 600;
            margin-bottom: 15px;
            font-size: 20px;
        }

        .fund-uses ul {
            list-style: none;
            padding: 0;
            margin: 0;
        }

        .fund-uses ul li {
            padding: 10px 0 10px 30px;
            position: relative;
            color: #170006;
            font-size: 15px;
            line-height: 1.6;
        }

        .fund-uses ul li::before {
            content: '▸';
            position: absolute;
            left: 0;
            color: #fdb714;
            font-weight: 700;
            font-size: 18px;
        }

        /* Emergency Benefits Box */
        .emergency-benefits {
            background: linear-gradient(135deg, #002155 0%, #001a44 100%);
            color: white;
            border-radius: 16px;
            padding: 40px;
            margin: 50px 0;
            position: relative;
            overflow: hidden;
        }

        .emergency-benefits::after {
            content: '';
            position: absolute;
            bottom: -60px;
            right: -60px;
            width: 250px;
            height: 250px;
            background: rgba(253, 183, 20, 0.08);
            border-radius: 50%;
        }

        .emergency-benefits h3 {
            font-family: 'Playfair Display', serif;
            color: #fdb714;
            margin-bottom: 20px;
            font-size: 32px;
            position: relative;
            z-index: 1;
        }

        .emergency-benefits p {
            color: rgba(255, 255, 255, 0.95);
            line-height: 1.8;
            font-size: 16px;
            margin-bottom: 20px;
            position: relative;
            z-index: 1;
        }

        .emergency-benefits ul {
            list-style: none;
            padding: 0;
            margin: 0;
            position: relative;
            z-index: 1;
        }

        .emergency-benefits ul li {
            padding: 12px 0 12px 35px;
            position: relative;
            color: rgba(255, 255, 255, 0.95);
            font-size: 16px;
            line-height: 1.7;
        }

        .emergency-benefits ul li::before {
            content: '✓';
            position: absolute;
            left: 0;
            color: #fdb714;
            font-weight: 700;
            font-size: 20px;
        }

        .emergency-benefits ul li strong {
            color: white;
        }

        /* Contact Section */
        .hr-contact-box {
            background: linear-gradient(135deg, #002155 0%, #001a44 100%);
            color: white;
            border-radius: 16px;
            padding: 50px;
            margin-top: 60px;
            position: relative;
            overflow: hidden;
        }

        .hr-contact-box::before {
            content: '';
            position: absolute;
            top: -100px;
            right: -100px;
            width: 300px;
            height: 300px;
            background: rgba(253, 183, 20, 0.08);
            border-radius: 50%;
        }

        .hr-contact-box h4 {
            font-family: 'Playfair Display', serif;
            color: #fdb714;
            margin-bottom: 25px;
            font-size: 32px;
            position: relative;
            z-index: 1;
        }

        .hr-contact-box p {
            color: rgba(255, 255, 255, 0.9);
            font-size: 16px;
            line-height: 1.7;
            margin-bottom: 30px;
            position: relative;
            z-index: 1;
        }

        .contact-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 20px;
            position: relative;
            z-index: 1;
        }

        .contact-item {
            background: rgba(255, 255, 255, 0.1);
            padding: 18px 20px;
            border-radius: 10px;
            border-left: 4px solid #fdb714;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .contact-item:hover {
            background: rgba(255, 255, 255, 0.15);
            transform: translateX(5px);
        }

        .contact-item i {
            color: #fdb714;
            font-size: 20px;
            flex-shrink: 0;
            width: 24px;
        }

        .contact-item span {
            color: white;
            font-size: 15px;
        }

        /* Responsive */
        media (max-width: 768px) {
            .perks-hero {
                padding: 35px 25px;
            }

            .perks-hero h1 {
                font-size: 32px;
            }

            .section-header h2 {
                font-size: 28px;
            }

            .benefit-header {
                padding: 25px 20px;
                flex-direction: column;
                text-align: center;
            }

            .benefit-badge {
                width: 60px;
                height: 60px;
                font-size: 28px;
            }

            .benefit-title {
                font-size: 22px;
            }

            .benefit-content {
                padding: 25px 20px;
            }

            .rewards-table-wrapper {
                padding: 25px 20px;
            }

            .rewards-table td {
                display: block;
                width: 100% !important;
            }

            .reward-amount {
                text-align: left;
                margin-top: 10px;
            }

            .welfare-fund-card {
                padding: 25px 20px;
            }

            .contribution-grid {
                grid-template-columns: 1fr;
            }

            .emergency-benefits {
                padding: 30px 25px;
            }

            .hr-contact-box {
                padding: 35px 25px;
            }

            .contact-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
}

@section Meta {
    <meta name="description" content="@ViewBag.MetaDescription" />
    <meta name="keywords" content="@ViewBag.MetaKeywords" />
    <meta property="og:title" content="@ViewBag.Title - HITEC University" />
    <meta property="og:description" content="@ViewBag.MetaDescription" />
    <meta property="og:type" content="website" />
}

<div class="body_wrap">
    <!-- main area start  -->
    <main>
        <!-- breadcrumb start -->
        <section class="breadcrumb bg_img ul_li" style="padding: 0; min-height: 0;" data-background="/Content/img/bg/about_bg.jpg">
            <div class="container">
                <div class="breadcrumb__content text-center">
                    <h1 class="breadcrumb__title mt-25" style="color: #000">Perks and Privileges</h1>
                    <p class="breadcrumb__desc mb-50" style="color: #000">Human Resources Department</p>
                </div>
            </div>
        </section>
        <!-- breadcrumb end -->

        <!-- perks section start -->
        <section class="perks-section">
            <div class="container">
                <!-- Hero Header -->
                <div class="perks-hero">
                    <div class="subtitle">HUMAN RESOURCES</div>
                    <div class="accent-line"></div>
                    <h1>Perks and Privileges</h1>
                    <p>HITEC University is committed to providing comprehensive benefits and incentives to support employee growth, well-being, and professional development. Our perks package includes education subsidies, financial incentives, publication rewards, welfare support, and various employee benefits designed to create a supportive and rewarding work environment.</p>
                </div>

                <!-- Education Subsidy Section -->
                <div class="section-header">
                    <span class="subtitle">EDUCATION & DEVELOPMENT</span>
                    <h2>Education Subsidy and Other Incentives</h2>
                    <div class="divider"></div>
                </div>

                <!-- Benefit Card 1: Own Tuition Fee -->
                <div class="benefit-card">
                    <div class="benefit-header">
                        <div class="benefit-badge">1</div>
                        <h3 class="benefit-title">Subsidy in Own Tuition Fee</h3>
                    </div>
                    <div class="benefit-content">
                        <p>All permanent employees of the University receive comprehensive tuition fee subsidy for their own education in MS and PhD programs from the faculty development fund.</p>
                        <ul>
                            <li><strong>100% subsidy</strong> on tuition fee for MS and PhD programs</li>
                            <li>Employee must pay admission/registration fee</li>
                            <li>Original academic documents deposited with Registrar Office</li>
                            <li>Agreement to serve the University: <strong>1 year (MS)</strong> or <strong>2 years (PhD)</strong> after completion</li>
                        </ul>
                        <div class="benefit-highlight">
                            <strong>Full Tuition Fee Coverage</strong>
                            <p>This benefit enables employees to pursue higher education while maintaining their employment, fostering continuous learning and professional development.</p>
                        </div>
                    </div>
                </div>

                <!-- Benefit Card 2: Fee Concession -->
                <div class="benefit-card">
                    <div class="benefit-header">
                        <div class="benefit-badge">2</div>
                        <h3 class="benefit-title">Fee Concession to Wards of Employees</h3>
                    </div>
                    <div class="benefit-content">
                        <p>Wards of the employees of the University studying at HITEC University receive significant tuition fee concessions.</p>
                        <div class="benefit-highlight">
                            <strong>50% Tuition Fee Concession</strong>
                            <p>This benefit helps make quality education accessible to employees' families while promoting a culture of learning within the university community.</p>
                        </div>
                    </div>
                </div>

                <!-- Benefit Card 3: Conference Incentive -->
                <div class="benefit-card">
                    <div class="benefit-header">
                        <div class="benefit-badge">3</div>
                        <h3 class="benefit-title">Incentive for Presenting Papers</h3>
                    </div>
                    <div class="benefit-content">
                        <p>University supports faculty members in presenting research papers at national and international conferences and seminars to promote academic excellence and knowledge sharing.</p>
                        <div class="benefit-highlight">
                            <strong>Up to Rs. 75,000/- per presentation</strong>
                            <p>Funding covers registration fees, travel expenses, and accommodation for conference participation.</p>
                        </div>
                    </div>
                </div>

                <!-- Loan Benefits Section -->
                <div class="section-header">
                    <span class="subtitle">FINANCIAL SUPPORT</span>
                    <h2>Interest-Free Loan Facilities</h2>
                    <div class="divider"></div>
                </div>

                <!-- Benefit Card 4: Personal Loan -->
                <div class="benefit-card">
                    <div class="benefit-header">
                        <div class="benefit-badge">4</div>
                        <h3 class="benefit-title">Personal Interest Free Loan</h3>
                    </div>
                    <div class="benefit-content">
                        <p>All employees are entitled to interest-free loans to meet their personal financial needs.</p>
                        <ul>
                            <li>Loan amount equal to <strong>three months salary</strong></li>
                            <li>Available <strong>once in three years</strong></li>
                            <li>Repayment through <strong>12 monthly installments</strong></li>
                            <li>Employee must provide 12 post-dated cheques to Treasurer Office</li>
                        </ul>
                        <div class="benefit-highlight">
                            <strong>Important Note</strong>
                            <p>Extending this facility is not a matter of right and will be extended subject to availability of funds.</p>
                        </div>
                    </div>
                </div>

                <!-- Benefit Card 5: Laptop Loan -->
                <div class="benefit-card">
                    <div class="benefit-header">
                        <div class="benefit-badge">5</div>
                        <h3 class="benefit-title">Loan for Purchase of Laptop</h3>
                    </div>
                    <div class="benefit-content">
                        <p>All employees are entitled to interest-free loan for the purchase of laptops to support their professional work requirements.</p>
                        <ul>
                            <li><strong>Interest-free</strong> loan facility</li>
                            <li>Repayment through <strong>12 monthly installments</strong></li>
                            <li>Available to all employees for professional use</li>
                        </ul>
                    </div>
                </div>

                <!-- Publications Rewards Section -->
                <div class="section-header">
                    <span class="subtitle">RESEARCH INCENTIVES</span>
                    <h2>Publications Rewards</h2>
                    <div class="divider"></div>
                </div>

                <div class="rewards-table-wrapper">
                    <h3><i class="fas fa-award"></i> Publication Rewards</h3>
                    
                    <div class="rewards-section">
                        <h4>Book Publications</h4>
                        <table class="rewards-table">
                            <tbody>
                                <tr>
                                    <td>
                                        <div class="reward-item">
                                            <div class="reward-icon">
                                                <i class="fas fa-globe"></i>
                                            </div>
                                            <div class="reward-details">
                                                <h5>International Level Book</h5>
                                                <p>Published by internationally recognized publishers</p>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="reward-amount">
                                            <span class="amount">Rs. 100,000/-</span>
                                            <span class="currency">Per Book</span>
                                        </div>
                                    </td>
                                </tr>
                                <tr>
                                    <td>
                                        <div class="reward-item">
                                            <div class="reward-icon">
                                                <i class="fas fa-flag"></i>
                                            </div>
                                            <div class="reward-details">
                                                <h5>National Level Book</h5>
                                                <p>Published by HEC-recognized national publishers</p>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="reward-amount">
                                            <span class="amount">Rs. 50,000/-</span>
                                            <span class="currency">Per Book</span>
                                        </div>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <div class="rewards-section">
                        <h4>Research Papers & Chapters</h4>
                        <table class="rewards-table">
                            <tbody>
                                <tr>
                                    <td>
                                        <div class="reward-item">
                                            <div class="reward-icon">
                                                <i class="fas fa-file-alt"></i>
                                            </div>
                                            <div class="reward-details">
                                                <h5>ISI Indexed Journal Paper</h5>
                                                <p>Publication in ISI (Web of Science) indexed journals</p>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="reward-amount">
                                            <span class="amount">Rs. 20,000/-</span>
                                            <span class="currency">Per Paper</span>
                                        </div>
                                    </td>
                                </tr>
                                <tr>
                                    <td>
                                        <div class="reward-item">
                                            <div class="reward-icon">
                                                <i class="fas fa-book-open"></i>
                                            </div>
                                            <div class="reward-details">
                                                <h5>Book Chapter (International Level)</h5>
                                                <p>Chapter in internationally published books</p>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="reward-amount">
                                            <span class="amount">Rs. 10,000/-</span>
                                            <span class="currency">Per Chapter</span>
                                        </div>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Welfare Fund Section -->
                <div class="section-header">
                    <span class="subtitle">EMPLOYEE WELFARE</span>
                    <h2>Welfare Fund</h2>
                    <div class="divider"></div>
                </div>

                <div class="welfare-fund-card">
                    <h3><i class="fas fa-hands-helping"></i> Welfare Fund</h3>
                    <p>A Welfare Fund shall be generated to support low paid employees and meet their needs in case of financial hardships. This fund will be used to meet expenses incurred on personal marriage/marriage of wards of low paid employees, funeral expenses of deceased serving employees, and to support the deceased family. All employees shall voluntarily contribute to the welfare fund as follows:</p>

                    <div class="contribution-grid">
                        <div class="contribution-item">
                            <h5>Officers / Faculty / Lab Engineers</h5>
                            <span class="amount">Rs. 200/-</span>
                            <p>Per month voluntary contribution</p>
                        </div>

                        <div class="contribution-item">
                            <h5>Other Staff Members</h5>
                            <span class="amount">Rs. 100/-</span>
                            <p>Per month voluntary contribution</p>
                        </div>
                    </div>

                    <div class="fund-uses">
                        <h5>Welfare Fund Usage:</h5>
                        <ul>
                            <li>Marriage expenses of low paid employees or their wards</li>
                            <li>Funeral expenses of deceased serving employees</li>
                            <li>Financial support to the family of deceased employees</li>
                            <li>Emergency financial assistance in case of hardships</li>
                        </ul>
                    </div>
                </div>

                <!-- Death/Incapacitation Benefits -->
                <div class="emergency-benefits">
                    <h3><i class="fas fa-shield-alt"></i> Death/Incapacitation during Service</h3>
                    <p>In case an employee dies or is declared permanently incapacitated for further service by a designated hospital or doctor while in service, comprehensive support is provided to the employee or their family:</p>
                    
                    <ul>
                        <li><strong>Lump-Sum Payment:</strong> Full pay up to maximum of six months out of the leave at employee's credit shall be made to family</li>
                        <li><strong>Funeral Grant:</strong> In case no leave is available to credit, funeral grant equivalent to one month pay shall be paid to next of kin</li>
                        <li><strong>Incapacitation Support:</strong> Same benefits apply if employee is declared permanently incapacitated for further service</li>
                        <li><strong>Family Welfare:</strong> Additional support provided through Welfare Fund for ongoing family needs</li>
                    </ul>
                </div>

                <!-- Contact Information -->
                <div class="hr-contact-box">
                    <h4><i class="fas fa-headset"></i> Human Resources Department</h4>
                    <p>For more detailed information about perks, privileges, benefit enrollment, loan applications, or publication reward claims, please contact the Human Resources Department:</p>
