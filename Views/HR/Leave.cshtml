@{
    ViewBag.Title = "Leave Policies & Procedures";

    // SEO Meta Tags
    ViewBag.MetaDescription = "Comprehensive leave policies and procedures at HITEC University including annual leave, casual leave, medical leave, maternity leave, study leave, and leave application process.";
    ViewBag.MetaKeywords = "HITEC University, leave policy, annual leave, casual leave, medical leave, maternity leave, study leave, leave application, employee benefits, HR policies";
}

@section Styles {
    <style>
        /* Modern Leave Policies Styles with Official Website Theme */
        .leave-section {
            padding: 60px 0;
            background: #f8f6f0;
        }

        /* Hero Header */
        .leave-hero {
            background: linear-gradient(135deg, #002155 0%, #001a44 100%);
            color: white;
            border-radius: 16px;
            padding: 50px 40px;
            margin-bottom: 50px;
            position: relative;
            overflow: hidden;
        }

        .leave-hero::after {
            content: '';
            position: absolute;
            bottom: -20%;
            right: -5%;
            width: 400px;
            height: 400px;
            background: rgba(253, 183, 20, 0.1);
            border-radius: 50%;
        }

        .leave-hero h1 {
            font-family: 'Playfair Display', serif;
            font-size: 42px;
            font-weight: 700;
            color: white;
            margin-bottom: 15px;
            position: relative;
            z-index: 1;
        }

        .leave-hero p {
            font-size: 18px;
            color: rgba(255, 255, 255, 0.9);
            margin: 0;
            position: relative;
            z-index: 1;
            max-width: 900px;
        }

        .leave-hero .accent-line {
            width: 80px;
            height: 4px;
            background: #fdb714;
            margin: 20px 0;
            border-radius: 2px;
        }

        .leave-hero .subtitle {
            color: #fdb714;
            font-size: 14px;
            text-transform: uppercase;
            letter-spacing: 2px;
            font-weight: 600;
            margin: 0;
            display: block;
            position: relative;
            z-index: 1;
        }

        /* Section Headers */
        .section-header {
            text-align: center;
            margin-bottom: 50px;
            margin-top: 60px;
        }

        .section-header h2 {
            font-family: 'Playfair Display', serif;
            font-size: 38px;
            font-weight: 700;
            color: #170006;
            margin-bottom: 15px;
        }

        .section-header .subtitle {
            color: #002155;
            font-size: 14px;
            text-transform: uppercase;
            letter-spacing: 2px;
            font-weight: 600;
            margin-bottom: 10px;
            display: block;
        }

        .section-header .divider {
            width: 60px;
            height: 3px;
            background: #fdb714;
            margin: 20px auto;
            border-radius: 2px;
        }

        /* Leave Type Cards - Matching TypesAndClassification Style */
        .leave-card {
            background: white;
            border-radius: 16px;
            margin-bottom: 35px;
            overflow: hidden;
            box-shadow: 0 5px 25px rgba(0, 33, 85, 0.1);
            transition: all 0.4s ease;
        }

        .leave-card:hover {
            box-shadow: 0 12px 40px rgba(0, 33, 85, 0.18);
            transform: translateY(-5px);
        }

        .leave-header {
            background: linear-gradient(135deg, #002155 0%, #001a44 100%);
            color: white;
            padding: 30px 35px;
            display: flex;
            align-items: center;
            gap: 20px;
        }

        .leave-badge {
            width: 70px;
            height: 70px;
            background: #fdb714;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 32px;
            font-weight: 700;
            color: #002155;
            flex-shrink: 0;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
        }

        .leave-title {
            font-family: 'Playfair Display', serif;
            font-size: 28px;
            font-weight: 600;
            margin: 0;
            color: white;
        }

        .leave-content {
            padding: 35px;
        }

        .leave-content p {
            color: #5c5c54;
            line-height: 1.7;
            font-size: 15px;
            margin-bottom: 20px;
        }

        .leave-content ul {
            list-style: none;
            padding: 0;
            margin: 0;
        }

        .leave-content ul li {
            padding: 10px 0 10px 30px;
            position: relative;
            color: #170006;
            font-size: 15px;
            line-height: 1.6;
        }

        .leave-content ul li::before {
            content: '✓';
            position: absolute;
            left: 0;
            color: #fdb714;
            font-weight: 700;
            font-size: 18px;
        }

        .leave-highlight {
            background: linear-gradient(135deg, #e3f2fd 0%, #bbdefb 100%);
            padding: 20px;
            border-radius: 10px;
            margin-top: 20px;
            border-left: 4px solid #002155;
        }

        .leave-highlight strong {
            color: #002155;
            font-size: 18px;
            display: block;
            margin-bottom: 8px;
        }

        .leave-highlight p {
            margin: 0;
            color: #170006;
            font-size: 14px;
            line-height: 1.6;
        }

        /* General Provisions Box */
        .general-provisions {
            background: white;
            border-radius: 16px;
            padding: 40px;
            margin: 40px 0;
            box-shadow: 0 5px 25px rgba(0, 33, 85, 0.1);
            position: relative;
            overflow: hidden;
        }

        .general-provisions::before {
            content: '';
            position: absolute;
            top: -50px;
            right: -50px;
            width: 200px;
            height: 200px;
            background: radial-gradient(circle, rgba(253, 183, 20, 0.1) 0%, transparent 70%);
        }

        .general-provisions h3 {
            font-family: 'Playfair Display', serif;
            font-size: 32px;
            font-weight: 700;
            color: #002155;
            margin-bottom: 25px;
            display: flex;
            align-items: center;
            gap: 15px;
            position: relative;
            z-index: 1;
        }

        .general-provisions h3 i {
            color: #fdb714;
            font-size: 36px;
        }

        .provision-item {
            padding: 15px 0 15px 35px;
            position: relative;
            color: #5c5c54;
            font-size: 15px;
            line-height: 1.7;
            border-bottom: 1px solid #f8f6f0;
            position: relative;
            z-index: 1;
        }

        .provision-item:last-child {
            border-bottom: none;
        }

        .provision-item::before {
            content: '▸';
            position: absolute;
            left: 0;
            color: #fdb714;
            font-weight: 700;
            font-size: 20px;
        }

        .provision-item strong {
            color: #002155;
        }

        /* Competent Authority Box */
        .authority-box {
            background: linear-gradient(135deg, #002155 0%, #001a44 100%);
            color: white;
            border-radius: 16px;
            padding: 40px;
            margin: 50px 0;
            position: relative;
            overflow: hidden;
        }

        .authority-box::after {
            content: '';
            position: absolute;
            top: -60px;
            left: -60px;
            width: 250px;
            height: 250px;
            background: rgba(253, 183, 20, 0.08);
            border-radius: 50%;
        }

        .authority-box h3 {
            font-family: 'Playfair Display', serif;
            color: #fdb714;
            margin-bottom: 25px;
            font-size: 32px;
            position: relative;
            z-index: 1;
        }

        .authority-box p, .authority-box ul li {
            color: rgba(255, 255, 255, 0.95);
            line-height: 1.8;
            font-size: 16px;
            position: relative;
            z-index: 1;
        }

        .authority-box ul {
            list-style: none;
            padding: 0;
            margin: 20px 0 0 0;
            position: relative;
            z-index: 1;
        }

        .authority-box ul li {
            padding: 12px 0 12px 35px;
            position: relative;
        }

        .authority-box ul li::before {
            content: '✓';
            position: absolute;
            left: 0;
            color: #fdb714;
            font-weight: 700;
            font-size: 20px;
        }

        .authority-box ul li strong {
            color: white;
        }

        /* Contact Section */
        .hr-contact-box {
            background: linear-gradient(135deg, #002155 0%, #001a44 100%);
            color: white;
            border-radius: 16px;
            padding: 50px;
            margin-top: 60px;
            position: relative;
            overflow: hidden;
        }

        .hr-contact-box::before {
            content: '';
            position: absolute;
            top: -100px;
            right: -100px;
            width: 300px;
            height: 300px;
            background: rgba(253, 183, 20, 0.08);
            border-radius: 50%;
        }

        .hr-contact-box h4 {
            font-family: 'Playfair Display', serif;
            color: #fdb714;
            margin-bottom: 25px;
            font-size: 32px;
            position: relative;
            z-index: 1;
        }

        .hr-contact-box p {
            color: rgba(255, 255, 255, 0.9);
            font-size: 16px;
            line-height: 1.7;
            margin-bottom: 30px;
            position: relative;
            z-index: 1;
        }

        .contact-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 20px;
            position: relative;
            z-index: 1;
        }

        .contact-item {
            background: rgba(255, 255, 255, 0.1);
            padding: 18px 20px;
            border-radius: 10px;
            border-left: 4px solid #fdb714;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .contact-item:hover {
            background: rgba(255, 255, 255, 0.15);
            transform: translateX(5px);
        }

        .contact-item i {
            color: #fdb714;
            font-size: 20px;
            flex-shrink: 0;
            width: 24px;
        }

        .contact-item span {
            color: white;
            font-size: 15px;
        }

        /* Responsive */
        media (max-width: 768px) {
            .leave-hero {
                padding: 35px 25px;
            }

            .leave-hero h1 {
                font-size: 32px;
            }

            .section-header h2 {
                font-size: 28px;
            }

            .leave-header {
                padding: 25px 20px;
                flex-direction: column;
                text-align: center;
            }

            .leave-badge {
                width: 60px;
                height: 60px;
                font-size: 28px;
            }

            .leave-title {
                font-size: 22px;
            }

            .leave-content {
                padding: 25px 20px;
            }

            .general-provisions {
                padding: 25px 20px;
            }

            .authority-box {
                padding: 30px 25px;
            }

            .hr-contact-box {
                padding: 35px 25px;
            }

            .contact-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
}

@section Meta {
    <meta name="description" content="@ViewBag.MetaDescription" />
    <meta name="keywords" content="@ViewBag.MetaKeywords" />
    <meta property="og:title" content="@ViewBag.Title - HITEC University" />
    <meta property="og:description" content="@ViewBag.MetaDescription" />
    <meta property="og:type" content="website" />
}

<div class="body_wrap">
    <!-- main area start  -->
    <main>
        <!-- breadcrumb start -->
        <section class="breadcrumb bg_img ul_li" style="padding: 0; min-height: 0;" data-background="/Content/img/bg/about_bg.jpg">
            <div class="container">
                <div class="breadcrumb__content text-center">
                    <h1 class="breadcrumb__title mt-25" style="color: #000">Leave Policies & Procedures</h1>
                    <p class="breadcrumb__desc mb-50" style="color: #000">Human Resources Department</p>
                </div>
            </div>
        </section>
        <!-- breadcrumb end -->

        <!-- leave section start -->
        <section class="leave-section">
            <div class="container">
                <!-- Hero Header -->
                <div class="leave-hero">
                    <div class="subtitle">HUMAN RESOURCES</div>
                    <div class="accent-line"></div>
                    <h1>Leave Policies & Procedures</h1>
                    <p>HITEC University maintains comprehensive leave policies designed to support employee well-being while ensuring operational efficiency. Our leave management system provides various types of leave entitlements with clear guidelines and procedures for application and approval.</p>
                </div>

                <!-- General Provisions -->
                <div class="section-header">
                    <span class="subtitle">POLICY FRAMEWORK</span>
                    <h2>General Provisions</h2>
                    <div class="divider"></div>
                </div>

                <div class="general-provisions">
                    <h3><i class="fas fa-file-contract"></i> Leave Policy Guidelines</h3>
                    
                    <div class="provision-item">
                        <strong>Leave is earned by duty.</strong> It cannot be claimed as a matter of right even when due, and if the exigencies of duty so require, the leave can be refused, and/or if leave has already been granted or being availed, the remaining portion of it can be revoked and the employee can be recalled to join forthwith.
                    </div>

                    <div class="provision-item">
                        <strong>No reason specification required</strong> for leave application so long as that leave is due and admissible to an employee.
                    </div>

                    <div class="provision-item">
                        <strong>Leave shall be applied for, expressed, and sanctioned in terms of days.</strong>
                    </div>

                    <div class="provision-item">
                        <strong>Recall from leave:</strong> If an employee is recalled to duty compulsorily with approval of competent authority from leave being spent away from HITEC University, they may be granted a single return fare from the station where leave is being spent to the place where required to report for duty and one daily allowance as admissible on official duty. If return from leave is optional, the employee is not entitled to any concession.
                    </div>

                    <div class="provision-item">
                        <strong>Early return from leave:</strong> An employee on leave may return to duty before the expiry of the period of leave granted unless permitted by the authority which sanctioned their leave.
                    </div>

                    <div class="provision-item">
                        <strong>Medical leave generally shall not be refused,</strong> however in special circumstances the competent authority can refuse medical leave.
                    </div>

                    <div class="provision-item">
                        <strong>Holidays falling within leave period</strong> shall be counted as leave. They may be suffixed or prefixed to the leave with permission of the sanctioning authority.
                    </div>

                    <div class="provision-item">
                        <strong>Leave type selection:</strong> An employee may apply for the type of leave which is due and admissible and it shall not be refused on the ground that another type of leave should be taken in the particular circumstances.
                    </div>

                    <div class="provision-item">
                        <strong>Leave combination:</strong> One type of leave may be combined with any other type of leave otherwise admissible to the employee; however, <strong>Casual Leave shall not be combined with any other kind of leave.</strong>
                    </div>

                    <div class="provision-item">
                        <strong>No leave shall be availed of unless actually granted,</strong> except leave applied for under emergent circumstances if proved to the satisfaction of the sanctioning authority.
                    </div>

                    <div class="provision-item">
                        <strong>Employee responsibilities:</strong> It shall be the duty of the applicant to make sure that the leave applied for has actually been sanctioned. While proceeding on leave, they shall hand over the charge of their post with report sent through immediate superior. Employee must also leave behind all papers, cash, and keys in their custody as determined by immediate officers. An employee on return from leave shall report for duty to the authority that sanctioned their leave.
                    </div>

                    <div class="provision-item">
                        <strong>Application procedure:</strong> Leave must be applied for on prescribed form stating the kind of leave required. Medical certificate will be submitted if leave on medical grounds is required. Application shall be submitted sufficiently in advance of the date from which leave is sought.
                    </div>

                    <div class="provision-item">
                        <strong>Submission channel:</strong> Application for leave shall be submitted to immediate officer who shall forward same to HR Section with remarks and arrangements proposed during applicant's absence, if period of leave applied for is a week or more.
                    </div>

                    <div class="provision-item">
                        <strong>Leave account maintenance:</strong> Leave account for each employee shall be maintained by HR Section in prescribed form.
                    </div>

                    <div class="provision-item">
                        <strong>Unauthorized absence:</strong> Unless leave is extended, an employee who remains absent after the end of their leave shall not be entitled to any remuneration for the period of such absence and without prejudice to any disciplinary action, <strong>double the period of such absence shall be debited against their leave account.</strong>
                    </div>

                    <div class="provision-item">
                        <strong>Leave timing:</strong> Instead of indicating forenoon or afternoon, leave may commence from day following that on which employee hands over charge of post and may end on day preceding that on which they resume duty.
                    </div>

                    <div class="provision-item">
                        <strong>Regulation applicability:</strong> All employees in service before implementation of these Regulations including those on leave shall be governed by these Regulations.
                    </div>
                </div>

                <!-- Types of Leave -->
                <div class="section-header">
                    <span class="subtitle">LEAVE ENTITLEMENTS</span>
                    <h2>Types of Leave</h2>
                    <div class="divider"></div>
                    <p>HITEC University employees are entitled to the following types of leave</p>
                </div>

                <!-- Annual Leave -->
                <div class="leave-card">
                    <div class="leave-header">
                        <div class="leave-badge">1</div>
                        <h3 class="leave-title">Annual Leave</h3>
                    </div>
                    <div class="leave-content">
                        <p>All employees are entitled to Annual Leave for rest, recreation, and personal activities.</p>
                        <ul>
                            <li>Maximum <strong>30 days Annual Leave each year</strong> 2.5 days per month after having served full year</li>
                            <li>For service less than a year, annual leave is admissible <strong>proportionate to the period of service</strong></li>
                            <li>Leave availed by faculty members during academic breaks will be <strong>adjusted against Annual Leave</strong></li>
                            <li><strong>Teaching Faculty will be granted leave during summer break only</strong></li>
                        </ul>
                        <div class="leave-highlight">
                            <strong>Maximum Entitlement: 30 Days per Year</strong>
                            <p>Pro-rated for partial year service. Faculty leave during academic breaks adjusted against annual leave quota.</p>
                        </div>
                    </div>
                </div>

                <!-- Casual Leave -->
                <div class="leave-card">
                    <div class="leave-header">
                        <div class="leave-badge">2</div>
                        <h3 class="leave-title">Casual Leave</h3>
                    </div>
                    <div class="leave-content">
                        <p>Short-term leave for personal matters, emergencies, or unexpected circumstances.</p>
                        <ul>
                            <li>Employee entitled to maximum of <strong>15 days Casual Leave in a year</strong></li>
                            <li><strong>Casual Leave shall not be combined with any leave</strong></li>
                            <li>Shall not normally be granted for more than <strong>five days at a time</strong></li>
                            <li>May be <strong>prefixed or suffixed to a closed or optional holiday</strong></li>
                            <li>Prefixed and suffixed days <strong>shall not be credited to leave account</strong></li>
                            <li><strong>Any balance not availed shall lapse with the end of the year</strong></li>
                        </ul>
                        <div class="leave-highlight">
                            <strong>Maximum Entitlement: 15 Days per Year</strong>
                            <p>Cannot be combined with other leave types. Unused balance lapses at year end.</p>
                        </div>
                    </div>
                </div>

                <!-- Study Leave -->
                <div class="leave-card">
                    <div class="leave-header">
                        <div class="leave-badge">3</div>
                        <h3 class="leave-title">Study Leave</h3>
                    </div>
                    <div class="leave-content">
                        <p>Leave granted for pursuing higher education, study, or research in accordance with University policy.</p>
                        <ul>
                            <li>Employee may be allowed to avail <strong>study leave without pay</strong></li>
                            <li>Permitted to <strong>rejoin the university after completion of study</strong></li>
                            <li>Subject to <strong>availability of vacancy and requirement of the department</strong></li>
                        </ul>
                        <div class="leave-highlight">
                            <strong>Study Leave (Without Pay)</strong>
                            <p>Granted for higher education/research. Rejoin subject to vacancy availability and departmental requirements.</p>
                        </div>
                    </div>
                </div>

                <!-- Maternity Leave -->
                <div class="leave-card">
                    <div class="leave-header">
                        <div class="leave-badge">4</div>
                        <h3 class="leave-title">Maternity Leave</h3>
                    </div>
                    <div class="leave-content">
                        <p>Leave granted to female employees for childbirth and early childcare.</p>
                        <ul>
                            <li>May be granted <strong>with pay, outside the leave account</strong></li>
                            <li>To the extent of <strong>forty five days in all from the date of confinement</strong></li>
                            <li>May be granted in <strong>continuation of or in combination with any other kind of leave</strong> as may be due and admissible</li>
                        </ul>
                        <div class="leave-highlight">
                            <strong>45 Days Paid Leave</strong>
                            <p>Granted outside regular leave account. Can be combined with other admissible leave types.</p>
                        </div>
                    </div>
                </div>

                <!-- Medical Leave -->
                <div class="leave-card">
                    <div class="leave-header">
                        <div class="leave-badge">5</div>
                        <h3 class="leave-title">Medical Leave</h3>
                    </div>
                    <div class="leave-content">
                        <p>Leave for employees temporarily disabled by injury, ailment, or disease.</p>
                        <ul>
                            <li>May be granted <strong>outside the leave account</strong> of employee</li>
                            <li>Up to maximum of <strong>30 days with full pay</strong></li>
                            <li>On such medical advice as <strong>Vice Chancellor may consider necessary</strong></li>
                            <li>For employee temporarily disabled by injury, ailment, or disease</li>
                            <li>On production of <strong>medical certificate issued by hospital/doctor authorized by University</strong></li>
                            <li><strong>Leave beyond 30 days will be converted into Extra Ordinary leave without pay</strong></li>
                        </ul>
                        <div class="leave-highlight">
                            <strong>Maximum: 30 Days with Full Pay</strong>
                            <p>Requires authorized medical certificate. Beyond 30 days becomes unpaid extraordinary leave.</p>
                        </div>
                    </div>
                </div>

                <!-- Leave Ex-Pakistan -->
                <div class="leave-card">
                    <div class="leave-header">
                        <div class="leave-badge">6</div>
                        <h3 class="leave-title">Leave Ex-Pakistan</h3>
                    </div>
                    <div class="leave-content">
                        <p>Leave for spending time outside Pakistan for personal reasons.</p>
                        <ul>
                            <li>May be granted on <strong>full pay in Pakistani rupees</strong></li>
                            <li>For the <strong>period employee is entitled for the leave</strong></li>
                            <li><strong>Any period spent in excess of entitled leave will be without pay</strong></li>
                        </ul>
                        <div class="leave-highlight">
                            <strong>Full Pay in Pakistani Rupees</strong>
                            <p>Granted for entitled leave duration. Excess period without pay.</p>
                        </div>
                    </div>
                </div>

                <!-- Competent Authority -->
                <div class="section-header">
                    <span class="subtitle">APPROVAL AUTHORITY</span>
                    <h2>Competent Authority</h2>
                    <div class="divider"></div>
                </div>

                <div class="authority-box">
                    <h3><i class="fas fa-user-shield"></i> Leave Sanctioning Authority</h3>
                    
                    <p>The following authority structure governs leave sanctioning at HITEC University:</p>

                    <ul>
                        <li>
                            <strong>Vice Chancellor or delegated officer:</strong> Competent Authority to grant leave other than Casual Leave to faculty/officers in the Secretariat of the University
                        </li>
                        <li>
                            <strong>Deans / PSOs / Chairpersons and Directors:</strong> Exercise powers to sanction casual leave of their employees under powers delegated from time to time by competent authority
                        </li>
                        <li>
                            <strong>All other types of leave including ex-Pakistan leave:</strong> Shall in all cases be granted only by the Vice Chancellor of the University
                        </li>
                    </ul>
                </div>

                <!-- Contact Information -->
                <div class="hr-contact-box">
                    <h4><i class="fas fa-headset"></i> Leave Management Support</h4>
                    <p>For leave applications, policy clarifications, leave balance inquiries, or any leave-related assistance, please contact the Human Resources Department:</p>
                    <div class="contact-grid">
                        <div class="contact-item">
                            <i class="fas fa-envelope"></i>
                            <span>leave@hitecuni.edu.pk</span>
                        </div>
                        <div class="contact-item">
                            <i class="fas fa-phone-alt"></i>
                            <span>051-9047851-60 (Ext. 124)</span>
                        </div>
                        <div class="contact-item">
                            <i class="fas fa-map-marker-alt"></i>
                            <span>HR Department, Admin Block, HITEC University</span>
                        </div>
                        <div class="contact-item">
                            <i class="fas fa-clock"></i>
                            <span>Monday to Friday (8:30 AM - 4:30 PM)</span>
                        </div>
                    </div>
                </div>

            </div>
        </section>
        <!-- leave section end -->
    </main>
    <!-- main area end  -->
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Force hide preloader
            setTimeout(function () {
                $('#preloader').fadeOut('slow', function () {
                    $(this).remove();
                });
            }, 500);

            // Smooth animations
            $('.leave-card').each(function(i) {
                $(this).delay(100 * i).fadeIn(500);
            });
        });
    </script>
}