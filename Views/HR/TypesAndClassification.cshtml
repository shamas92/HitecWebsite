@{
    ViewBag.Title = "Employment Types & Classification";

    // SEO Meta Tags
    ViewBag.MetaDescription = "Learn about the different employment types and classification categories at HITEC University. Understand contract, permanent, visiting, and other faculty positions.";
    ViewBag.MetaKeywords = "HITEC University, employment types, job classification, faculty positions, employment categories, academic positions, staff classifications";
}

@section Styles {
    <style>
        /* Modern Employment Types & Classification Styles with Official Website Theme */
        .employment-section {
            padding: 60px 0;
            background: #f8f6f0;
        }

        /* Hero Header */
        .classification-hero {
            background: linear-gradient(135deg, #002155 0%, #001a44 100%);
            color: white;
            border-radius: 16px;
            padding: 50px 40px;
            margin-bottom: 50px;
            position: relative;
            overflow: hidden;
        }

        .classification-hero::before {
            content: '';
            position: absolute;
            top: -50%;
            right: -10%;
            width: 500px;
            height: 500px;
            background: rgba(253, 183, 20, 0.1);
            border-radius: 50%;
        }

        .classification-hero h1 {
            font-family: 'Playfair Display', serif;
            font-size: 42px;
            font-weight: 700;
            color: white;
            margin-bottom: 15px;
            position: relative;
            z-index: 1;
        }

        .classification-hero p {
            font-size: 18px;
            color: rgba(255, 255, 255, 0.9);
            margin: 0;
            position: relative;
            z-index: 1;
            max-width: 800px;
        }

        .classification-hero .accent-line {
            width: 80px;
            height: 4px;
            background: #fdb714;
            margin: 20px 0;
            border-radius: 2px;
        }

        .classification-hero .subtitle {
            color: #fdb714;
            font-size: 14px;
            text-transform: uppercase;
            letter-spacing: 2px;
            font-weight: 600;
            margin: 0;
            position: relative;
            z-index: 1;
        }

        /* Appointment Types Cards */
        .appointment-section {
            margin: 50px 0;
        }

        .appointment-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
            gap: 30px;
            margin: 40px 0;
        }

        .appointment-card {
            background: white;
            border-radius: 12px;
            padding: 35px;
            box-shadow: 0 4px 20px rgba(0, 33, 85, 0.08);
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            position: relative;
            overflow: hidden;
        }

        .appointment-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 5px;
            height: 100%;
            background: linear-gradient(180deg, #fdb714 0%, #e5a512 100%);
            transform: scaleY(0);
            transform-origin: bottom;
            transition: transform 0.4s ease;
        }

        .appointment-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 12px 35px rgba(0, 33, 85, 0.15);
        }

        .appointment-card:hover::before {
            transform: scaleY(1);
        }

        .appointment-card .card-icon {
            width: 60px;
            height: 60px;
            background: linear-gradient(135deg, #fdb714 0%, #e5a512 100%);
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 25px;
            transition: all 0.3s ease;
        }

        .appointment-card:hover .card-icon {
            transform: rotate(-5deg) scale(1.1);
        }

        .appointment-card .card-icon i {
            font-size: 28px;
            color: #002155;
        }

        .appointment-card h4 {
            font-family: 'Playfair Display', serif;
            font-size: 24px;
            font-weight: 600;
            color: #170006;
            margin-bottom: 15px;
        }

        .appointment-card p {
            color: #5c5c54;
            line-height: 1.7;
            font-size: 15px;
            margin: 0;
        }

        /* Classification Groups */
        .classification-groups {
            margin: 60px 0;
        }

        .section-header {
            text-align: center;
            margin-bottom: 50px;
        }

        .section-header h2 {
            font-family: 'Playfair Display', serif;
            font-size: 38px;
            font-weight: 700;
            color: #170006;
            margin-bottom: 15px;
        }

        .section-header .subtitle {
            color: #002155;
            font-size: 14px;
            text-transform: uppercase;
            letter-spacing: 2px;
            font-weight: 600;
            margin-bottom: 10px;
            display: block;
        }

        .section-header .divider {
            width: 60px;
            height: 3px;
            background: #fdb714;
            margin: 20px auto;
            border-radius: 2px;
        }

        .group-card {
            background: white;
            border-radius: 16px;
            margin-bottom: 35px;
            overflow: hidden;
            box-shadow: 0 5px 25px rgba(0, 33, 85, 0.1);
            transition: all 0.4s ease;
        }

        .group-card:hover {
            box-shadow: 0 12px 40px rgba(0, 33, 85, 0.18);
            transform: translateY(-5px);
        }

        .group-header {
            background: linear-gradient(135deg, #002155 0%, #001a44 100%);
            color: white;
            padding: 30px 35px;
            display: flex;
            align-items: center;
            gap: 20px;
        }

        .group-badge {
            width: 70px;
            height: 70px;
            background: #fdb714;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 32px;
            font-weight: 700;
            color: #002155;
            flex-shrink: 0;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
        }

        .group-title {
            font-family: 'Playfair Display', serif;
            font-size: 28px;
            font-weight: 600;
            margin: 0;
            color: white;
        }

        .group-content {
            padding: 35px;
        }

        .position-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
            gap: 15px;
        }

        .position-item {
            padding: 15px 20px 15px 30px;
            background: #f8f6f0;
            border-radius: 8px;
            color: #170006;
            font-size: 15px;
            font-weight: 500;
            transition: all 0.3s ease;
            border-left: 3px solid transparent;
            position: relative;
        }

        .position-item::before {
            content: '•';
            color: #fdb714;
            font-size: 20px;
            position: absolute;
            left: 12px;
            top: 50%;
            transform: translateY(-50%);
        }

        .position-item:hover {
            background: white;
            border-left-color: #fdb714;
            transform: translateX(5px);
            box-shadow: 0 3px 10px rgba(0, 33, 85, 0.1);
        }

        /* Info Box */
        .info-highlight {
            background: linear-gradient(135deg, #e3f2fd 0%, #bbdefb 100%);
            border-radius: 12px;
            padding: 30px;
            margin: 40px 0;
            border-left: 5px solid #002155;
        }

        .info-highlight h5 {
            color: #002155;
            font-family: 'Playfair Display', serif;
            font-weight: 600;
            margin-bottom: 15px;
            font-size: 22px;
            display: flex;
            align-items: center;
        }

        .info-highlight h5 i {
            color: #002155;
            margin-right: 12px;
            font-size: 24px;
        }

        .info-highlight p {
            color: #170006;
            margin: 0;
            line-height: 1.8;
            font-size: 15px;
        }

        /* Important Note */
        .important-note {
            background: white;
            border: 2px solid #002155;
            border-radius: 12px;
            padding: 35px;
            margin: 50px 0;
            position: relative;
        }

        .important-note::before {
            content: '';
            position: absolute;
            top: -2px;
            left: -2px;
            right: -2px;
            bottom: -2px;
            background: linear-gradient(135deg, #fdb714 0%, #002155 100%);
            border-radius: 12px;
            z-index: -1;
            opacity: 0.1;
        }

        .important-note h5 {
            color: #002155;
            font-family: 'Playfair Display', serif;
            font-weight: 600;
            margin-bottom: 20px;
            font-size: 24px;
            display: flex;
            align-items: center;
        }

        .important-note h5 i {
            background: #fdb714;
            color: #002155;
            width: 40px;
            height: 40px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-right: 15px;
            flex-shrink: 0;
        }

        .important-note p {
            color: #170006;
            line-height: 1.8;
            font-size: 16px;
            margin: 0;
        }

        /* Contact Section */
        .hr-contact {
            background: linear-gradient(135deg, #002155 0%, #001a44 100%);
            color: white;
            border-radius: 16px;
            padding: 50px;
            margin-top: 60px;
            position: relative;
            overflow: hidden;
        }

        .hr-contact::before {
            content: '';
            position: absolute;
            top: -100px;
            right: -100px;
            width: 300px;
            height: 300px;
            background: rgba(253, 183, 20, 0.1);
            border-radius: 50%;
        }

        .hr-contact h4 {
            font-family: 'Playfair Display', serif;
            color: #fdb714;
            margin-bottom: 25px;
            font-size: 32px;
            position: relative;
            z-index: 1;
        }

        .hr-contact p {
            color: rgba(255, 255, 255, 0.9);
            font-size: 16px;
            line-height: 1.7;
            margin-bottom: 30px;
            position: relative;
            z-index: 1;
        }

        .contact-details {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 25px;
            position: relative;
            z-index: 1;
        }

        .contact-item {
            background: rgba(255, 255, 255, 0.1);
            padding: 20px;
            border-radius: 10px;
            border-left: 4px solid #fdb714;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
        }

        .contact-item:hover {
            background: rgba(255, 255, 255, 0.15);
            transform: translateX(5px);
        }

        .contact-item i {
            color: #fdb714;
            font-size: 20px;
            margin-right: 12px;
            flex-shrink: 0;
        }

        .contact-item span {
            color: white;
            font-size: 15px;
        }

        /* Responsive */
        media (max-width: 768px) {
            .classification-hero {
                padding: 35px 25px;
            }

            .classification-hero h1 {
                font-size: 32px;
            }

            .section-header h2 {
                font-size: 28px;
            }

            .appointment-grid {
                grid-template-columns: 1fr;
            }

            .group-header {
                padding: 25px 20px;
                flex-direction: column;
                text-align: center;
            }

            .group-badge {
                width: 60px;
                height: 60px;
                font-size: 28px;
            }

            .group-title {
                font-size: 22px;
            }

            .position-grid {
                grid-template-columns: 1fr;
            }

            .hr-contact {
                padding: 35px 25px;
            }

            .contact-details {
                grid-template-columns: 1fr;
            }
        }
    </style>
}

@section Meta {
    <meta name="description" content="@ViewBag.MetaDescription" />
    <meta name="keywords" content="@ViewBag.MetaKeywords" />
    <meta property="og:title" content="@ViewBag.Title - HITEC University" />
    <meta property="og:description" content="@ViewBag.MetaDescription" />
    <meta property="og:type" content="website" />
}

<div class="body_wrap">
    <!-- main area start  -->
    <main>
        <!-- breadcrumb start -->
        <section class="breadcrumb bg_img ul_li" style="padding: 0; min-height: 0;" data-background="/Content/img/bg/about_bg.jpg">
            <div class="container">
                <div class="breadcrumb__content text-center">
                    <h1 class="breadcrumb__title mt-25" style="color: #000">Employment Types & Classification</h1>
                    <p class="breadcrumb__desc mb-50" style="color: #000">Human Resources Department</p>
                </div>
            </div>
        </section>
        <!-- breadcrumb end -->

        <!-- employment section start -->
        <section class="employment-section">
            <div class="container">
                <!-- Hero Header -->
                <div class="classification-hero">
                    <div class="subtitle">HUMAN RESOURCES</div>
                    <div class="accent-line"></div>
                    <h1>Types and Classification of Services</h1>
                    <p>HITEC University maintains a comprehensive and structured employment framework that clearly defines the types of appointments and classification of services. This framework ensures transparency, fairness, and clarity in employment relationships while supporting the university's academic and administrative excellence.</p>
                </div>

                <!-- Types of Employment -->
                <div class="appointment-section">
                    <div class="section-header">
                        <span class="subtitle">EMPLOYMENT STRUCTURE</span>
                        <h2>Types of University Employment</h2>
                        <div class="divider"></div>
                        <p style="color: #5c5c54; font-size: 16px;">All employments shall be made on contractual basis</p>
                    </div>

                    <div class="appointment-grid">
                        <div class="appointment-card">
                            <div class="card-icon">
                                <i class="fas fa-calendar-alt"></i>
                            </div>
                            <h4>Fixed Period Appointments</h4>
                            <p>All appointments other than faculty are considered Fixed Period Appointments and shall continue according to the contract period. These positions provide structured employment terms with clearly defined durations and responsibilities.</p>
                        </div>

                        <div class="appointment-card">
                            <div class="card-icon">
                                <i class="fas fa-infinity"></i>
                            </div>
                            <h4>Open Ended Appointments</h4>
                            <p>All faculty appointments are regarded as Open Ended Appointments and shall continue their service subject to their good health and performance. This ensures continuity in academic excellence and research pursuits.</p>
                        </div>
                    </div>
                </div>

                <!-- Classification of Services -->
                <div class="classification-groups">
                    <div class="section-header">
                        <span class="subtitle">SERVICE CATEGORIES</span>
                        <h2>Classification of University Service</h2>
                        <div class="divider"></div>
                    </div>

                    <div class="info-highlight">
                        <h5><i class="fas fa-info-circle"></i> Service Groups Overview</h5>
                        <p>The employees of the University are classified in seven main groups, each representing different functional areas and responsibilities within the university structure.</p>
                    </div>

                    <!-- Group 1: Management -->
                    <div class="group-card">
                        <div class="group-header">
                            <div class="group-badge">1</div>
                            <h3 class="group-title">Management</h3>
                        </div>
                        <div class="group-content">
                            <div class="position-grid">
                                <div class="position-item">Vice Chancellor</div>
                                <div class="position-item">Registrar</div>
                                <div class="position-item">Treasurer</div>
                                <div class="position-item">Controller Examination</div>
                                <div class="position-item">Director Student Affairs</div>
                                <div class="position-item">Director Quality Assurance and Collaborations</div>
                            </div>
                        </div>
                    </div>

                    <!-- Group 2: Academic Staff -->
                    <div class="group-card">
                        <div class="group-header">
                            <div class="group-badge">2</div>
                            <h3 class="group-title">Academic Staff</h3>
                        </div>
                        <div class="group-content">
                            <div class="position-grid">
                                <div class="position-item">Deans</div>
                                <div class="position-item">Chairpersons of the Departments</div>
                                <div class="position-item">Faculty Members</div>
                                <div class="position-item">Lab Engineers</div>
                            </div>
                        </div>
                    </div>

                    <!-- Group 3: Executives -->
                    <div class="group-card">
                        <div class="group-header">
                            <div class="group-badge">3</div>
                            <h3 class="group-title">Executives</h3>
                        </div>
                        <div class="group-content">
                            <div class="position-grid">
                                <div class="position-item">Deputy Registrar</div>
                                <div class="position-item">Deputy Controller of Examinations</div>
                                <div class="position-item">Deputy Directors</div>
                                <div class="position-item">Deputy Treasurer</div>
                                <div class="position-item">Managers</div>
                            </div>
                        </div>
                    </div>

                    <!-- Group 4: Officers -->
                    <div class="group-card">
                        <div class="group-header">
                            <div class="group-badge">4</div>
                            <h3 class="group-title">Officers</h3>
                        </div>
                        <div class="group-content">
                            <div class="position-grid">
                                <div class="position-item">Assistant Registrar</div>
                                <div class="position-item">Assistant Director</div>
                                <div class="position-item">Asst Controller of Examinations</div>
                                <div class="position-item">Assistant Treasurer</div>
                                <div class="position-item">Assistant Manager</div>
                                <div class="position-item">Software/Hardware/Network Engineer</div>
                                <div class="position-item">Audit Officer</div>
                                <div class="position-item">Finance Officer</div>
                            </div>
                        </div>
                    </div>

                    <!-- Group 5: Secretarial and Other Staff -->
                    <div class="group-card">
                        <div class="group-header">
                            <div class="group-badge">5</div>
                            <h3 class="group-title">Secretarial and Other Staff</h3>
                        </div>
                        <div class="group-content">
                            <div class="position-grid">
                                <div class="position-item">Superintendents</div>
                                <div class="position-item">Coordinators</div>
                                <div class="position-item">Lab Supervisors</div>
                                <div class="position-item">Senior Data Entry Operators</div>
                                <div class="position-item">Senior Lab Assistants</div>
                                <div class="position-item">Senior Library Assistants</div>
                                <div class="position-item">Network Technicians</div>
                                <div class="position-item">Data Entry Operators</div>
                                <div class="position-item">Lab / Library Assistants</div>
                                <div class="position-item">Office Assistants</div>
                            </div>
                        </div>
                    </div>

                    <!-- Group 6: Skilled -->
                    <div class="group-card">
                        <div class="group-header">
                            <div class="group-badge">6</div>
                            <h3 class="group-title">Skilled Staff</h3>
                        </div>
                        <div class="group-content">
                            <div class="position-grid">
                                <div class="position-item">Horticulture Superintendent</div>
                                <div class="position-item">Technical Staff</div>
                                <div class="position-item">Telephone Operators</div>
                                <div class="position-item">Electricians</div>
                                <div class="position-item">Drivers & Tradesmen</div>
                            </div>
                        </div>
                    </div>

                    <!-- Group 7: Unskilled -->
                    <div class="group-card">
                        <div class="group-header">
                            <div class="group-badge">7</div>
                            <h3 class="group-title">Unskilled Staff</h3>
                        </div>
                        <div class="group-content">
                            <div class="position-grid">
                                <div class="position-item">Head Mali</div>
                                <div class="position-item">Mali / Helpers</div>
                                <div class="position-item">Waiters</div>
                                <div class="position-item">Naib Qasids</div>
                                <div class="position-item">Guards</div>
                                <div class="position-item">Sweepers</div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Important Note -->
                <div class="important-note">
                    <h5><i class="fas fa-exclamation-circle"></i> Important Note on Designations and Salary</h5>
                    <p>The designation assigned from time to time is intended to describe the nature of responsibility attached to the job in a general manner. The University, however, may assign a designation not stated in the group of the employee's scale if such designation is considered more appropriate. However, the salary of an employee is dependent only upon the group and scale and not necessarily on the designation assigned to him.</p>
                </div>

                <!-- HR Contact -->
                <div class="hr-contact">
                    <h4>Human Resources Department</h4>
                    <p>For more detailed information about employment classifications, job descriptions, or career opportunities at HITEC University, please contact the Human Resources Department:</p>
                    <div class="contact-details">
                        <div class="contact-item">
                            <i class="fas fa-envelope"></i>
                            <span>hr@hitecuni.edu.pk</span>
                        </div>
                        <div class="contact-item">
                            <i class="fas fa-phone-alt"></i>
                            <span>051-9047851-60 (Ext. 123)</span>
                        </div>
                        <div class="contact-item">
                            <i class="fas fa-map-marker-alt"></i>
                            <span>HR Department, Admin Block, HITEC University</span>
                        </div>
                        <div class="contact-item">
                            <i class="fas fa-clock"></i>
                            <span>Monday to Friday (8:30 AM - 4:30 PM)</span>
                        </div>
                    </div>
                </div>

            </div>
        </section>
        <!-- employment section end -->
    </main>
    <!-- main area end  -->
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Force hide preloader
            setTimeout(function () {
                $('#preloader').fadeOut('slow', function () {
                    $(this).remove();
                });
            }, 500);

            // Smooth scroll animations
            $('.group-card').each(function(i) {
                $(this).delay(100 * i).fadeIn(500);
            });
        });
    </script>
}