@model HitecCM.Models.tblHrDiscipline
@{
    ViewBag.Title = string.IsNullOrWhiteSpace(Model?.Title) ? "Conduct and Discipline" : Model.Title;

    // SEO Meta Tags
    ViewBag.MetaDescription = "Comprehensive conduct and discipline policies at HITEC University including rules, working environment, breach of conduct, inquiry procedures, penalties, and appeals.";
    ViewBag.MetaKeywords = "HITEC University, conduct, discipline, workplace rules, dress code, breach of conduct, inquiry procedure, penalties, appeals, employee conduct";
}

@section Styles {
    <link rel="stylesheet" href="@Url.Content("~/Content/css/hr.css")" />
}

@section Meta {
    <meta name="description" content="@ViewBag.MetaDescription" />
    <meta name="keywords" content="@ViewBag.MetaKeywords" />
    <meta property="og:title" content="@ViewBag.Title - HITEC University" />
    <meta property="og:description" content="@ViewBag.MetaDescription" />
    <meta property="og:type" content="website" />
}

<div class="body_wrap">
    <!-- main area start  -->
    <main>
        <!-- breadcrumb start -->
        <section class="breadcrumb bg_img ul_li" data-background="/Content/img/bg/about_bg.jpg">
            <div class="container">
                <div class="breadcrumb__content text-center">
                    <h1 class="breadcrumb__title mt-25">@ViewBag.Title</h1>
                    <p class="breadcrumb__desc mb-50">Human Resources Department</p>
                </div>
            </div>
        </section>
        <!-- breadcrumb end -->

        <!-- conduct section start -->
        <section class="conduct-section">
            @if (!string.IsNullOrWhiteSpace(Model?.PageData))
            {
                @Html.Raw(Model.PageData)
            }
        </section>
        <!-- conduct section end -->
    </main>
    <!-- main area end  -->
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Force hide preloader
            setTimeout(function () {
                $('#preloader').fadeOut('slow', function () {
                    $(this).remove();
                });
            }, 500);

            // Smooth animations for any conduct cards present in dynamic content
            $('.conduct-card').each(function(i) {
                $(this).delay(100 * i).fadeIn(500);
            });

            $('.inquiry-step').each(function(i) {
                $(this).delay(100 * i).fadeIn(500);
            });
        });
    </script>
}