@model HitecCM.Models.tblHrESTR
@{
    ViewBag.Title = string.IsNullOrWhiteSpace(Model?.Title) ? "Eligibility, Recruitment/Selection, Termination, Resignation" : Model.Title;

    // SEO Meta Tags
    ViewBag.MetaDescription = "Comprehensive guide to eligibility criteria, recruitment processes, selection procedures, termination policies, and resignation procedures at HITEC University.";
    ViewBag.MetaKeywords = "HITEC University, recruitment, selection, eligibility, termination, resignation, hiring process, HR policies, employment procedures, selection board";
}

@section Styles {
    <link rel="stylesheet" href="@Url.Content("~/Content/css/hr.css")" />
}

@section Meta {
    <meta name="description" content="@ViewBag.MetaDescription" />
    <meta name="keywords" content="@ViewBag.MetaKeywords" />
    <meta property="og:title" content="@ViewBag.Title - HITEC University" />
    <meta property="og:description" content="@ViewBag.MetaDescription" />
    <meta property="og:type" content="website" />
}

<div class="body_wrap">
    <!-- main area start  -->
    <main>
        <!-- breadcrumb start -->
        <section class="breadcrumb bg_img ul_li" style="padding: 0; min-height: 0;" data-background="/Content/img/bg/about_bg.jpg">
            <div class="container">
                <div class="breadcrumb__content text-center">
                    <h1 class="breadcrumb__title mt-25">@ViewBag.Title</h1>
                    <p class="breadcrumb__desc mb-50">Human Resources Department</p>
                </div>
            </div>
        </section>
        <!-- breadcrumb end -->
        <!-- employment section start -->

        <section class="employment-section">
            <!-- Hero Header -->

            @if (!string.IsNullOrWhiteSpace(Model?.PageData))
            {
                <!-- Dynamic content from database (styled and animated like other cards) -->
                @Html.Raw(Model.PageData)
            }
        </section>
        <!-- employment section end -->
    </main>
    <!-- main area end  -->
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Force hide preloader
            setTimeout(function () {
                $('#preloader').fadeOut('slow', function () {
                    $(this).remove();
                });
            }, 500);

            // Smooth animations
            $('.eligibility-card').each(function (i) {
                $(this).delay(50 * i).fadeIn(400);
            });

            $('.timeline-item').each(function (i) {
                $(this).delay(100 * i).fadeIn(500);
            });
        });
    </script>
}