@model Website.Models.tblQACSAR
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<section class="about pt-40 pb-120 qac-page">
    <div class="container">
        <div class="row mt-none-30">
            <div class="col-xl-3 col-lg-5 mt-30">
                @Html.Partial("_Sidebar")
            </div>
            <div class="col-xl-8 col-lg-7 mt-30">
                <div class="xb-about__content">
                    <div class="section-title mb-20">
                        <h2 class="title">@Model.PageTitle</h2>
                    </div>
                    <div class="content">
                        @Html.Raw(Model.PageText)
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>