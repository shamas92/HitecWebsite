@model Website.Models.tblQACSAR
@using System

@functions {
    private string RemoveSelfClosingTag(string input, string tag)
    {
        if (string.IsNullOrEmpty(input)) return string.Empty;
        var search = "<" + tag;
        int idx =0;
        while ((idx = input.IndexOf(search, idx, StringComparison.OrdinalIgnoreCase)) >=0)
        {
            int end = input.IndexOf(">", idx, StringComparison.OrdinalIgnoreCase);
            if (end <0) break;
            input = input.Remove(idx, end - idx +1);
        }
        return input;
    }

    private string RemoveBlockTag(string input, string tag)
    {
        if (string.IsNullOrEmpty(input)) return string.Empty;
        string open = "<" + tag;
        string close = "</" + tag + ">";
        int start =0;
        while ((start = input.IndexOf(open, start, StringComparison.OrdinalIgnoreCase)) >=0)
        {
            int end = input.IndexOf(close, start, StringComparison.OrdinalIgnoreCase);
            if (end <0)
            {
                int gt = input.IndexOf(">", start, StringComparison.OrdinalIgnoreCase);
                if (gt <0) break;
                input = input.Remove(start, gt - start +1);
                continue;
            }
            input = input.Remove(start, (end - start) + close.Length);
        }
        return input;
    }

    private string RemoveOpenCloseTagOnly(string input, string tag)
    {
        if (string.IsNullOrEmpty(input)) return string.Empty;
        // remove open
        int idx =0;
        string open = "<" + tag;
        while ((idx = input.IndexOf(open, idx, StringComparison.OrdinalIgnoreCase)) >=0)
        {
            int gt = input.IndexOf(">", idx, StringComparison.OrdinalIgnoreCase);
            if (gt <0) break;
            input = input.Remove(idx, gt - idx +1);
        }
        // remove close
        idx =0;
        string close = "</" + tag + ">";
        while ((idx = input.IndexOf(close, idx, StringComparison.OrdinalIgnoreCase)) >=0)
        {
            input = input.Remove(idx, close.Length);
        }
        return input;
    }
}

@{
    Layout = "~/Views/Shared/_Layout.cshtml";

    // Sanitize incoming HTML to avoid external CSS/JS that can override site header
    var raw = Model != null ? (Model.PageText ?? string.Empty) : string.Empty;
    raw = RemoveSelfClosingTag(raw, "link");
    raw = RemoveBlockTag(raw, "script");
    raw = RemoveOpenCloseTagOnly(raw, "html");
    raw = RemoveOpenCloseTagOnly(raw, "head");
    raw = RemoveOpenCloseTagOnly(raw, "body");
}

<section class="about pt-40 pb-120 qac-page">
    <div class="container">
        <div class="row mt-none-30">
            <div class="col-xl-3 col-lg-5 mt-30">
                @Html.Partial("_Sidebar")
            </div>
            <div class="col-xl-8 col-lg-7 mt-30">
                <div class="xb-about__content">
                    <div class="section-title mb-20">
                        <h2 class="title">@Model.PageTitle</h2>
                    </div>
                    <div class="content">
                        @Html.Raw(raw)
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Styles {
    <style>
        /* Scope accordion styles to this page to avoid affecting global header */
        .qac-page .accordion .accordion-collapse.collapse {
            display: none;
        }

            .qac-page .accordion .accordion-collapse.collapse.show {
                display: block;
            }

        .qac-page .accordion-button::after {
            content: "";
            display: inline-block;
            border-top: 6px solid #002155;
            border-left: 6px solid transparent;
            border-right: 6px solid transparent;
            margin-left: auto;
            transform: rotate(0deg);
            transition: transform 0.3s ease;
        }

        .qac-page .accordion-button:not(.collapsed)::after {
            transform: rotate(180deg);
        }

        /* Simple caret icon */
        .accordion-button::after {
            content: "";
            display: inline-block;
            /* Create a square */
            width: 10px;
            height: 10px;
            /* Apply border to only two sides to create an L shape */
            border-right: 2px solid #002155;
            margin-left: auto;
            /* Rotate it to point down */
            transform: rotate(45deg);
            transition: transform 0.3s ease;
        }

        .accordion-button:not(.collapsed)::after {
            /* Rotate to point up */
            transform: rotate(-135deg);
        }

        /* Smooth height animation */
        .collapse {
            transition: height 0.35s ease;
        }

        .collapsing {
            height: 0;
            overflow: hidden;
            transition: height 0.35s ease;
        }

        .first-item a:hover {
            color: #305fa5;
        }
    </style>
}

@section Scripts {
    <script>
        // Lightweight accordion handler without Bootstrap dependency; scoped to .qac-page
        (function () {
            function getTargetId(btn) {
                return btn.getAttribute('data-bs-target') || btn.getAttribute('data-target');
            }
            document.addEventListener('click', function (e) {
                var btn = e.target.closest('.qac-page .accordion-button');
                if (!btn) return;
                var target = getTargetId(btn);
                if (!target) return;
                var panel = document.querySelector(target);
                if (!panel) return;

                var parentAttr = panel.getAttribute('data-bs-parent') || panel.getAttribute('data-parent');
                if (parentAttr) {
                    var container = document.querySelector(parentAttr);
                    if (container) {
                        container.querySelectorAll('.accordion-collapse.show').forEach(function (p) {
                            if (p !== panel) {
                                p.classList.remove('show');
                                var headerBtn = p.previousElementSibling && p.previousElementSibling.querySelector('.accordion-button');
                                if (headerBtn) headerBtn.classList.add('collapsed');
                            }
                        });
                    }
                }

                var isOpen = panel.classList.contains('show');
                if (isOpen) {
                    panel.classList.remove('show');
                    btn.classList.add('collapsed');
                } else {
                    panel.classList.add('show');
                    btn.classList.remove('collapsed');
                }
            });
        })();
    </script>
}