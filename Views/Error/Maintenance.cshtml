@{
    ViewBag.Title = ViewBag.Title ?? "Maintenance Mode";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="@Url.Content("~/Content/css/error-pages.css")" />
}

<div class="error-container maintenance-container">
    <div class="error-side-content">
        <div class="error-suggestions">
            <h4><i class="fas fa-info-circle"></i> During maintenance:</h4>
            <ul>
                <li><i class="fas fa-database"></i> Updating database systems</li>
                <li><i class="fas fa-shield-alt"></i> Enhancing security features</li>
                <li><i class="fas fa-sync"></i> Try refreshing the page</li>
                <li><i class="fas fa-tachometer-alt"></i> Optimizing performance</li>
                <li><i class="fas fa-bug"></i> Fixing reported issues</li>
            </ul>
        </div>
    </div>

    <div class="error-main-content">

        <div class="error-code">@ViewBag.ErrorCode</div>
        <h1 class="error-title">@ViewBag.ErrorType</h1>
        <h2 class="error-subtitle">We'll be back shortly</h2>
        <div class="error-message">
            <p>@ViewBag.ErrorMessage</p>
            <p>We're making some improvements to serve you better. This maintenance is scheduled and should not take long.</p>
        </div>
        
        <div class="error-actions">
            <a href="javascript:location.reload()" class="btn btn-primary">
                <i class="fas fa-sync"></i> Check Again
            </a>
            <a href="https://www.facebook.com/HitecUniversity" target="_blank" class="btn btn-secondary">
                <i class="fab fa-facebook"></i> Follow Updates
            </a>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Auto-refresh every 5 minutes during maintenance
        setTimeout(function() {
            if (confirm('Maintenance might be complete. Would you like to check?')) {
                location.reload();
            }
        }, 300000); // 5 minutes
        
        // Show countdown timer
        document.addEventListener('DOMContentLoaded', function() {
            let minutes = 30;
            const progressText = document.querySelector('.progress-text');
            const progressBar = document.querySelector('.progress-bar');
            
            const countdown = setInterval(function() {
                minutes--;
                if (minutes > 0) {
                    progressText.textContent = `Estimated completion: ${minutes} minutes`;
                    const progress = Math.max(60 + (30 - minutes) * 1.3, 60);
                    progressBar.style.width = Math.min(progress, 95) + '%';
                } else {
                    progressText.textContent = 'Maintenance should be complete - please refresh';
                    progressBar.style.width = '100%';
                    clearInterval(countdown);
                }
            }, 60000); // Every minute
        });
    </script>
}