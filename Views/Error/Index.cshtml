@{
    ViewBag.Title = ViewBag.Title ?? "Server Error";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="@Url.Content("~/Content/css/error-pages.css")" />
}

<div class="error-container">
    <div class="error-side-content">
        <div class="error-suggestions">
            <h4><i class="fas fa-info-circle"></i> What happened?</h4>
            <ul>
                <li><i class="fas fa-server"></i> A server-side error occurred</li>
                <li><i class="fas fa-bell"></i> Our team has been automatically notified</li>
                <li><i class="fas fa-sync"></i> Try refreshing the page</li>
                <li><i class="fas fa-clock"></i> We're working on a quick fix</li>
                <li><i class="fas fa-shield-alt"></i> Your data and privacy are safe</li>
            </ul>
        </div>
    </div>

    <div class="error-main-content">
        <div class="error-code">@ViewBag.ErrorCode</div>
        <h1 class="error-title">@ViewBag.ErrorType</h1>
        <h2 class="error-subtitle">We're debugging this issue</h2>
        <div class="error-message">
            <p>@ViewBag.ErrorMessage</p>
            <p>Our development team has been automatically notified and is working on a fix. Please try again in a few minutes.</p>
        </div>
        
        <div class="error-actions">
            <a href="@Url.Action("Index", "Home")" class="btn btn-primary">
                <i class="fas fa-home"></i> Return to Homepage
            </a>
            <a href="javascript:location.reload()" class="btn btn-secondary">
                <i class="fas fa-sync"></i> Try Again
            </a>
        </div>
    </div>
</div>